<div class="@CssClass"
     role="switch"
     aria-checked="@Value.ToString().ToLowerInvariant()"
     tabindex="@(Disabled ? "-1" : "0")"
     title="@Title"
     @onclick="ToggleAsync"
     @onkeydown="OnKeyDownAsync"></div>

@code {
    [Parameter] public bool Value { get; set; }

    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    [Parameter] public SwitchSize Size { get; set; } = SwitchSize.Normal;

    [Parameter] public SwitchTone Tone { get; set; } = SwitchTone.Amber;

    [Parameter] public string? Title { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? Class { get; set; }

    private string CssClass
    {
        get
        {
            var parts = new List<string> { "switch" };
            if (Size == SwitchSize.Big)
            {
                parts.Add("big");
            }

            if (Tone == SwitchTone.Red)
            {
                parts.Add("red");
            }

            if (Value)
            {
                parts.Add("on");
            }

            if (Disabled)
            {
                parts.Add("disabled");
            }

            if (!string.IsNullOrWhiteSpace(Class))
            {
                parts.Add(Class);
            }

            return string.Join(" ", parts);
        }
    }

    private async Task ToggleAsync()
    {
        if (Disabled)
        {
            return;
        }

        await ValueChanged.InvokeAsync(!Value);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key is " " or "Enter")
        {
            await ToggleAsync();
        }
    }
}
