@page "/production/news"
@using WhipRadio.Core.Api
@using WhipRadio.Web.Services
@implements IAsyncDisposable
@inject RadioApiClient Api
@inject ProductionLiveClient Live
@inject PlayerState Player

<PageTitle>WhipRadio - News</PageTitle>

<h1 class="stage-title">News</h1>
<div class="stage-sub">top-of-hour packages and editable RSS sources</div>

@if (_news is null)
{
    <div class="panel reveal"><div class="empty-state"><span class="blink">|</span> loading news production...</div></div>
}
else
{
    <div class="panel reveal">
        <div class="panel-label">Package Settings</div>
        <div class="admin-row">
            <div>
                <strong>Top-of-hour news</strong>
                <div class="dim">One rewritten presenter bulletin from configured sources. Weather is appended when enabled.</div>
            </div>
            <UiSwitch Value="@_newsEnabled"
                      ValueChanged="ToggleNewsEnabledAsync"
                      Size="SwitchSize.Big"
                      Title="@(_newsEnabled ? "News enabled" : "News off")" />
        </div>
        <div class="form-grid">
            <div class="field">
                <label>News presenter</label>
                <select @bind="_presenterId">
                    <option value="">Create host on next news</option>
                    @foreach (var host in ActiveHosts)
                    {
                        <option value="@host.Id">@host.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Specialist desk</label>
                <button class="btn specialist-create-btn specialist-create-launch-btn" disabled="@_creatingHost" @onclick="OpenSpecialistHostModal">
                    Create News Host
                </button>
            </div>
            <div class="field">
                <label>Cadence</label>
                <select @bind="_cadence">
                    <option value="30">every 30 minutes</option>
                    <option value="60">hourly</option>
                    <option value="120">every 2 hours</option>
                    <option value="180">every 3 hours</option>
                </select>
            </div>
            <div class="field"><label>Max package length (s)</label><input type="number" min="60" max="1800" @bind="_maxDuration" /></div>
            <div class="field"><label>Fade out before package (s)</label><input type="number" step="0.25" min="0.25" max="10" @bind="_fadeOut" /></div>
            <div class="field"><label>Intro grace (s)</label><input type="number" min="0" max="60" @bind="_introGrace" /></div>
            <div class="field">
                <label>Article extraction</label>
                <UiSwitch Value="@_extractEnabled"
                          ValueChanged="ToggleNewsExtractionAsync"
                          Title="@(_extractEnabled ? "Article extraction enabled" : "Article extraction disabled")" />
            </div>
            <div class="field">
                <label>Category order</label>
                <input @bind="_categoryOrderText" placeholder="general,business,technology,sports,culture,regional" />
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_news.WarningText))
        {
            <div class="production-warning">@_news.WarningText</div>
        }
        <div class="btn-row">
            <button class="btn primary" @onclick="SaveSettingsAsync">Apply</button>
            @if (_settingsSaved)
            {
                <span class="flash">applied</span>
            }
            @if (_error is not null)
            {
                <span class="dim">@_error</span>
            }
        </div>
    </div>

    <div class="panel reveal">
        <div class="news-feed-head">
            <div class="panel-label">Feeds</div>
            <button class="btn small primary" @onclick="OpenAddFeed">+ Add Feed</button>
        </div>
        @if (_news.Feeds.Count == 0)
        {
            <div class="empty-state">no feeds configured</div>
        }
        else
        {
            <table class="console-table news-feeds-table">
                <thead>
                    <tr>
                        <th>Feed</th>
                        <th style="width:50px"></th>
                        <th style="width:72px">Active</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var feed in _news.Feeds)
                    {
                        <tr>
                            <td class="feed-name-cell">
                                <div class="feed-title-line">
                                    <strong class="feed-title">@feed.Label</strong>
                                    <span class="feed-title-separator">&bull;</span>
                                    <span class="dim feed-url-inline" title="@feed.Url">@feed.Url</span>
                                </div>
                                <div class="feed-meta-line">
                                    <span class="tag category-badge @CategoryTagClass(feed.Category)">@CategoryLabel(feed.Category)</span>
                                    <span title="@feed.LastError">last polled <TimeAgo Date="@AsUtc(feed.LastPolledAtUtc)" Placeholder="not yet" /></span>
                                    <span class="feed-title-separator">&bull;</span>
                                    <span>@feed.ItemCount item@(feed.ItemCount == 1 ? "" : "s")</span>
                                </div>
                            </td>
                            <td class="feed-action-cell">
                                <button class="btn small icon-only" title="edit feed" @onclick="() => OpenEditFeed(feed)">
                                    <Icon Name="edit" />
                                </button>
                            </td>
                            <td>
                                <UiSwitch Value="@feed.IsEnabled"
                                          ValueChanged="@(_ => ToggleFeedAsync(feed.Id))"
                                          Title="@(feed.IsEnabled ? "active" : "inactive")" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="panel reveal">
        <div class="news-feed-head">
            <div class="panel-label">Recent Packages</div>
            <button class="btn small" disabled="@_creatingPackage" @onclick="CreateNextPackageAsync">Create Next Package</button>
        </div>
        @if (_news.RecentPackages.Count == 0)
        {
            <div class="empty-state">no packages produced yet</div>
        }
        else
        {
            <table class="console-table">
                <thead>
                    <tr>
                        <th style="width:155px">Target</th>
                        <th style="width:95px">Status</th>
                        <th>Sources</th>
                        <th style="width:110px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var package in _news.RecentPackages)
                    {
                        <tr title="@package.FailureReason">
                            <td>@package.TargetUtc.ToLocalTime().ToString("ddd HH:mm")</td>
                            <td><StatusBadge Text="@package.Status" /></td>
                            <td class="dim">@Short(package.SourceSummary ?? package.FailureReason ?? "", 86)</td>
                            <td class="news-package-actions">
                                @if (package.AnnouncementId is { } announcementId)
                                {
                                    <button class="btn small icon-only"
                                            title="preview package in footer player"
                                            @onclick="() => PlayPackage(package, announcementId)">
                                        <Icon Name="play" />
                                    </button>
                                }
                                @if (CanRecreatePackage(package))
                                {
                                    <button class="btn small icon-only"
                                            disabled="@(_packageActionId == package.Id)"
                                            title="recreate package"
                                            @onclick="() => RecreatePackageAsync(package.Id)">
                                        <Icon Name="refresh" />
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

<Modal Visible="@_feedModalOpen"
       Title="@(_editFeedId is null ? "Add Feed" : "Edit Feed")"
       Class="modal-wide"
       OnClose="CloseFeedModal">
    <ChildContent>
        <div class="form-grid">
            <div class="field"><label>Name</label><input @bind="_feedLabel" placeholder="Source name" /></div>
            <div class="field">
                <label>Category</label>
                <select @bind="_feedCategory">
                    @foreach (var category in CategoryOptions)
                    {
                        <option value="@category">@CategoryLabel(category)</option>
                    }
                </select>
            </div>
            <div class="field feed-url-field"><label>URL</label><input @bind="_feedUrl" placeholder="https://example.com/rss.xml" /></div>
        </div>
        @if (_feedError is not null)
        {
            <div class="dim">@_feedError</div>
        }
    </ChildContent>
    <Footer>
        @if (_editFeedId is not null)
        {
            <button class="btn small danger feed-delete-action" @onclick="AskDeleteCurrentFeed">Delete</button>
        }
        <button class="btn small" @onclick="CloseFeedModal">Cancel</button>
        <button class="btn small primary" @onclick="SaveFeedAsync">@(_editFeedId is null ? "Add Feed" : "Save Feed")</button>
    </Footer>
</Modal>

<SpecialistHostModal Visible="@_specialistModalOpen"
                     Role="News"
                     OnClose="() => _specialistModalOpen = false"
                     HostRequested="CreateNewsHostAsync" />

<ConfirmDialog Visible="@(_deleteTarget is not null)"
               Title="Delete news feed"
               ConfirmText="Delete"
               CancelText="Keep it"
               Danger="true"
               OnConfirm="DeleteFeedConfirmedAsync"
               OnCancel="() => _deleteTarget = null">
    @if (_deleteTarget is { } feed)
    {
        <text>Delete <strong>@feed.Label</strong> and its collected items?</text>
    }
</ConfirmDialog>

@code {
    private NewsProductionDto? _news;
    private List<ModeratorDto> _moderators = [];
    private NewsFeedDto? _deleteTarget;
    private Guid? _editFeedId;
    private string? _error;
    private string? _feedError;
    private bool _settingsSaved;
    private bool _feedModalOpen;
    private bool _specialistModalOpen;
    private bool _creatingHost;
    private bool _creatingPackage;
    private Guid? _packageActionId;

    private bool _newsEnabled = true;
    private bool _extractEnabled = true;
    private int _cadence = 60;
    private int _maxDuration = 300;
    private string _presenterId = "";
    private double _fadeOut = 1.0;
    private int _introGrace = 10;
    private string _categoryOrderText = "general,business,technology,sports,culture,regional";

    private string _feedLabel = "";
    private string _feedUrl = "";
    private string _feedCategory = "technology";
    private bool _editFeedEnabled = true;

    private IEnumerable<ModeratorDto> ActiveHosts
        => _moderators.Where(host => host is { IsActive: true, IsNewsSpecialist: true }).OrderBy(host => host.Name);

    private IReadOnlyList<string> CategoryOptions
        => ParseCategoryOrder(_categoryOrderText).Concat(["general", "business", "technology", "sports", "culture", "regional"])
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        Live.NewsChanged += OnNewsChanged;
        Live.WeatherChanged += OnNewsChanged;
        await Live.EnsureStartedAsync();
        _moderators = await Api.GetModeratorsAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _news = await Api.GetNewsProductionAsync();
        if (_news is null)
        {
            return;
        }

        _newsEnabled = _news.NewsEnabled;
        _extractEnabled = _news.NewsExtractionEnabled;
        _cadence = _news.NewsPackageCadenceMinutes;
        _maxDuration = _news.NewsPackageMaxDurationSeconds;
        _presenterId = _news.NewsPresenterModeratorId?.ToString() ?? "";
        _fadeOut = _news.TopOfHourFadeOutSeconds;
        _introGrace = _news.TopOfHourIntroGraceSeconds;
        _categoryOrderText = string.Join(",", _news.NewsCategoryOrder);
    }

    private async Task SaveSettingsAsync()
    {
        _error = null;
        _error = await Api.SaveNewsProductionSettingsAsync(new SaveNewsProductionSettingsDto(
            _newsEnabled,
            _extractEnabled,
            _cadence,
            _maxDuration,
            int.TryParse(_presenterId, out var presenterId) ? presenterId : null,
            _fadeOut,
            _introGrace,
            ParseCategoryOrder(_categoryOrderText)));
        _settingsSaved = _error is null;
        await LoadAsync();
    }

    private async Task ToggleNewsEnabledAsync(bool enabled)
    {
        _newsEnabled = enabled;
        _error = await SaveProductionSettingsCoreAsync(newsEnabled: enabled);
        _settingsSaved = _error is null;
        await LoadAsync();
    }

    private async Task ToggleNewsExtractionAsync(bool enabled)
    {
        _extractEnabled = enabled;
        _error = await SaveProductionSettingsCoreAsync(newsExtractionEnabled: enabled);
        _settingsSaved = _error is null;
        await LoadAsync();
    }

    private Task<string?> SaveProductionSettingsCoreAsync(
        bool? newsEnabled = null,
        bool? newsExtractionEnabled = null)
    {
        var source = _news;
        return Api.SaveNewsProductionSettingsAsync(new SaveNewsProductionSettingsDto(
            newsEnabled ?? source?.NewsEnabled ?? _newsEnabled,
            newsExtractionEnabled ?? source?.NewsExtractionEnabled ?? _extractEnabled,
            source?.NewsPackageCadenceMinutes ?? _cadence,
            source?.NewsPackageMaxDurationSeconds ?? _maxDuration,
            source?.NewsPresenterModeratorId,
            source?.TopOfHourFadeOutSeconds ?? _fadeOut,
            source?.TopOfHourIntroGraceSeconds ?? _introGrace,
            source?.NewsCategoryOrder ?? ParseCategoryOrder(_categoryOrderText)));
    }

    private async Task SaveFeedAsync()
    {
        var request = new SaveNewsFeedDto(
            _feedLabel,
            _feedUrl,
            Language: "en",
            Region: "global",
            Category: _feedCategory,
            IsEnabled: _editFeedId is null || _editFeedEnabled,
            MaxItemsPerPoll: 20);
        var (feed, error) = _editFeedId is { } id
            ? await Api.UpdateNewsFeedAsync(id, request)
            : await Api.CreateNewsFeedAsync(request);
        _feedError = error;
        if (feed is not null)
        {
            CloseFeedModal();
            await LoadAsync();
        }
    }

    private void OpenAddFeed()
    {
        ClearFeedForm();
        _feedModalOpen = true;
    }

    private void OpenEditFeed(NewsFeedDto feed)
    {
        _editFeedId = feed.Id;
        _feedLabel = feed.Label;
        _feedUrl = feed.Url;
        _feedCategory = feed.Category;
        _editFeedEnabled = feed.IsEnabled;
        _feedError = null;
        _feedModalOpen = true;
    }

    private void CloseFeedModal()
    {
        _feedModalOpen = false;
        ClearFeedForm();
    }

    private void ClearFeedForm()
    {
        _editFeedId = null;
        _feedLabel = "";
        _feedUrl = "";
        _feedCategory = "technology";
        _editFeedEnabled = true;
        _feedError = null;
    }

    private void AskDeleteCurrentFeed()
    {
        if (_editFeedId is { } id)
        {
            _deleteTarget = _news?.Feeds.FirstOrDefault(feed => feed.Id == id);
        }
    }

    private async Task ToggleFeedAsync(Guid id)
    {
        await Api.ToggleNewsFeedAsync(id);
        await LoadAsync();
    }

    private async Task CreateNextPackageAsync()
    {
        if (_creatingPackage)
        {
            return;
        }

        _creatingPackage = true;
        _error = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var (_, error) = await Api.CreateNextNewsPackageAsync();
            _error = error;
            await LoadAsync();
        }
        finally
        {
            _creatingPackage = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RecreatePackageAsync(Guid id)
    {
        if (_packageActionId is not null)
        {
            return;
        }

        _packageActionId = id;
        _error = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var (_, error) = await Api.RecreateNewsPackageAsync(id);
            _error = error;
            await LoadAsync();
        }
        finally
        {
            _packageActionId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void PlayPackage(NewsPackageDto package, Guid announcementId)
    {
        var title = $"News package {package.TargetUtc.ToLocalTime():ddd HH:mm}";
        Player.PlayAnnouncement(
            announcementId,
            title,
            Api.AnnouncementAudioUrl(announcementId),
            package.TargetDurationSeconds);
    }

    private void OpenSpecialistHostModal()
    {
        if (!_creatingHost)
        {
            _specialistModalOpen = true;
        }
    }

    private async Task CreateNewsHostAsync(string? hint)
    {
        if (_creatingHost)
        {
            return;
        }

        _creatingHost = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var (host, error) = await Api.CreateSpecialistHostAsync(new CreateSpecialistHostRequestDto("News", hint));
            if (host is not null)
            {
                _moderators = await Api.GetModeratorsAsync();
                _presenterId = host.Id.ToString();
                await SaveSettingsAsync();
                _specialistModalOpen = false;
            }
            else
            {
                _error = string.IsNullOrWhiteSpace(error) ? "Host creation failed." : error;
                await LoadAsync();
            }
        }
        finally
        {
            _creatingHost = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnNewsChanged()
        => _ = InvokeAsync(async () =>
        {
            _moderators = await Api.GetModeratorsAsync();
            await LoadAsync();
            StateHasChanged();
        });

    private async Task DeleteFeedConfirmedAsync()
    {
        if (_deleteTarget is not { } feed)
        {
            return;
        }

        _feedError = await Api.DeleteNewsFeedAsync(feed.Id);
        _deleteTarget = null;
        if (_feedError is null)
        {
            CloseFeedModal();
        }

        await LoadAsync();
    }

    private static bool CanRecreatePackage(NewsPackageDto package)
        => package.Status is "Pending" or "Ready" or "Failed";

    private static DateTime? AsUtc(DateTime? value)
        => value is null
            ? null
            : value.Value.Kind == DateTimeKind.Unspecified
                ? DateTime.SpecifyKind(value.Value, DateTimeKind.Utc)
                : value;

    private static string CategoryLabel(string category)
        => category switch
        {
            "technology" => "tech",
            "sports" => "sports",
            "regional" => "regional",
            "business" => "business",
            "culture" => "culture",
            _ => "general",
        };

    private static string CategoryTagClass(string category)
        => category switch
        {
            "technology" => "category-tech",
            "sports" => "category-sports",
            "regional" => "category-regional",
            "business" => "category-business",
            "culture" => "category-culture",
            _ => "category-general",
        };

    private static string Short(string value, int max)
        => string.IsNullOrWhiteSpace(value)
            ? "-"
            : value.Length <= max ? value : $"{value[..Math.Max(0, max - 3)]}...";

    private static IReadOnlyList<string> ParseCategoryOrder(string value)
    {
        var parsed = value
            .Split([',', ';', '\n', '\r', '\t'], StringSplitOptions.RemoveEmptyEntries)
            .Select(category => category.Trim().ToLowerInvariant())
            .Where(category => category.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        return parsed.Count == 0 ? ["general", "business", "technology", "sports", "culture", "regional"] : parsed;
    }

    public ValueTask DisposeAsync()
    {
        Live.NewsChanged -= OnNewsChanged;
        Live.WeatherChanged -= OnNewsChanged;
        return ValueTask.CompletedTask;
    }
}
