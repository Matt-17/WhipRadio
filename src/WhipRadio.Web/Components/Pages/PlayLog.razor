@page "/playlog"
@using WhipRadio.Core.Api
@using WhipRadio.Web.Services
@implements IDisposable
@inject RadioApiClient Api
@inject RadioLiveClient Live
@inject PlayerState Player

<PageTitle>WhipRadio — Play Log</PageTitle>

<h1 class="stage-title">Play Log</h1>
<div class="stage-sub">what went out over the air — talks replayable for an hour and beyond</div>

<div class="panel reveal">
    @if (_entries is null)
    {
        <div class="empty-state"><span class="blink">▮</span> rewinding the tape…</div>
    }
    else if (_entries.Count == 0)
    {
        <div class="empty-state"><span class="blink">▮</span> Nothing on the log yet — first transmission pending.</div>
    }
    else
    {
        <div class="console-table-wrap">
        <table class="console-table">
            <thead>
                <tr>
                    <th style="width:150px">Aired</th>
                    <th>Type</th>
                    <th>Title</th>
                    <th class="num">Length</th>
                    <th style="width:1%" aria-label="Actions"></th>
                </tr>
            </thead>
            <tbody>
                @{
                    var nowPlayingEntry = NowPlayingEntry;
                }
                @foreach (var entry in _entries)
                {
                    var isNowPlaying = ReferenceEquals(entry, nowPlayingEntry);
                    <tr @key="EntryKey(entry)" class="@(EntryKey(entry) == _flashKey ? "playlog-new" : null)">
                        <td class="dim" style="white-space:nowrap">
                            @if (isNowPlaying)
                            {
                                <span class="now-on-air" title="currently on air">
                                    <span class="now-on-air-dot" aria-hidden="true"></span>on air
                                </span>
                            }
                            else
                            {
                                <TimeAgo Date="@AsUtc(entry.PlayedAt)" AbsoluteAfter="@OneHour" />
                            }
                        </td>
                        <td>
                            @if (entry.ItemType == "Track")
                            {
                                <span class="tag">track</span>
                            }
                            else if (entry.IsNews)
                            {
                                <span class="tag green">news</span>
                            }
                            else
                            {
                                    <span class="tag amber">talk</span>
                            }
                        </td>
                        <td>
                            @entry.Title
                            @if (entry.ArtistName is { Length: > 0 } artist)
                            {
                                <span class="dim"> by </span>
                                @if (entry.ArtistSlug is { Length: > 0 } slug)
                                {
                                    <a href="@ArtistHref(slug)">@artist</a>
                                }
                                else
                                {
                                    @artist
                                }
                            }
                            @if (entry.Hosts is { Count: > 0 } hosts)
                            {
                                @if (hosts.Count > 1)
                                {
                                    <span class="dim"> with </span>
                                }
                                else
                                {
                                    <span class="dim"> from </span>
                                }
                                @for (var i = 0; i < hosts.Count; i++)
                                {
                                    if (i > 0)
                                    {
                                        <span class="dim">@(i == hosts.Count - 1 ? " & " : ", ")</span>
                                    }
                                    <a href="@HostHref(hosts[i].Slug)">@hosts[i].Name</a>
                                }
                            }
                        </td>
                        <td class="num dim">@FormatClock(TimeSpan.FromSeconds(entry.DurationSeconds))</td>
                        <td style="white-space:nowrap">
                            <button class="btn small icon-btn" title="play in player"
                                        aria-label="@(entry.ItemType == "Track" ? "play song" : entry.IsNews ? "play news" : "play talk")"
                                    @onclick="() => PlayAsync(entry)">
                                <Icon Name="play" Size="16" />
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@code {
    private List<PlayLogEntryDto>? _entries;

    // Identity of the on-air item we last logged, so an incoming SignalR push
    // (which also fires for votes/status) only re-pulls the log on a real flip.
    private string? _lastNowPlayingKey;
    // The freshly-aired row to flash, cleared once the arrival animation ends.
    private string? _flashKey;
    private CancellationTokenSource? _flashCts;
    private static readonly TimeSpan OneHour = TimeSpan.FromHours(1);

    protected override async Task OnInitializedAsync()
    {
        // Snapshot before subscribing so the item already on air doesn't flash
        // as if it just arrived on first paint.
        await Live.EnsureStartedAsync();
        _entries = await Api.GetPlayLogAsync();
        _lastNowPlayingKey = NowPlayingKey(Live.NowPlaying);
        Live.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(HandleChangedAsync);

    private async Task HandleChangedAsync()
    {
        var key = NowPlayingKey(Live.NowPlaying);
        if (key is not null && key != _lastNowPlayingKey)
        {
            _lastNowPlayingKey = key;
            _entries = await Api.GetPlayLogAsync();
            if (_entries.Count > 0)
            {
                FlashNewest(EntryKey(_entries[0]));
            }
        }

        StateHasChanged();
    }

    private void FlashNewest(string entryKey)
    {
        _flashCts?.Cancel();
        _flashCts = new CancellationTokenSource();
        var token = _flashCts.Token;
        _flashKey = entryKey;

        // Drop the marker once the CSS arrival flash has played out, so the row
        // returns to normal hover behaviour.
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(TimeSpan.FromMilliseconds(2000), token);
                _flashKey = null;
                await InvokeAsync(StateHasChanged);
            }
            catch (TaskCanceledException)
            {
                // Superseded by a newer arrival — that one owns the flash now.
            }
        });
    }

    // The newest logged entry, but only while it is still the item on air — so
    // the top row shows a live "on air" marker instead of a "time ago" stamp.
    private PlayLogEntryDto? NowPlayingEntry
        => _entries is { Count: > 0 } && Live.NowPlaying is { } np && _entries[0].ItemId == np.ItemId
            ? _entries[0]
            : null;

    private static string? NowPlayingKey(NowPlayingDto? np)
        => np is null ? null : $"{np.ItemId:N}-{np.StartedAtUtc.Ticks}";

    private static string EntryKey(PlayLogEntryDto entry)
        => $"{entry.ItemId:N}-{entry.PlayedAt.Ticks}";

    // PlayedAt is UTC at the source; guard the Kind in case JSON round-tripping
    // dropped it to Unspecified, so TimeAgo localises correctly.
    private static DateTime AsUtc(DateTime value)
        => value.Kind == DateTimeKind.Unspecified
            ? DateTime.SpecifyKind(value, DateTimeKind.Utc)
            : value;

    private static string ArtistHref(string slug)
        => $"/library/artists/{Uri.EscapeDataString(slug)}";

    private static string HostHref(string slug)
        => $"/moderators/{Uri.EscapeDataString(slug)}";

    // Route the logged item into the footer player (a seekable preview) rather
    // than a one-shot clip, so transport controls and volume apply. Tracks need
    // the full DTO (votes, lyrics), so they are pulled fresh from the library.
    private async Task PlayAsync(PlayLogEntryDto entry)
    {
        if (entry.ItemType == "Track")
        {
            if (await Api.GetTrackAsync(entry.ItemId) is { } track)
            {
                Player.PlayTrack(track);
            }
        }
        else
        {
            Player.PlayAnnouncement(entry.ItemId, entry.Title, Api.AnnouncementAudioUrl(entry.ItemId), entry.DurationSeconds, entry.Transcript);
        }
    }

    public void Dispose()
    {
        Live.Changed -= OnChanged;
        _flashCts?.Cancel();
        _flashCts?.Dispose();
    }
}
