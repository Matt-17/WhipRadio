@page "/"
@using WhipRadio.Core.Api
@using WhipRadio.Web.Services
@implements IDisposable
@inject RadioLiveClient Live
@inject RadioApiClient Api
@inject IConfiguration Configuration
@inject IJSRuntime Js

<PageTitle>WhipRadio — Live</PageTitle>

<h1 class="stage-title">Live Broadcast</h1>
<div class="stage-sub">
    studio 1 • fully local • ai operated
</div>

<div class="panel reveal">
    <div class="panel-label">Now Playing</div>

    <div class="vfd">
        @if (Live.NowPlaying is null)
        {
            <div class="vfd-kind">Signal</div>
            <div class="vfd-title">— Tuning —</div>
            <div class="vfd-meta">The studio is warming up. The llamas are whipping the first mix.</div>
        }
        else
        {
            <div class="vfd-kind">@FormatClock(Elapsed) / @FormatClock(TimeSpan.FromSeconds(Live.NowPlaying.DurationSeconds))</div>
            <div class="vfd-title">
                @if (Live.NowPlaying.ItemType == "Track")
                {
                    @Live.NowPlaying.Title
                }
                else
                {
                    @(Live.NowPlaying.ModeratorName ?? "Studio Talk")
                }
            </div>
            <div class="vfd-meta">
                @if (Live.NowPlaying.ArtistName is not null)
                {
                    <span class="vfd-meta-item">by <strong>@Live.NowPlaying.ArtistName</strong></span>
                }
                @if (Live.NowPlaying.FormatName is not null)
                {
                    <span class="vfd-meta-item">now <strong>@Live.NowPlaying.FormatName</strong></span>
                }
                @if (Live.NowPlaying.ModeratorName is not null && Live.NowPlaying.ItemType == "Track")
                {
                    <span class="vfd-meta-item">host <strong>@Live.NowPlaying.ModeratorName</strong></span>
                }
                @if (Live.NowPlaying.ItemType != "Track")
                {
                    <span class="vfd-meta-item">@Live.NowPlaying.Title</span>
                }
            </div>
        }
        <AudioSpectrum />
        <div class="tuner" title="elapsed position" role="progressbar"
             aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ProgressValue">
            <div class="tuner-fill" style="width: @ProgressPercent"></div>
            <div class="needle" style="left: @ProgressPercent"></div>
        </div>
    </div>
</div>

@if (Live.Queue.Count > 0)
{
    <div class="panel reveal">
        <div class="panel-label">Up Next</div>
        <table class="console-table">
            <tbody>
                @foreach (var item in Live.Queue)
                {
                    <tr>
                        <td style="width:90px">
                            <span class="tag @(item.ItemType == "Track" ? "amber" : "")">@(item.ItemType == "Track" ? "track" : "talk")</span>
                        </td>
                        <td>@item.Title</td>
                        <td class="num dim" style="width:80px">@FormatClock(TimeSpan.FromSeconds(item.DurationSeconds))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="panel reveal">
        <div class="panel-label">Up Next</div>
        <div class="empty-state">queue is empty — the studio is between tracks</div>
    </div>
}

@if (_greetingsEnabled)
{
<div class="panel reveal">
    <div class="panel-label">Send a Greeting</div>
    <div class="field" style="margin-bottom:14px">
        <label>Kind</label>
        <div class="seg" role="radiogroup" aria-label="Message kind">
            <button type="button" class="seg-btn @(_greetKind == "Greeting" ? "active" : null)"
                    @onclick="@(() => _greetKind = "Greeting")">
                <Icon Name="heart" /> Greeting
            </button>
            <button type="button" class="seg-btn @(_greetKind == "Request" ? "active" : null)"
                    @onclick="@(() => _greetKind = "Request")">
                <Icon Name="note" /> Music request
            </button>
        </div>
    </div>
    <div class="form-grid">
        <div class="field"><label>Your name</label><input maxlength="30" @bind="_greetName" /></div>
        @if (_greetKind == "Request")
        {
            <div class="field"><label>Genre wish (optional)</label><input @bind="_greetGenre" placeholder="techno, lofi, ..." /></div>
        }
    </div>
    <div class="field" style="margin-bottom:14px">
        <label>Message</label>
        <input maxlength="200" @bind="_greetText" @bind:event="oninput" @onkeydown="OnMessageKeyDownAsync"
               placeholder="Hello to the night shift!" />
    </div>
    <div class="btn-row">
        <button class="btn primary" @onclick="SendGreetingAsync">Send to the Studio</button>
        @if (_greetFeedback is not null)
        {
            <span class="@(_greetOk ? "flash" : "text-danger")">@_greetFeedback</span>
        }
    </div>
</div>
}

<div class="panel reveal">
    <div class="panel-label">Direct Stream</div>
    <div class="btn-row">
        <code class="stream-url">@_streamUrl</code>
        <button class="btn" @onclick="CopyStreamUrlAsync">@(_copied ? "✓ copied" : "copy link")</button>
    </div>
</div>

@code {
    private string _streamUrl = "";
    private bool _copied;
    private Timer? _ticker;
    private string _greetName = "";
    private string _greetText = "";
    private string _greetKind = "Greeting";
    private string _greetGenre = "";
    private string? _greetFeedback;
    private bool _greetOk;
    private bool _greetingsEnabled;

    private TimeSpan Elapsed => Live.NowPlaying is { } np ? DateTime.UtcNow - np.StartedAtUtc : TimeSpan.Zero;

    private double Progress => Live.NowPlaying is { } np && np.DurationSeconds > 0
        ? Math.Clamp(Elapsed.TotalSeconds / np.DurationSeconds * 100, 0, 100)
        : 0;

    private string ProgressValue => Math.Round(Progress).ToString(System.Globalization.CultureInfo.InvariantCulture);

    private string ProgressPercent => $"{Progress.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}%";

    protected override void OnInitialized()
    {
        _streamUrl = Configuration["Stream:PublicUrl"] ?? WhipRadio.Core.Configuration.ServiceEndpointDefaults.PublicStream;
        Live.Changed += OnChanged;
    }

    protected override async Task OnInitializedAsync()
        => _greetingsEnabled = (await Api.GetSettingsAsync())?.GreetingsEnabled ?? false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Live.EnsureStartedAsync();
            _ticker = new Timer(_ => _ = InvokeAsync(StateHasChanged), null,
                TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));

            var savedName = await Js.InvokeAsync<string?>("localStorage.getItem", "whipradio.senderName");
            if (!string.IsNullOrWhiteSpace(savedName))
            {
                _greetName = savedName;
                StateHasChanged();
            }
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OnMessageKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendGreetingAsync();
        }
    }

    private async Task SendGreetingAsync()
    {
        if (string.IsNullOrWhiteSpace(_greetName) || string.IsNullOrWhiteSpace(_greetText))
        {
            _greetOk = false;
            _greetFeedback = "Name and message, please!";
            return;
        }

        var (ok, message) = await Api.SubmitGreetingAsync(new SubmitGreetingDto(
            _greetName, _greetText, _greetKind, _greetKind == "Request" ? _greetGenre : null));
        _greetOk = ok;
        _greetFeedback = ok ? $"Thanks {_greetName}! {message}" : message;
        if (ok)
        {
            _greetText = "";
            await Js.InvokeVoidAsync("localStorage.setItem", "whipradio.senderName", _greetName.Trim());
        }
    }

    private async Task CopyStreamUrlAsync()
    {
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", _streamUrl);
        _copied = true;
    }

    public void Dispose()
    {
        Live.Changed -= OnChanged;
        _ticker?.Dispose();
    }
}
