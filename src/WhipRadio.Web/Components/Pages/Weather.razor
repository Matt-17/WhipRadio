@page "/production/weather"
@using WhipRadio.Core.Api
@using WhipRadio.Web.Services
@implements IAsyncDisposable
@inject RadioApiClient Api
@inject ProductionLiveClient Live

<PageTitle>WhipRadio - Weather</PageTitle>

<h1 class="stage-title">Weather</h1>
<div class="stage-sub">forecast host assignment and location</div>

@if (_weather is null)
{
    <div class="panel reveal"><div class="empty-state"><span class="blink">|</span> loading weather production...</div></div>
}
else
{
    <div class="panel reveal">
        <div class="panel-label">Weather Settings</div>
        <div class="admin-row">
            <div>
                <strong>Weather reports</strong>
                <div class="dim">When news is enabled, weather is appended to the top-of-hour package.</div>
            </div>
            <UiSwitch Value="@_enabled"
                      ValueChanged="ToggleWeatherEnabledAsync"
                      Size="SwitchSize.Big"
                      Title="@(_enabled ? "Weather enabled" : "Weather off")" />
        </div>
        <div class="form-grid">
            <div class="field">
                <label>Weather host</label>
                <select @bind="_hostId">
                    <option value="">Create host on next weather</option>
                    @foreach (var host in WeatherHosts)
                    {
                        <option value="@host.Id">@host.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Specialist desk</label>
                <button class="btn specialist-create-btn specialist-create-launch-btn" disabled="@_creatingHost" @onclick="OpenSpecialistHostModal">
                    Create Weather Host
                </button>
            </div>
            <div class="field">
                <label>Full handover</label>
                <UiSwitch Value="@_fullHandoverEnabled"
                          ValueChanged="ToggleFullHandoverAsync"
                          Title="@(_fullHandoverEnabled ? "Full handover on" : "Full handover off")" />
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_weather.WarningText))
        {
            <div class="production-warning">@_weather.WarningText</div>
        }
    </div>

    <div class="panel reveal">
        <div class="panel-label">Forecast Location</div>
        <div class="form-grid">
            <div class="field"><label>Location label</label><input @bind="_locationName" /></div>
            <div class="field"><label>Latitude</label><input type="number" step="0.0001" min="-90" max="90" @bind="_latitude" /></div>
            <div class="field"><label>Longitude</label><input type="number" step="0.0001" min="-180" max="180" @bind="_longitude" /></div>
        </div>
        <div class="btn-row">
            <button class="btn primary" @onclick="SaveAsync">Apply</button>
            @if (_saved)
            {
                <span class="flash">applied</span>
            }
            @if (_error is not null)
            {
                <span class="dim">@_error</span>
            }
        </div>
    </div>
}

<SpecialistHostModal Visible="@_specialistModalOpen"
                     Role="Weather"
                     OnClose="() => _specialistModalOpen = false"
                     HostRequested="CreateWeatherHostAsync" />

@code {
    private WeatherProductionDto? _weather;
    private List<ModeratorDto> _moderators = [];
    private bool _enabled = true;
    private string _hostId = "";
    private bool _fullHandoverEnabled;
    private string _locationName = "New York, US";
    private double _latitude = 40.7128;
    private double _longitude = -74.0060;
    private bool _saved;
    private string? _error;
    private bool _specialistModalOpen;
    private bool _creatingHost;

    private IEnumerable<ModeratorDto> WeatherHosts
        => _moderators.Where(host => host is { IsActive: true, IsWeatherSpecialist: true }).OrderBy(host => host.Name);

    protected override async Task OnInitializedAsync()
    {
        Live.NewsChanged += OnWeatherChanged;
        Live.WeatherChanged += OnWeatherChanged;
        await Live.EnsureStartedAsync();
        _moderators = await Api.GetModeratorsAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _weather = await Api.GetWeatherProductionAsync();
        if (_weather is null)
        {
            return;
        }

        _enabled = _weather.WeatherEnabled;
        _hostId = _weather.WeatherSpecialistModeratorId?.ToString() ?? "";
        _fullHandoverEnabled = _weather.WeatherFullHandoverEnabled;
        _locationName = _weather.WeatherLocationName;
        _latitude = _weather.WeatherLatitude;
        _longitude = _weather.WeatherLongitude;
    }

    private async Task SaveAsync()
    {
        var (weather, error) = await Api.SaveWeatherProductionAsync(new SaveWeatherProductionSettingsDto(
            _enabled,
            _weather?.WeatherCadenceMinutes ?? 60,
            int.TryParse(_hostId, out var hostId) ? hostId : null,
            _fullHandoverEnabled,
            _locationName,
            _latitude,
            _longitude));
        _weather = weather ?? _weather;
        _error = error;
        _saved = error is null;
        await LoadAsync();
    }

    private async Task ToggleWeatherEnabledAsync(bool enabled)
    {
        _enabled = enabled;
        await SaveSwitchAsync(weatherEnabled: enabled);
    }

    private async Task ToggleFullHandoverAsync(bool enabled)
    {
        _fullHandoverEnabled = enabled;
        await SaveSwitchAsync(fullHandoverEnabled: enabled);
    }

    private async Task SaveSwitchAsync(bool? weatherEnabled = null, bool? fullHandoverEnabled = null)
    {
        var source = _weather;
        var (weather, error) = await Api.SaveWeatherProductionAsync(new SaveWeatherProductionSettingsDto(
            weatherEnabled ?? source?.WeatherEnabled ?? _enabled,
            source?.WeatherCadenceMinutes ?? 60,
            source?.WeatherSpecialistModeratorId,
            fullHandoverEnabled ?? source?.WeatherFullHandoverEnabled ?? _fullHandoverEnabled,
            source?.WeatherLocationName ?? _locationName,
            source?.WeatherLatitude ?? _latitude,
            source?.WeatherLongitude ?? _longitude));
        _weather = weather ?? _weather;
        _error = error;
        _saved = error is null;
        if (weather is not null)
        {
            await LoadAsync();
        }
    }

    private async Task CreateWeatherHostAsync(string? hint)
    {
        if (_creatingHost)
        {
            return;
        }

        _creatingHost = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var (host, error) = await Api.CreateSpecialistHostAsync(
                new CreateSpecialistHostRequestDto("Weather", hint));

            if (host is null)
            {
                _error = string.IsNullOrWhiteSpace(error) ? "Host creation failed." : error;
                await LoadAsync();
                return;
            }

            _moderators = await Api.GetModeratorsAsync();
            _hostId = host.Id.ToString();
            await SaveAsync();
            _specialistModalOpen = false;
        }
        finally
        {
            _creatingHost = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OpenSpecialistHostModal()
    {
        if (!_creatingHost)
        {
            _specialistModalOpen = true;
        }
    }

    private void OnWeatherChanged()
        => _ = InvokeAsync(async () =>
        {
            _moderators = await Api.GetModeratorsAsync();
            await LoadAsync();
            StateHasChanged();
        });

    public ValueTask DisposeAsync()
    {
        Live.NewsChanged -= OnWeatherChanged;
        Live.WeatherChanged -= OnWeatherChanged;
        return ValueTask.CompletedTask;
    }
}
