@page "/admin"
@using WhipRadio.Core.Api
@using WhipRadio.Web.Services
@inject RadioApiClient Api

<PageTitle>WhipRadio — Admin</PageTitle>

<h1 class="stage-title">Master Control</h1>
<div class="stage-sub">the big red buttons · use responsibly</div>

@if (_settings is null)
{
    <div class="panel reveal"><div class="empty-state"><span class="blink">▮</span> unlocking the control room…</div></div>
}
else
{
    <div class="panel reveal">
        <div class="panel-label">Broadcast</div>
        <div class="admin-row">
            <div>
                <strong>On Air</strong>
                <div class="dim">Stops/starts the playout engine. Off air = the Icecast mount goes quiet.</div>
            </div>
            <div class="switch big @(_settings.PlayoutEnabled ? "on" : null)" @onclick="TogglePlayoutAsync"></div>
        </div>
        <div class="admin-row">
            <div>
                <strong>Music Production</strong>
                <div class="dim">Stops/starts generating new tracks. Production also pauses automatically at @_settings.MaxLibrarySize tracks.</div>
            </div>
            <div class="switch big @(_settings.MusicProductionEnabled ? "on" : null)" @onclick="ToggleMusicAsync"></div>
        </div>
        <div class="admin-row">
            <div>
                <strong>Program Director</strong>
                <div class="dim">Plans the weekly schedule in the background — or kick it manually.</div>
            </div>
            <button class="btn" @onclick="RunDirectorAsync">@(_directorKicked ? "✓ running…" : "Run now")</button>
        </div>
        <div class="dim" style="margin-top:10px; font-size:12.5px">
            Real-time transitions, crossfades and talk-overs are managed on the <a href="/mixer">Mixer page</a>.
        </div>
    </div>

    <div class="panel reveal">
        <div class="panel-label">Listener Messages</div>
        <div class="admin-row">
            <div>
                <strong>Greetings &amp; Requests</strong>
                <div class="dim">
                    Listeners can send messages from the live page; queued ones are read on air.
                    History and overrides live on the <a href="/messages">Messages page</a>.
                </div>
            </div>
            <div class="switch big @(_settings.GreetingsEnabled ? "on" : null)" @onclick="ToggleGreetingsAsync"></div>
        </div>
    </div>

    <div class="panel reveal">
        <div class="panel-label">Production Pacing</div>
        <div class="form-grid">
            <div class="field"><label>Target unplayed tracks</label><input type="number" min="1" max="20" @bind="_settings_TargetQueueLength" /></div>
            <div class="field"><label>Max library size</label><input type="number" min="5" max="5000" @bind="_settings_MaxLibrarySize" /></div>
            <div class="field"><label>Min track length (s)</label><input type="number" min="30" max="600" @bind="_settings_MinDuration" /></div>
            <div class="field"><label>Max track length (s)</label><input type="number" min="30" max="600" @bind="_settings_MaxDuration" /></div>
        </div>
        <div class="dim" style="margin-bottom:12px; font-size:12.5px">
            Music AIs and voice booths are managed on the <a href="/studios">Studios page</a>.
        </div>
        <div class="btn-row">
            <button class="btn primary" @onclick="SavePacingAsync">Apply</button>
            @if (_saved)
            {
                <span class="flash">✓ applied</span>
            }
        </div>
    </div>
}

@code {
    private StationSettingsDto? _settings;
    private bool _saved;
    private int _settings_TargetQueueLength;
    private int _settings_MaxLibrarySize;
    private int _settings_MinDuration;
    private int _settings_MaxDuration;

    protected override async Task OnInitializedAsync()
    {
        _settings = await Api.GetSettingsAsync();
        if (_settings is not null)
        {
            _settings_TargetQueueLength = _settings.TargetQueueLength;
            _settings_MaxLibrarySize = _settings.MaxLibrarySize;
            _settings_MinDuration = _settings.MinTrackDurationSeconds;
            _settings_MaxDuration = _settings.MaxTrackDurationSeconds;
        }
    }

    private async Task TogglePlayoutAsync()
    {
        // Re-fetch first: a stale page snapshot must never overwrite other settings.
        var fresh = await Api.GetSettingsAsync();
        if (fresh is null)
        {
            return;
        }

        _settings = await Api.SaveSettingsAsync(fresh with { PlayoutEnabled = !fresh.PlayoutEnabled });
    }

    private async Task ToggleMusicAsync()
    {
        var fresh = await Api.GetSettingsAsync();
        if (fresh is null)
        {
            return;
        }

        _settings = await Api.SaveSettingsAsync(fresh with { MusicProductionEnabled = !fresh.MusicProductionEnabled });
    }

    private bool _directorKicked;

    private async Task RunDirectorAsync()
    {
        await Api.RunDirectorAsync();
        _directorKicked = true;
    }

    private async Task ToggleGreetingsAsync()
    {
        var fresh = await Api.GetSettingsAsync();
        if (fresh is null)
        {
            return;
        }

        _settings = await Api.SaveSettingsAsync(fresh with { GreetingsEnabled = !fresh.GreetingsEnabled });
    }

    private async Task SavePacingAsync()
    {
        var fresh = await Api.GetSettingsAsync();
        if (fresh is null)
        {
            return;
        }

        _settings = await Api.SaveSettingsAsync(fresh with
        {
            TargetQueueLength = _settings_TargetQueueLength,
            MaxLibrarySize = _settings_MaxLibrarySize,
            MinTrackDurationSeconds = _settings_MinDuration,
            MaxTrackDurationSeconds = _settings_MaxDuration,
        });
        _saved = true;
    }
}
