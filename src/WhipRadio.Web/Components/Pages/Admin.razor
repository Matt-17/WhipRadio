@page "/admin"
@using WhipRadio.Core.Api
@using WhipRadio.Web.Services
@implements IDisposable
@inject RadioApiClient Api

<PageTitle>WhipRadio — Admin</PageTitle>

<h1 class="stage-title">Master Control</h1>
<div class="stage-sub">the big red buttons · use responsibly</div>

@if (_settings is null)
{
    <div class="panel reveal"><div class="empty-state"><span class="blink">▮</span> unlocking the control room…</div></div>
}
else
{
    <div class="panel reveal">
        <div class="panel-label">Broadcast</div>
        <div class="admin-row">
            <div>
                <strong>On Air</strong>
                <div class="dim">Stops/starts the playout engine. Off air = the Icecast mount goes quiet.</div>
            </div>
            <div class="switch big @(_settings.PlayoutEnabled ? "on" : null)" @onclick="TogglePlayoutAsync"></div>
        </div>
        <div class="admin-row">
            <div>
                <strong>Music Production</strong>
                <div class="dim">Stops/starts generating new tracks. Production also pauses automatically at @_settings.MaxLibrarySize tracks.</div>
            </div>
            <div class="switch big @(_settings.MusicProductionEnabled ? "on" : null)" @onclick="ToggleMusicAsync"></div>
        </div>
        <div class="admin-row">
            <div>
                <strong>Program Director</strong>
                <div class="dim">Plans the weekly schedule in the background — or kick it manually.</div>
            </div>
            <button class="btn" @onclick="RunDirectorAsync">@(_directorKicked ? "✓ running…" : "Run now")</button>
        </div>
    </div>

    <div class="panel reveal">
        <div class="panel-label">Listener Messages</div>
        <div class="admin-row">
            <div>
                <strong>Greetings &amp; Requests</strong>
                <div class="dim">
                    Listeners can send messages from the live page; queued ones are read on air.
                    History and overrides live on the <a href="/messages">Messages page</a>.
                </div>
            </div>
            <div class="switch big @(_settings.GreetingsEnabled ? "on" : null)" @onclick="ToggleGreetingsAsync"></div>
        </div>
    </div>

    <div class="panel reveal">
        <div class="panel-label">Mixer — intelligent transitions</div>
        @if (_mixer is null)
        {
            <div class="empty-state"><span class="blink">▮</span> loading mixer state…</div>
        }
        else
        {
            <div class="admin-row">
                <div>
                    <strong>Real-time Mixer</strong>
                    <div class="dim">Crossfades, beat-aligned blends, talk-overs. Off = classic sequential playout.</div>
                </div>
                <div class="switch big @(_mx_enabled ? "on" : null)" @onclick="ToggleMixerAsync"></div>
            </div>

            <div class="dim" style="margin-bottom:12px; font-family:var(--font-mono); font-size:12px">
                @if (_mixer.Live.SessionActive)
                {
                    <span class="tag green">session active</span>
                    <span> master clock @TimeSpan.FromSeconds(_mixer.Live.MasterSeconds).ToString(@"hh\:mm\:ss")
                        · @_mixer.Live.TransitionsThisSession transitions this session</span>
                    @foreach (var item in _mixer.Live.ActiveItems)
                    {
                        <div style="margin-left:8px">▸ @item</div>
                    }
                    @if (_mixer.Live.LastDecision is { } decision)
                    {
                        <div style="margin-left:8px; margin-top:4px">last decision: @decision</div>
                    }
                }
                else if (_mx_enabled)
                {
                    <span class="tag amber">enabled — engaging at the next item boundary…</span>
                }
                else
                {
                    <span class="tag">off — legacy sequential playout</span>
                }
            </div>
            <div class="form-grid">
                <div class="field"><label>Target loudness (LUFS)</label><input type="number" step="0.5" @bind="_mx_targetLufs" /></div>
                <div class="field"><label>Duck level (dB)</label><input type="number" step="1" @bind="_mx_duckDb" /></div>
                <div class="field"><label>Crossfade (s)</label><input type="number" step="0.5" @bind="_mx_crossfade" /></div>
                <div class="field"><label>Gap after talk (ms min/max)</label>
                    <div class="btn-row">
                        <input type="number" style="width:90px" @bind="_mx_gapTalkMin" />
                        <input type="number" style="width:90px" @bind="_mx_gapTalkMax" />
                    </div>
                </div>
                <div class="field"><label>Gap between songs (ms min/max)</label>
                    <div class="btn-row">
                        <input type="number" style="width:90px" @bind="_mx_gapSongMin" />
                        <input type="number" style="width:90px" @bind="_mx_gapSongMax" />
                    </div>
                </div>
            </div>
            <div class="field" style="margin-bottom:12px">
                <label>Strategy weights JSON (empty = defaults)</label>
                <textarea rows="3" style="width:100%; font-family:var(--font-mono); font-size:12px; background:#0b0a07; color:var(--amber-hot); border:1px solid var(--line); border-radius:6px; padding:8px"
                          @bind="_mx_weights"></textarea>
            </div>
            <div class="btn-row" style="margin-bottom:14px">
                <button class="btn primary" @onclick="SaveMixerAsync">Apply</button>
                <button class="btn" @onclick="BackfillAsync">@(_backfillKicked ? "✓ backfill scheduled" : "Re-run analysis backfill")</button>
                @if (_mixerError is not null)
                {
                    <span class="dim">@_mixerError</span>
                }
                @if (_mixerSaved)
                {
                    <span class="flash">✓ applied</span>
                }
            </div>

            <div class="dim" style="margin-bottom:8px">
                Analysis: @_mixer.Status.AnalyzedTracks/@_mixer.Status.TotalTracks tracks · @_mixer.Status.AnalyzedAnnouncements announcements
                · Clips total: @_mixer.Status.TotalClips
                @foreach (var (strategy, count) in _mixer.Status.TransitionsByStrategy.OrderByDescending(kv => kv.Value))
                {
                    <span class="tag amber" style="margin-left:6px">@strategy ×@count</span>
                }
            </div>
            @if (_mixer.Status.RecentTransitions.Count > 0)
            {
                <table class="console-table">
                    <tbody>
                        @foreach (var t in _mixer.Status.RecentTransitions)
                        {
                            <tr title="@t.ReasonTrace">
                                <td class="dim" style="width:90px">@t.OccurredAt.ToLocalTime().ToString("HH:mm:ss")</td>
                                <td style="width:130px"><span class="tag">@t.Strategy</span></td>
                                <td class="dim">@t.OutgoingTitle → @t.IncomingTitle</td>
                                <td class="num dim" style="width:110px">
                                    @(t.GapMs > 0 ? $"gap {t.GapMs} ms" : $"{t.OverlapSeconds:F1} s overlap")
                                </td>
                                <td class="num dim" style="width:70px">@(t.ClipCount > 0 ? $"⚠ {t.ClipCount}" : "0 clips")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>

    <div class="panel reveal">
        <div class="panel-label">Production Pacing</div>
        <div class="form-grid">
            <div class="field"><label>Target unplayed tracks</label><input type="number" min="1" max="20" @bind="_settings_TargetQueueLength" /></div>
            <div class="field"><label>Max library size</label><input type="number" min="5" max="5000" @bind="_settings_MaxLibrarySize" /></div>
            <div class="field"><label>Min track length (s)</label><input type="number" min="30" max="600" @bind="_settings_MinDuration" /></div>
            <div class="field"><label>Max track length (s)</label><input type="number" min="30" max="600" @bind="_settings_MaxDuration" /></div>
        </div>
        <div class="dim" style="margin-bottom:12px; font-size:12.5px">
            Music AIs and voice booths are managed on the <a href="/studios">Studios page</a>.
        </div>
        <div class="btn-row">
            <button class="btn primary" @onclick="SavePacingAsync">Apply</button>
            @if (_saved)
            {
                <span class="flash">✓ applied</span>
            }
        </div>
    </div>
}

@code {
    private StationSettingsDto? _settings;
    private MixerOverviewDto? _mixer;
    private bool _saved;
    private bool _mixerSaved;
    private bool _backfillKicked;
    private string? _mixerError;
    private int _settings_TargetQueueLength;
    private int _settings_MaxLibrarySize;
    private int _settings_MinDuration;
    private int _settings_MaxDuration;
    private bool _mx_enabled;
    private double _mx_targetLufs;
    private double _mx_duckDb;
    private double _mx_crossfade;
    private int _mx_gapTalkMin;
    private int _mx_gapTalkMax;
    private int _mx_gapSongMin;
    private int _mx_gapSongMax;
    private string _mx_weights = "";

    private Timer? _mixerTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        // Live mixer state only — the editable fields are not reloaded so a
        // refresh never wipes in-progress edits.
        _mixerTimer = new Timer(async _ =>
        {
            var fresh = await Api.GetMixerAsync();
            if (fresh is not null && _mixer is not null)
            {
                _mixer = _mixer with { Live = fresh.Live, Status = fresh.Status };
                await InvokeAsync(StateHasChanged);
            }
        }, null, TimeSpan.FromSeconds(4), TimeSpan.FromSeconds(4));
    }

    public void Dispose() => _mixerTimer?.Dispose();

    private async Task LoadAsync()
    {
        _settings = await Api.GetSettingsAsync();
        if (_settings is not null)
        {
            _settings_TargetQueueLength = _settings.TargetQueueLength;
            _settings_MaxLibrarySize = _settings.MaxLibrarySize;
            _settings_MinDuration = _settings.MinTrackDurationSeconds;
            _settings_MaxDuration = _settings.MaxTrackDurationSeconds;
        }

        _mixer = await Api.GetMixerAsync();
        if (_mixer is not null)
        {
            var m = _mixer.Settings;
            _mx_enabled = m.MixerEnabled;
            _mx_targetLufs = m.TargetLufs;
            _mx_duckDb = m.DuckLevelDb;
            _mx_crossfade = m.DefaultCrossfadeSeconds;
            _mx_gapTalkMin = m.HardCutGapAfterTalkMsMin;
            _mx_gapTalkMax = m.HardCutGapAfterTalkMsMax;
            _mx_gapSongMin = m.HardCutGapSongMsMin;
            _mx_gapSongMax = m.HardCutGapSongMsMax;
            _mx_weights = m.StrategyWeightsJson;
        }
    }

    private MixerSettingsDto BuildMixerDto(bool enabled) => _mixer!.Settings with
    {
        MixerEnabled = enabled,
        TargetLufs = _mx_targetLufs,
        DuckLevelDb = _mx_duckDb,
        DefaultCrossfadeSeconds = _mx_crossfade,
        HardCutGapAfterTalkMsMin = _mx_gapTalkMin,
        HardCutGapAfterTalkMsMax = _mx_gapTalkMax,
        HardCutGapSongMsMin = _mx_gapSongMin,
        HardCutGapSongMsMax = _mx_gapSongMax,
        StrategyWeightsJson = _mx_weights,
    };

    private async Task ToggleMixerAsync()
    {
        if (_mixer is null)
        {
            return;
        }

        _mx_enabled = !_mx_enabled;
        _mixerError = await Api.SaveMixerSettingsAsync(BuildMixerDto(_mx_enabled));
        await LoadAsync();
    }

    private async Task SaveMixerAsync()
    {
        if (_mixer is null)
        {
            return;
        }

        _mixerError = await Api.SaveMixerSettingsAsync(BuildMixerDto(_mx_enabled));
        _mixerSaved = _mixerError is null;
        await LoadAsync();
    }

    private async Task BackfillAsync()
    {
        await Api.RunMixerBackfillAsync();
        _backfillKicked = true;
    }

    private async Task TogglePlayoutAsync()
    {
        // Re-fetch first: a stale page snapshot must never overwrite other settings.
        var fresh = await Api.GetSettingsAsync();
        if (fresh is null)
        {
            return;
        }

        _settings = await Api.SaveSettingsAsync(fresh with { PlayoutEnabled = !fresh.PlayoutEnabled });
    }

    private async Task ToggleMusicAsync()
    {
        var fresh = await Api.GetSettingsAsync();
        if (fresh is null)
        {
            return;
        }

        _settings = await Api.SaveSettingsAsync(fresh with { MusicProductionEnabled = !fresh.MusicProductionEnabled });
    }

    private bool _directorKicked;

    private async Task RunDirectorAsync()
    {
        await Api.RunDirectorAsync();
        _directorKicked = true;
    }

    private async Task ToggleGreetingsAsync()
    {
        var fresh = await Api.GetSettingsAsync();
        if (fresh is null)
        {
            return;
        }

        _settings = await Api.SaveSettingsAsync(fresh with { GreetingsEnabled = !fresh.GreetingsEnabled });
    }

    private async Task SavePacingAsync()
    {
        var fresh = await Api.GetSettingsAsync();
        if (fresh is null)
        {
            return;
        }

        _settings = await Api.SaveSettingsAsync(fresh with
        {
            TargetQueueLength = _settings_TargetQueueLength,
            MaxLibrarySize = _settings_MaxLibrarySize,
            MinTrackDurationSeconds = _settings_MinDuration,
            MaxTrackDurationSeconds = _settings_MaxDuration,
        });
        _saved = true;
    }
}
