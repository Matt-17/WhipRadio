@page "/chat"
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using WhipRadio.Core.Api
@using WhipRadio.Web.Services
@implements IDisposable
@inject ChatApiClient Api
@inject ChatLiveClient Live
@inject IJSRuntime JS

<PageTitle>WhipRadio - Chat</PageTitle>

<div class="chat-dashboard">
    <h1 class="stage-title">Chat</h1>
    <div class="stage-sub">the back office line</div>

    <div class="chat-layout reveal">
        <aside class="panel chat-rail">
            <div class="chat-rail-head">
                <div class="panel-label">Channels</div>
                @if (_loadingChannels)
                {
                    <StatusBadge Text="checking" />
                }
                <button class="btn small" title="start a group channel" @onclick="OpenCreateGroupAsync">+ Group</button>
            </div>

            <input class="chat-search"
                   type="search"
                   placeholder="Search"
                   @bind="_channelFilter"
                   @bind:event="oninput" />

            @if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <div class="chat-warning">@_loadError</div>
            }

            @if (Live.Channels.Count == 0 && _loadingChannels)
            {
                <div class="empty-state compact"><span class="blink">▮</span> opening lines...</div>
            }
            else if (Live.Channels.Count == 0)
            {
                <div class="empty-state compact">No chat channels yet.</div>
            }
            else
            {
                <div class="chat-channel-list">
                    @foreach (ChatChannelDto channel in FilteredChannels)
                    {
                        <button class="@ChannelClass(channel)" @onclick="() => SelectChannelAsync(channel)" title="@channel.Name">
                            @if (channel.Kind == "HostDm")
                            {
                                <PersonAvatar Name="@channel.Name" PhotoUrl="@channel.PhotoUrl" Size="thumb" />
                            }
                            else
                            {
                                <span class="@ChannelIconClass(channel)">
                                    <Icon Name="@ChannelIcon(channel)" />
                                </span>
                            }
                            <span class="chat-channel-copy">
                                <span class="chat-channel-top">
                                    <span class="chat-channel-name">@channel.Name</span>
                                    @if (!string.IsNullOrWhiteSpace(channel.LastMessagePreview))
                                    {
                                        <span class="chat-channel-time">@RailTimeLabel(channel.LastMessageAtUtc)</span>
                                    }
                                </span>
                                <span class="chat-channel-preview">
                                    @if (_thinking.ContainsKey(channel.Id))
                                    {
                                        <span class="chat-preview-typing"><i></i><i></i><i></i></span>
                                    }
                                    else
                                    {
                                        @(channel.LastMessagePreview ?? string.Empty)
                                    }
                                </span>
                            </span>
                            @if (channel.UnreadCount > 0)
                            {
                                <span class="chat-unread">@UnreadLabel(channel.UnreadCount)</span>
                            }
                        </button>
                    }
                </div>
            }
        </aside>

        <section class="panel chat-pane">
            @if (_activeChannel is null)
            {
                <div class="empty-state">select a channel</div>
            }
            else
            {
                <div class="chat-pane-head">
                    <div>
                        <div class="panel-label">@ChannelKindLabel(_activeChannel)</div>
                        <div class="chat-pane-title">@_activeChannel.Name</div>
                    </div>
                    @if (_activeChannel.Kind == "Group")
                    {
                        <button class="btn small @(_showRoster ? "active" : null)"
                                title="show group members"
                                @onclick="ToggleRosterAsync">
                            @(_activeChannel.Members?.Count ?? 0) member@((_activeChannel.Members?.Count ?? 0) == 1 ? "" : "s")
                        </button>
                    }
                </div>
                @if (_activeChannel.Kind == "Group" && _showRoster)
                {
                    <div class="chat-roster">
                        @foreach (ChatChannelMemberDto member in _activeChannel.Members ?? [])
                        {
                            <span class="chat-roster-member">
                                <PersonAvatar Name="@member.DisplayName" PhotoUrl="@member.PhotoUrl" Size="thumb" />
                                <span class="chat-roster-name">@member.DisplayName</span>
                                <span class="tag">@ParticipantKindLabel(member.Kind)</span>
                                <button class="btn small icon-only vote-down" title="remove from group"
                                        @onclick="() => _removeMemberTarget = member">
                                    <Icon Name="trash" />
                                </button>
                            </span>
                        }
                        <span class="chat-roster-add">
                            <select @bind="_addMemberKey">
                                <option value="">add member...</option>
                                @foreach (ChatParticipantOptionDto option in AddableParticipants)
                                {
                                    <option value="@OptionKey(option)">@option.Name — @option.Subtitle</option>
                                }
                            </select>
                            <button class="btn small" disabled="@(string.IsNullOrEmpty(_addMemberKey) || _addingMember)"
                                    @onclick="AddMemberAsync">Add</button>
                        </span>
                    </div>
                }

                <div class="chat-messages" @ref="_messagePane">
                    @if (_loadingMessages)
                    {
                        <div class="empty-state"><span class="blink">▮</span> loading history...</div>
                    }
                    else
                    {
                        @if (_hasMore && _messages.Count > 0)
                        {
                            <div class="chat-load-older">
                                <button class="btn small" disabled="@_loadingOlder" @onclick="LoadOlderAsync">
                                    @(_loadingOlder ? "loading..." : "load older")
                                </button>
                            </div>
                        }

                        ChatMessageDto? previous = null;
                        @foreach (ChatMessageDto message in _messages)
                        {
                            bool groupStart = IsGroupStart(message, previous);
                            IReadOnlyList<ChatActionDto> actions = VisibleActions(message);

                            @if (StartsNewDay(message, previous))
                            {
                                <div class="chat-day">@DayLabel(message.CreatedAtUtc)</div>
                            }

                            <article class="@MessageClass(message, groupStart)">
                                @if (message.SenderKind != "Admin" && message.SenderKind != "System")
                                {
                                    @if (groupStart)
                                    {
                                        <PersonAvatar Name="@message.SenderName" PhotoUrl="@message.SenderPhotoUrl" Size="thumb" />
                                    }
                                    else
                                    {
                                        <span class="chat-avatar-spacer"></span>
                                    }
                                }
                                else if (message.SenderKind == "System")
                                {
                                    <span class="chat-system-icon"><Icon Name="bell" /></span>
                                }
                                <div class="chat-bubble" title="@TimeLabel(message.CreatedAtUtc)">
                                    @if (groupStart && message.SenderKind != "Admin" && message.SenderKind != "System")
                                    {
                                        <div class="chat-msg-meta">
                                            <span>@message.SenderName</span>
                                            @if (message.HopCount > 0 && _activeChannel.Kind != "HostToHost")
                                            {
                                                <span class="chat-relay">relayed</span>
                                            }
                                            <span class="chat-msg-time">@TimeLabel(message.CreatedAtUtc)</span>
                                        </div>
                                    }
                                    <div class="chat-msg-body">@message.Text</div>
                                    @if (actions.Count > 0)
                                    {
                                        <div class="chat-actions">
                                            @for (int i = 0; i < message.Actions.Count; i++)
                                            {
                                                ChatActionDto action = message.Actions[i];
                                                if (!IsVisibleAction(action))
                                                {
                                                    continue;
                                                }

                                                <div class="chat-action-chip">
                                                    <Icon Name="bolt" />
                                                    <span class="chat-action-main">@ActionLabel(action)</span>
                                                    <StatusBadge Text="@action.State" Tone="@ActionTone(action.State)" Title="@action.ResultSummary" Pulse="@ActionPulses(action.State)" />
                                                    @if (action.State == "PendingConfirmation")
                                                    {
                                                        int actionIndex = i;
                                                        <button class="btn small primary" @onclick="() => ConfirmActionAsync(message, actionIndex)">Confirm</button>
                                                        <button class="btn small" @onclick="() => DismissActionAsync(message, actionIndex)">Dismiss</button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </article>
                            previous = message;
                        }

                        @if (_thinking.ContainsKey(_activeChannel.Id))
                        {
                            <article class="chat-msg thinking">
                                <span class="chat-avatar-spacer"></span>
                                <div class="chat-bubble chat-typing">
                                    <span class="chat-typing-dots"><i></i><i></i><i></i></span>
                                </div>
                            </article>
                        }
                    }
                </div>

                <form class="chat-composer" @onsubmit="SendAsync" @onsubmit:preventDefault>
                    @if (!CanPost)
                    {
                        <div class="chat-composer-note">@ComposerDisabledLabel</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_sendError))
                    {
                        <div class="chat-composer-error">@_sendError</div>
                    }
                    <textarea @ref="_composer"
                              @bind="_composerText"
                              @bind:event="oninput"
                              data-channel-id="@_activeChannel.Id"
                              placeholder="@ComposerPlaceholder"
                              disabled="@(!CanPost || _sending)"
                              maxlength="4000"
                              rows="2"></textarea>
                    <button class="btn primary icon-only" type="submit" disabled="@(!CanPost || _sending || string.IsNullOrWhiteSpace(_composerText))" title="Send">
                        <Icon Name="send" />
                    </button>
                </form>
            }
        </section>
    </div>
</div>

<Modal Visible="@_createGroupOpen" Title="New Group Channel" Class="modal-wide" OnClose="() => _createGroupOpen = false">
    <ChildContent>
        <div class="form-grid">
            <div class="field full">
                <label>Group name</label>
                <input @bind="_groupName" placeholder="optional — defaults to the member names" />
            </div>
        </div>
        <div class="chat-group-picker">
            @foreach (ChatParticipantOptionDto option in _participantOptions)
            {
                string key = OptionKey(option);
                <label class="chat-group-option">
                    <input type="checkbox"
                           checked="@_selectedParticipants.Contains(key)"
                           @onchange="args => ToggleParticipant(key, args)" />
                    <span>@option.Name</span>
                    <span class="dim">@option.Subtitle</span>
                </label>
            }
        </div>
        @if (_createGroupError is not null)
        {
            <div class="vote-down-text" style="margin-top:10px">@_createGroupError</div>
        }
    </ChildContent>
    <Footer>
        <button class="btn" @onclick="() => _createGroupOpen = false">Cancel</button>
        <button class="btn primary" disabled="@(_selectedParticipants.Count == 0 || _creatingGroup)"
                @onclick="CreateGroupAsync">
            Create Group
        </button>
    </Footer>
</Modal>

<ConfirmDialog Visible="@(_removeMemberTarget is not null)"
               Title="Remove member"
               ConfirmText="Remove"
               CancelText="Keep them"
               Danger="true"
               OnConfirm="RemoveMemberConfirmedAsync"
               OnCancel="() => _removeMemberTarget = null">
    @if (_removeMemberTarget is { } target)
    {
        <text>Remove <strong>@target.DisplayName</strong> from this group channel?</text>
    }
</ConfirmDialog>

@code {
    private const string SelectedChannelKey = "whipchat.channel";
    private static readonly TimeSpan GroupWindow = TimeSpan.FromMinutes(5);

    private readonly List<ChatMessageDto> _messages = [];
    private readonly Dictionary<Guid, string> _thinking = [];
    private ChatChannelDto? _activeChannel;
    private bool _loadingChannels = true;
    private bool _loadingMessages;
    private bool _loadingOlder;
    private bool _sending;
    private bool _hasMore;
    private bool _scrollPending;
    private bool _focusPending;
    private string _composerText = string.Empty;
    private string _channelFilter = string.Empty;
    private string? _loadError;
    private string? _sendError;
    private ElementReference _messagePane;
    private ElementReference _composer;
    private bool _createGroupOpen;
    private bool _creatingGroup;
    private bool _showRoster;
    private bool _addingMember;
    private string _groupName = string.Empty;
    private string _addMemberKey = string.Empty;
    private string? _createGroupError;
    private List<ChatParticipantOptionDto> _participantOptions = [];
    private readonly HashSet<string> _selectedParticipants = [];
    private ChatChannelMemberDto? _removeMemberTarget;

    private bool CanPost
        => _activeChannel is { IsArchived: false }
            && _activeChannel.Kind != "HostToHost";

    private string ComposerPlaceholder
        => _activeChannel is null
            ? ""
            : $"Message {_activeChannel.Name}";

    private string ComposerDisabledLabel
        => _activeChannel is null
            ? "select a channel"
            : _activeChannel.IsArchived
                ? "host no longer at the station"
                : _activeChannel.Kind == "HostToHost"
                    ? "agents only - you are reading their exchange"
                    : "composer disabled";

    private IEnumerable<ChatChannelDto> FilteredChannels
        => string.IsNullOrWhiteSpace(_channelFilter)
            ? Live.Channels
            : Live.Channels.Where(channel =>
                channel.Name.Contains(_channelFilter, StringComparison.OrdinalIgnoreCase)
                || (channel.LastMessagePreview?.Contains(_channelFilter, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        Live.Changed += OnLiveChanged;
        Live.MessageAdded += OnMessageAdded;
        Live.ThinkingChanged += OnThinkingChanged;

        try
        {
            await Live.EnsureStartedAsync();
            _activeChannel = Live.Channels.FirstOrDefault();
            if (_activeChannel is not null)
            {
                await LoadMessagesAsync(replace: true);
                await Api.MarkChatReadAsync(_activeChannel.Id);
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to initialize chat: {ex.Message}";
        }
        finally
        {
            _loadingChannels = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RestoreStateAsync();
        }

        if (_activeChannel is not null && CanPost)
        {
            await JS.InvokeVoidAsync("whipChat.wireComposer", _composer);
            if (_focusPending)
            {
                _focusPending = false;
                await JS.InvokeVoidAsync("whipChat.focus", _composer);
            }
        }

        if (_scrollPending)
        {
            _scrollPending = false;
            await JS.InvokeVoidAsync("whipChat.scrollToBottom", _messagePane, true);
        }
    }

    // Bring back the channel and draft the admin left behind when navigating
    // away; JS interop is only safe after the first interactive render.
    private async Task RestoreStateAsync()
    {
        try
        {
            string? savedId = await JS.InvokeAsync<string?>("whipChat.storageGet", SelectedChannelKey);
            if (Guid.TryParse(savedId, out Guid channelId) && _activeChannel?.Id != channelId)
            {
                ChatChannelDto? saved = Live.Channels.FirstOrDefault(channel => channel.Id == channelId);
                if (saved is not null)
                {
                    _activeChannel = saved;
                    await LoadMessagesAsync(replace: true);
                    await Api.MarkChatReadAsync(saved.Id);
                }
            }

            if (_activeChannel is not null)
            {
                string? draft = await JS.InvokeAsync<string?>("whipChat.storageGet", DraftKey(_activeChannel.Id));
                if (!string.IsNullOrEmpty(draft))
                {
                    _composerText = draft;
                }
            }
        }
        catch
        {
            // localStorage being unavailable must never break the chat page.
        }

        _focusPending = true;
        StateHasChanged();
    }

    private static string DraftKey(Guid channelId)
        => $"whipchat.draft.{channelId}";

    private async Task SelectChannelAsync(ChatChannelDto channel)
    {
        if (_activeChannel?.Id == channel.Id)
        {
            return;
        }

        _activeChannel = channel;
        _composerText = string.Empty;
        _sendError = null;
        try
        {
            await JS.InvokeVoidAsync("whipChat.storageSet", SelectedChannelKey, channel.Id.ToString());
            string? draft = await JS.InvokeAsync<string?>("whipChat.storageGet", DraftKey(channel.Id));
            if (!string.IsNullOrEmpty(draft))
            {
                _composerText = draft;
            }
        }
        catch
        {
        }

        await LoadMessagesAsync(replace: true);
        await Api.MarkChatReadAsync(channel.Id);
        _scrollPending = true;
        _focusPending = true;
    }

    private async Task LoadMessagesAsync(bool replace)
    {
        if (_activeChannel is null)
        {
            return;
        }

        _loadingMessages = replace;
        try
        {
            PagedChatMessagesDto page = await Api.GetChatMessagesAsync(_activeChannel.Id, take: 50);
            if (replace)
            {
                _messages.Clear();
            }

            _messages.AddRange(page.Messages);
            _hasMore = page.HasMore;
            _loadError = null;
            _scrollPending = true;
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load chat history: {ex.Message}";
        }
        finally
        {
            _loadingMessages = false;
        }
    }

    private async Task LoadOlderAsync()
    {
        if (_activeChannel is null || _loadingOlder || _messages.Count == 0)
        {
            return;
        }

        _loadingOlder = true;
        try
        {
            DateTime before = _messages[0].CreatedAtUtc;
            PagedChatMessagesDto page = await Api.GetChatMessagesAsync(_activeChannel.Id, before, 50);
            _messages.InsertRange(0, page.Messages);
            _hasMore = page.HasMore;
        }
        finally
        {
            _loadingOlder = false;
        }
    }

    private async Task SendAsync()
    {
        if (_activeChannel is null || _sending || !CanPost || string.IsNullOrWhiteSpace(_composerText))
        {
            return;
        }

        string text = _composerText;
        _sending = true;
        _sendError = null;
        try
        {
            (ChatMessageDto? message, string? error) = await Api.PostChatMessageAsync(_activeChannel.Id, text);
            if (message is null)
            {
                _sendError = string.IsNullOrWhiteSpace(error) ? "Message could not be sent." : error;
                return;
            }

            _composerText = string.Empty;
            try
            {
                await JS.InvokeVoidAsync("whipChat.storageRemove", DraftKey(_activeChannel.Id));
            }
            catch
            {
            }

            UpsertMessage(message);
            _scrollPending = true;
            _focusPending = true;
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task ConfirmActionAsync(ChatMessageDto message, int actionIndex)
    {
        string? error = await Api.ConfirmChatActionAsync(message.Id, actionIndex);
        _sendError = error;
    }

    private async Task DismissActionAsync(ChatMessageDto message, int actionIndex)
    {
        string? error = await Api.DismissChatActionAsync(message.Id, actionIndex);
        _sendError = error;
    }

    private IEnumerable<ChatParticipantOptionDto> AddableParticipants
        => _participantOptions.Where(option =>
            !(_activeChannel?.Members ?? []).Any(member =>
                string.Equals(member.Kind, option.Kind, StringComparison.Ordinal)
                && member.ModeratorId == option.ModeratorId
                && member.EntityId == option.EntityId));

    private async Task OpenCreateGroupAsync()
    {
        _groupName = string.Empty;
        _selectedParticipants.Clear();
        _createGroupError = null;
        _participantOptions = await Api.GetChatParticipantsAsync();
        _createGroupOpen = true;
    }

    private void ToggleParticipant(string key, ChangeEventArgs args)
    {
        if (args.Value is bool selected && selected)
        {
            _selectedParticipants.Add(key);
        }
        else
        {
            _selectedParticipants.Remove(key);
        }
    }

    private async Task CreateGroupAsync()
    {
        if (_selectedParticipants.Count == 0 || _creatingGroup)
        {
            return;
        }

        _creatingGroup = true;
        _createGroupError = null;
        try
        {
            List<ChatParticipantSelectionDto> selections = _participantOptions
                .Where(option => _selectedParticipants.Contains(OptionKey(option)))
                .Select(option => new ChatParticipantSelectionDto(option.Kind, option.ModeratorId, option.EntityId))
                .ToList();
            (ChatChannelDto? channel, string? error) = await Api.CreateGroupChatChannelAsync(
                string.IsNullOrWhiteSpace(_groupName) ? null : _groupName.Trim(),
                selections);
            if (channel is null)
            {
                _createGroupError = string.IsNullOrWhiteSpace(error) ? "Group could not be created." : error;
                return;
            }

            _createGroupOpen = false;
            await SelectChannelAsync(channel);
        }
        finally
        {
            _creatingGroup = false;
        }
    }

    private async Task ToggleRosterAsync()
    {
        _showRoster = !_showRoster;
        if (_showRoster && _participantOptions.Count == 0)
        {
            _participantOptions = await Api.GetChatParticipantsAsync();
        }
    }

    private async Task AddMemberAsync()
    {
        if (_activeChannel is null || string.IsNullOrEmpty(_addMemberKey) || _addingMember)
        {
            return;
        }

        ChatParticipantOptionDto? option = _participantOptions
            .FirstOrDefault(candidate => OptionKey(candidate) == _addMemberKey);
        if (option is null)
        {
            return;
        }

        _addingMember = true;
        try
        {
            await Api.AddChatChannelMemberAsync(
                _activeChannel.Id,
                new ChatParticipantSelectionDto(option.Kind, option.ModeratorId, option.EntityId));
            _addMemberKey = string.Empty;
        }
        finally
        {
            _addingMember = false;
        }
    }

    private async Task RemoveMemberConfirmedAsync()
    {
        if (_activeChannel is null || _removeMemberTarget is not { } target)
        {
            return;
        }

        _removeMemberTarget = null;
        await Api.RemoveChatChannelMemberAsync(_activeChannel.Id, target.Id);
    }

    private static string OptionKey(ChatParticipantOptionDto option)
        => $"{option.Kind}:{option.ModeratorId?.ToString(CultureInfo.InvariantCulture) ?? option.EntityId?.ToString() ?? ""}";

    private void OnLiveChanged()
        => _ = InvokeAsync(() =>
        {
            if (_activeChannel is { } active)
            {
                _activeChannel = Live.Channels.FirstOrDefault(channel => channel.Id == active.Id) ?? active;
            }

            StateHasChanged();
        });

    private void OnMessageAdded(ChatMessageDto message)
        => _ = InvokeAsync(async () =>
        {
            if (_activeChannel?.Id != message.ChannelId)
            {
                return;
            }

            UpsertMessage(message);
            _scrollPending = true;
            await Api.MarkChatReadAsync(message.ChannelId);
            StateHasChanged();
        });

    private void OnThinkingChanged(ChatAgentThinkingDto thinking)
        => _ = InvokeAsync(() =>
        {
            if (thinking.IsThinking)
            {
                _thinking[thinking.ChannelId] = thinking.SenderName;
                if (_activeChannel?.Id == thinking.ChannelId)
                {
                    _scrollPending = true;
                }
            }
            else
            {
                _thinking.Remove(thinking.ChannelId);
            }

            StateHasChanged();
        });

    private void UpsertMessage(ChatMessageDto message)
    {
        int existingIndex = _messages.FindIndex(item => item.Id == message.Id);
        if (existingIndex >= 0)
        {
            _messages[existingIndex] = message;
        }
        else
        {
            _messages.Add(message);
            _messages.Sort((left, right) => left.CreatedAtUtc.CompareTo(right.CreatedAtUtc));
        }
    }

    private string ChannelClass(ChatChannelDto channel)
    {
        List<string> parts = ["chat-channel"];
        if (_activeChannel?.Id == channel.Id)
        {
            parts.Add("active");
        }

        if (channel.IsArchived)
        {
            parts.Add("archived");
        }

        return string.Join(" ", parts);
    }

    private static string ChannelIcon(ChatChannelDto channel)
        => channel.Kind switch
        {
            "DirectorDm" => "director",
            "HostToHost" => "exchange",
            "Group" => "chat",
            _ => "antenna",
        };

    private static string ChannelIconClass(ChatChannelDto channel)
        => channel.Kind switch
        {
            "DirectorDm" => "chat-avatar-icon director",
            "HostToHost" => "chat-avatar-icon exchange",
            "Group" => "chat-avatar-icon group",
            _ => "chat-avatar-icon station",
        };

    private static string ChannelKindLabel(ChatChannelDto channel)
        => channel.Kind switch
        {
            "Station" => "station channel",
            "HostToHost" => "host exchange",
            "Group" => "group channel",
            _ => "direct line",
        };

    private static string ParticipantKindLabel(string kind)
        => kind switch
        {
            "Host" => "host",
            "ArtistMember" => "band member",
            "Guest" => "guest",
            _ => kind.ToLowerInvariant(),
        };

    private static string MessageClass(ChatMessageDto message, bool groupStart)
    {
        string baseClass = message.SenderKind switch
        {
            "Admin" => "chat-msg own",
            "System" => "chat-msg system",
            _ => "chat-msg",
        };
        return groupStart ? $"{baseClass} group-start" : baseClass;
    }

    private static IReadOnlyList<ChatActionDto> VisibleActions(ChatMessageDto message)
        => message.Actions.Where(IsVisibleAction).ToList();

    // Failed and auto-skipped actions live in the server log, not in the
    // consumer-facing chat - the agent already answered in prose.
    private static bool IsVisibleAction(ChatActionDto action)
        => action.State is not ("Failed" or "Dismissed");

    private static string ActionLabel(ChatActionDto action)
    {
        List<string> parts = action.Arguments
            .Where(pair => !string.IsNullOrWhiteSpace(pair.Value))
            .Take(2)
            .Select(pair => $"{pair.Key}: {pair.Value}")
            .ToList();
        return parts.Count == 0 ? action.Tool : $"{action.Tool} - {string.Join(", ", parts)}";
    }

    private static StatusBadgeTone ActionTone(string state)
        => state switch
        {
            "Succeeded" => StatusBadgeTone.Green,
            "Failed" => StatusBadgeTone.Red,
            "Dismissed" => StatusBadgeTone.Default,
            _ => StatusBadgeTone.Amber,
        };

    private static bool ActionPulses(string state)
        => state is "Running" or "PendingConfirmation";

    private static string UnreadLabel(int count)
        => count > 99 ? "99+" : count.ToString(CultureInfo.InvariantCulture);

    private static bool IsGroupStart(ChatMessageDto message, ChatMessageDto? previous)
        => previous is null
            || previous.SenderKind != message.SenderKind
            || previous.SenderModeratorId != message.SenderModeratorId
            || AsUtc(message.CreatedAtUtc) - AsUtc(previous.CreatedAtUtc) > GroupWindow
            || StartsNewDay(message, previous);

    private static bool StartsNewDay(ChatMessageDto message, ChatMessageDto? previous)
        => previous is null
            || AsUtc(message.CreatedAtUtc).ToLocalTime().Date != AsUtc(previous.CreatedAtUtc).ToLocalTime().Date;

    private static string DayLabel(DateTime value)
        => AsUtc(value).ToLocalTime().ToString("dddd, MMM d", CultureInfo.InvariantCulture);

    private static string TimeLabel(DateTime value)
        => AsUtc(value).ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture);

    private static string RailTimeLabel(DateTime value)
    {
        DateTime local = AsUtc(value).ToLocalTime();
        DateTime today = DateTime.Now.Date;
        if (local.Date == today)
        {
            return local.ToString("HH:mm", CultureInfo.InvariantCulture);
        }

        if (local.Date == today.AddDays(-1))
        {
            return "yesterday";
        }

        if (local.Date > today.AddDays(-7))
        {
            return local.ToString("ddd", CultureInfo.InvariantCulture);
        }

        return local.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture);
    }

    private static DateTime AsUtc(DateTime value)
        => value.Kind == DateTimeKind.Utc ? value : DateTime.SpecifyKind(value, DateTimeKind.Utc);

    public void Dispose()
    {
        Live.Changed -= OnLiveChanged;
        Live.MessageAdded -= OnMessageAdded;
        Live.ThinkingChanged -= OnThinkingChanged;
    }
}
