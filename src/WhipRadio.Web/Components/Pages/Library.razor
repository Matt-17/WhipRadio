@page "/library"
@using WhipRadio.Core.Api
@using WhipRadio.Web.Services
@implements IDisposable
@inject RadioApiClient Api
@inject PlayerState Player

<PageTitle>WhipRadio — Library</PageTitle>

<h1 class="stage-title">Record Collection</h1>
<div class="stage-sub">every track composed in-house · by fictional artists</div>

<div class="library-split">
    <div class="panel reveal library-artists">
        <div class="artist-panel-top">
            <div class="panel-label">Artists</div>
            <button class="btn small" title="create an artist from a one-line hint" @onclick="OpenCreateArtist">
                <Icon Name="inbox" /> Create Artist
            </button>
        </div>
        <input class="library-search" type="text" placeholder="search artist or song…"
               value="@_search" @oninput="OnSearchChangedAsync" />
        <div class="artist-list">
            <button class="artist-item @(_selectedArtistId is null ? "active" : null)" @onclick="() => SelectArtistAsync(null)">
                <span class="artist-name">All tracks</span>
                <span class="artist-meta dim">@(_artists.Sum(a => a.TrackCount)) songs</span>
            </button>
            @foreach (var pending in _artistCreationQueue)
            {
                <div class="artist-item artist-item-pending @(pending.Status == PendingArtistCreationStatus.Failed ? "failed" : null)" aria-live="polite">
                    <span class="artist-name-line">
                        <span class="artist-name">@PendingArtistTitle(pending)</span>
                        <span class="tag @PendingArtistTag(pending)">@PendingArtistStatusText(pending)</span>
                    </span>
                    <span class="artist-meta-row">
                        <span class="artist-meta dim">@(pending.Error ?? pending.Hint)</span>
                    </span>
                </div>
            }
            @foreach (var artist in _artists.Where(ArtistMatchesSearch))
            {
                <button class="artist-item @(_selectedArtistId == artist.Id ? "active" : null)"
                        @onclick="() => SelectArtistAsync(artist.Id)">
                    <span class="artist-name-line">
                        <span class="artist-name">@artist.Name</span>
                        @if (artist.IsRetired)
                        {
                            <span class="tag red">retired</span>
                        }
                    </span>
                    <span class="artist-meta-row">
                        <span class="artist-meta dim">@artist.Subgenre · @artist.TrackCount songs</span>
                        @if (IsGenerating(artist.Id))
                        {
                            <span class="tag red"><span class="blink rec-dot">●</span> REC</span>
                        }
                        else if (IsQueued(artist.Id))
                        {
                            <span class="tag amber">queue</span>
                        }
                    </span>
                </button>
            }
        </div>
    </div>

    <div class="library-main">
        @if (_selectedArtistId is { } selectedId)
        {
            var artist = _artistDetail ?? _artists.FirstOrDefault(a => a.Id == selectedId);
            if (artist is not null)
            {
                <div class="panel reveal">
                    <div class="artist-header">
                        <div>
                            <div class="artist-title">@artist.Name
                                @if (artist.IsRetired)
                                {
                                    <span class="tag red">retired</span>
                                }
                            </div>
                            <div class="dim" style="margin-bottom:8px">
                                @artist.Genre@(string.IsNullOrEmpty(artist.Subgenre) ? "" : $" / {artist.Subgenre}")
                                · @artist.TrackCount songs
                                · <span class="vote-up-text">▲ @artist.UpVotes</span> <span class="vote-down-text">▼ @artist.DownVotes</span>
                            </div>
                            <div class="artist-style">@artist.StyleDescriptor</div>
                            @if (!string.IsNullOrWhiteSpace(artist.PromotionText))
                            {
                                <div class="artist-promo">@artist.PromotionText</div>
                            }
                            <div class="artist-bio">
                                @if (_artistDetail is null)
                                {
                                    <span class="dim"><span class="blink">▮</span> pulling the press file…</span>
                                }
                                else
                                {
                                    @(_artistDetail.Biography ?? "No backstory on record.")
                                }
                            </div>
                            @if (_artistDetail?.Members is { Count: > 0 } members)
                            {
                                <div class="artist-member-roster">
                                    @foreach (var member in members)
                                    {
                                        <div class="artist-member">
                                            <div class="artist-member-head">
                                                <span>@member.Name</span>
                                                <span class="tag">@member.Role</span>
                                            </div>
                                            <div class="dim">@member.Biography</div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="artist-actions">
                            @if (!artist.IsRetired)
                            {
                                <button class="btn primary" @onclick="CreateSongAsync">+ Record new song</button>
                            }
                            @{ var queuedCount = QueuedCount(selectedId); }
                            @if (queuedCount > 0)
                            {
                                <div class="queue-box">Queue · @queuedCount song@(queuedCount == 1 ? "" : "s")</div>
                            }
                            @if (CanDeleteArtist(artist))
                            {
                                <button class="btn small vote-down" disabled="@_deletingArtist"
                                        title="delete this artist profile"
                                        @onclick="() => _deleteArtistTarget = artist"><Icon Name="trash" /> Delete Artist</button>
                            }
                            @if (_artistDeleteError is not null)
                            {
                                <div class="vote-down-text artist-action-error">@_artistDeleteError</div>
                            }
                        </div>
                    </div>
                </div>
            }
        }

        <div class="panel reveal">
            @if (_tracks is null)
            {
                <div class="empty-state"><span class="blink">▮</span> loading the shelves…</div>
            }
            else
            {
                var filtered = FilteredTracks();
                var totalPages = Math.Max(1, (int)Math.Ceiling(filtered.Count / (double)PageSize));
                var currentPage = Math.Min(_page, totalPages);
                var showRecRow = _status?.ArtistId is { } genArtist
                    && (_selectedArtistId is null || _selectedArtistId == genArtist);

                if (_deleteError is not null)
                {
                    <div class="vote-down-text" style="margin-bottom:10px">@_deleteError</div>
                }
                if (filtered.Count == 0 && !showRecRow)
                {
                    <div class="empty-state">
                        @(string.IsNullOrWhiteSpace(_search)
                            ? $"No records yet{(_selectedArtistId is not null ? " — record the first one!" : ".")}"
                            : "No records match your search.")
                    </div>
                }
                else
                {
                    <div class="library-song-list">
                        <div class="library-song-grid library-song-head">
                            <span class="library-action-cell"></span>
                            <div class="library-head-title">
                                <button class="@Sorted("title")" @onclick="@(() => SortAsync("title"))">Title</button>
                                @if (_selectedArtistId is null)
                                {
                                    <button class="@Sorted("artist")" @onclick="@(() => SortAsync("artist"))">Artist</button>
                                }
                            </div>
                            <span class="library-length-cell num">Length</span>
                            <button class="library-plays-cell num @Sorted("plays")" @onclick="@(() => SortAsync("plays"))">Plays</button>
                            <button class="library-votes-cell @Sorted("votes")" @onclick="@(() => SortAsync("votes"))">Votes</button>
                            <button class="library-created-cell @Sorted("created")" @onclick="@(() => SortAsync("created"))">Created</button>
                            <span class="library-delete-cell"></span>
                        </div>

                        @if (showRecRow)
                        {
                            <div class="library-song-grid library-song-item generating-row">
                                <div class="library-action-cell"><span class="rec-cell" title="Recording" aria-label="Recording"><span class="blink rec-dot rec-dot-lg" aria-hidden="true"></span></span></div>
                                <div class="library-title-line" title="@(_status?.TrackTitle ?? "a new song…")">
                                    <span class="track-title">@(_status?.TrackTitle is { } wip ? wip : "a new song…")</span>
                                </div>
                                <div class="library-recording-status">
                                    @if (_selectedArtistId is null && _status?.ArtistName is { } genName)
                                    {
                                        <span>@genName</span>
                                        <span class="library-meta-dot">·</span>
                                    }
                                    <span>recording</span>
                                    <span class="library-meta-dot">·</span>
                                    <span><StudioJobStatus StartedAtUtc="@_status?.StartedAtUtc" /></span>
                                </div>
                                <div class="library-delete-cell">
                                    <button class="btn small vote-down" title="cancel recording"
                                            disabled="@_cancelingGeneration"
                                            @onclick="CancelGenerationAsync"><Icon Name="stop" /></button>
                                </div>
                            </div>
                        }

                        @foreach (var track in filtered.Skip((currentPage - 1) * PageSize).Take(PageSize))
                        {
                            var createdLocal = track.CreatedAt.ToLocalTime();
                            var styleName = string.IsNullOrEmpty(track.Subgenre) ? track.Genre : track.Subgenre;
                            var voteNet = track.UpVotes - track.DownVotes;

                            <div class="library-song-grid library-song-item">
                                <div class="library-action-cell">
                                    <button class="btn small library-preview-btn" title="listen in the footer player (does not count as play)"
                                            @onclick="() => Player.PlayTrack(track)">▶</button>
                                </div>
                                <div class="library-title-line" title="@track.Title">
                                    <span class="track-title">@track.Title</span>
                                    @if (track.IsRetired)
                                    {
                                        <span class="tag red">retired</span>
                                    }
                                    @if (track.DeletionPending)
                                    {
                                        <span class="tag red">delete queued</span>
                                    }
                                    @if (track.HasVocals)
                                    {
                                        <span class="tag amber">vocal</span>
                                    }
                                </div>
                                <div class="library-song-meta">
                                    @if (_selectedArtistId is null)
                                    {
                                        <span>@track.ArtistName</span>
                                        <span class="library-meta-dot">·</span>
                                    }
                                    <span>@styleName</span>
                                </div>
                                <div class="library-length-cell num">@FormatClock(TimeSpan.FromSeconds(track.DurationSeconds))</div>
                                <div class="library-plays-cell num">@track.PlayCount</div>
                                <div class="library-votes-cell">
                                    <span class="library-vote-pill @VoteTone(voteNet)" title="@($"{track.UpVotes} up / {track.DownVotes} down")">
                                        <span class="library-vote-mark"></span>
                                        <span>@FormatVoteNet(voteNet)</span>
                                    </span>
                                </div>
                                <div class="library-created-cell dim" title="@createdLocal.ToString("dd.MM.yyyy HH:mm")">@createdLocal.ToString("dd.MM.")</div>
                                <div class="library-delete-cell">
                                    <button class="btn small vote-down"
                                            disabled="@track.DeletionPending"
                                            title="@(track.DeletionPending ? "delete queued after playback" : "delete this song")"
                                            @onclick="() => _deleteTarget = track"><Icon Name="trash" /></button>
                                </div>
                            </div>
                        }
                    </div>

                    if (totalPages > 1)
                    {
                        <div class="btn-row" style="margin-top:14px">
                            <button class="btn small" disabled="@(currentPage <= 1)" @onclick="() => GoToPage(currentPage - 1)">‹ prev</button>
                            <span class="dim">page @currentPage of @totalPages (@filtered.Count songs)</span>
                            <button class="btn small" disabled="@(currentPage >= totalPages)" @onclick="() => GoToPage(currentPage + 1)">next ›</button>
                        </div>
                    }
                }
            }
        </div>
    </div>
</div>

<Modal Visible="@_createArtistOpen" Title="Create Artist" Class="modal-wide" OnClose="CloseCreateArtist">
    <ChildContent>
        <div class="form-grid">
            <div class="field full">
                <label>Creation hint</label>
                <textarea rows="3" @bind="_artistHint" @bind:event="oninput"
                          placeholder="Describe the artist seed: genre, mood, origin, language, member count, or story angle."></textarea>
            </div>
        </div>
        @if (_createArtistError is not null)
        {
            <div class="vote-down-text" style="margin-top:12px">@_createArtistError</div>
        }
    </ChildContent>
    <Footer>
        <button class="btn" @onclick="CloseCreateArtist">Cancel</button>
        <button class="btn primary" disabled="@string.IsNullOrWhiteSpace(_artistHint)"
                @onclick="CreateArtistAsync">
            Queue Artist
        </button>
    </Footer>
</Modal>

<ConfirmDialog Visible="@(_deleteTarget is not null)"
               Title="Delete song"
               ConfirmText="Delete"
               CancelText="Keep it"
               Danger="true"
               OnConfirm="DeleteConfirmedAsync"
               OnCancel="() => _deleteTarget = null">
    @if (_deleteTarget is { } doomed)
    {
        <text>Delete <strong>"@doomed.Title"</strong> by @doomed.ArtistName?
        The recording, its votes and the audio file are gone for good.</text>
    }
</ConfirmDialog>

<ConfirmDialog Visible="@(_deleteArtistTarget is not null)"
               Title="Delete artist"
               ConfirmText="Delete"
               CancelText="Keep it"
               Danger="true"
               OnConfirm="DeleteArtistConfirmedAsync"
               OnCancel="() => _deleteArtistTarget = null">
    @if (_deleteArtistTarget is { } artistToDelete)
    {
        <text>Delete <strong>"@artistToDelete.Name"</strong>? This is only allowed while the artist has no songs.
        The artist biography and member roster will be removed.</text>
    }
</ConfirmDialog>

@code {
    private const int PageSize = 25;

    private List<TrackDto>? _tracks;
    private List<TrackDto>? _allTracks;
    private List<ArtistDto> _artists = [];
    private ArtistDto? _artistDetail;
    private MusicProductionStatusDto? _status;
    private string _sort = "title";
    private string _search = "";
    private int _page = 1;
    private Guid? _selectedArtistId;
    private TrackDto? _deleteTarget;
    private ArtistDto? _deleteArtistTarget;
    private string? _deleteError;
    private string? _artistDeleteError;
    private bool _cancelingGeneration;
    private bool _createArtistOpen;
    private bool _artistCreationPumpRunning;
    private bool _deletingArtist;
    private string _artistHint = "";
    private string? _createArtistError;
    private readonly List<PendingArtistCreation> _artistCreationQueue = [];
    private Timer? _statusTimer;

    protected override async Task OnInitializedAsync()
    {
        _artists = await Api.GetArtistsAsync();
        _status = await Api.GetMusicProductionStatusAsync();
        await LoadTracksAsync();

        _statusTimer = new Timer(async _ => await PollStatusAsync(), null,
            TimeSpan.FromSeconds(4), TimeSpan.FromSeconds(4));
    }

    private bool IsGenerating(Guid artistId) => _status?.ArtistId == artistId;

    private bool IsQueued(Guid artistId) => _status?.QueuedArtistIds.Contains(artistId) == true;

    private int QueuedCount(Guid artistId) => _status?.QueuedArtistIds.Count(id => id == artistId) ?? 0;

    private async Task PollStatusAsync()
    {
        var previous = _status?.ArtistId;
        var hadPendingDelete = _tracks?.Any(t => t.DeletionPending) == true;
        _status = await Api.GetMusicProductionStatusAsync();

        // A generation just finished → fresh track exists; refresh the shelves.
        if ((previous is not null && _status?.ArtistId is null) || hadPendingDelete)
        {
            _artists = await Api.GetArtistsAsync();
            await LoadTracksAsync();
            if (_selectedArtistId is not null)
            {
                _allTracks = await Api.GetLibraryAsync(sort: null, genre: null, artistId: null);
            }

        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadTracksAsync()
    {
        _tracks = await Api.GetLibraryAsync(_sort, genre: null, _selectedArtistId);
        if (_selectedArtistId is null)
        {
            _allTracks = _tracks;
        }
    }

    private List<TrackDto> FilteredTracks()
        => string.IsNullOrWhiteSpace(_search)
            ? _tracks ?? []
            : (_tracks ?? []).Where(t =>
                    t.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || t.ArtistName.Contains(_search, StringComparison.OrdinalIgnoreCase))
                .ToList();

    private bool ArtistMatchesSearch(ArtistDto artist)
        => string.IsNullOrWhiteSpace(_search)
            || artist.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || _allTracks?.Any(t => t.ArtistId == artist.Id
                && t.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)) == true;

    private async Task OnSearchChangedAsync(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _page = 1;

        // The selected artist fell out of the filter → fall back to all tracks.
        if (_selectedArtistId is { } id
            && _artists.FirstOrDefault(a => a.Id == id) is { } selected
            && !ArtistMatchesSearch(selected))
        {
            await SelectArtistAsync(null);
        }
    }

    private string Sorted(string column) => _sort == column ? "sorted" : "";

    private static string VoteTone(int net) => net switch
    {
        > 0 => "positive",
        < 0 => "negative",
        _ => "neutral",
    };

    private static string FormatVoteNet(int net) => net > 0 ? $"+{net}" : net.ToString();

    private async Task SortAsync(string column)
    {
        _sort = column;
        _page = 1;
        await LoadTracksAsync();
    }

    private void GoToPage(int page) => _page = page;

    private async Task SelectArtistAsync(Guid? artistId)
    {
        _selectedArtistId = artistId;
        _artistDetail = null;
        _page = 1;
        _deleteTarget = null;
        _deleteError = null;
        _artistDeleteError = null;
        await LoadTracksAsync();

        if (artistId is { } id)
        {
            // Detail fetch writes the biography on first view — may take a moment.
            _ = FetchDetailAsync(id);
        }
    }

    private async Task FetchDetailAsync(Guid id)
    {
        var detail = await Api.GetArtistAsync(id);
        if (_selectedArtistId == id)
        {
            _artistDetail = detail;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CreateSongAsync()
    {
        if (_selectedArtistId is { } id && await Api.ProduceTrackForArtistAsync(id))
        {
            _status = await Api.GetMusicProductionStatusAsync();
        }
    }

    private bool CanDeleteArtist(ArtistDto artist)
        => artist.TrackCount == 0
            && !IsGenerating(artist.Id)
            && !IsQueued(artist.Id);

    private void OpenCreateArtist()
    {
        _artistHint = "";
        _createArtistError = null;
        _createArtistOpen = true;
    }

    private void CloseCreateArtist()
    {
        _createArtistOpen = false;
        _createArtistError = null;
    }

    private Task CreateArtistAsync()
    {
        var hint = _artistHint.Trim();
        if (string.IsNullOrWhiteSpace(hint))
        {
            return Task.CompletedTask;
        }

        _createArtistError = null;
        _artistCreationQueue.Add(new PendingArtistCreation(hint));
        _createArtistOpen = false;
        _artistHint = "";
        _search = "";
        _ = ProcessArtistCreationQueueAsync();
        return Task.CompletedTask;
    }

    private async Task ProcessArtistCreationQueueAsync()
    {
        if (_artistCreationPumpRunning)
        {
            return;
        }

        _artistCreationPumpRunning = true;
        try
        {
            while (_artistCreationQueue.FirstOrDefault(p => p.Status == PendingArtistCreationStatus.Queued) is { } pending)
            {
                pending.Status = PendingArtistCreationStatus.Creating;
                pending.Error = null;
                await InvokeAsync(StateHasChanged);

                try
                {
                    var (artist, error) = await Api.CreateArtistAsync(pending.Hint);
                    if (artist is null)
                    {
                        pending.Status = PendingArtistCreationStatus.Failed;
                        pending.Error = CleanApiError(error);
                        await InvokeAsync(StateHasChanged);
                        continue;
                    }

                    _artistCreationQueue.Remove(pending);
                    _artistDeleteError = null;
                    _artists = await Api.GetArtistsAsync();
                    await SelectArtistAsync(artist.Id);
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    pending.Status = PendingArtistCreationStatus.Failed;
                    pending.Error = ex.Message;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        finally
        {
            _artistCreationPumpRunning = false;
            if (_artistCreationQueue.Any(p => p.Status == PendingArtistCreationStatus.Queued))
            {
                _ = ProcessArtistCreationQueueAsync();
            }
        }
    }

    private async Task CancelGenerationAsync()
    {
        _cancelingGeneration = true;
        try
        {
            if (await Api.CancelMusicProductionAsync())
            {
                _status = await Api.GetMusicProductionStatusAsync();
            }
        }
        finally
        {
            _cancelingGeneration = false;
        }
    }

    private async Task DeleteConfirmedAsync()
    {
        if (_deleteTarget is not { } track)
        {
            return;
        }

        _deleteTarget = null;
        DeleteTrackResult result = await Api.DeleteTrackAsync(track.Id);
        _deleteError = result.Error?.Trim('"');
        if (result.Deferred)
        {
            await LoadTracksAsync();
        }
        else if (_deleteError is null)
        {
            _artists = await Api.GetArtistsAsync();
            await LoadTracksAsync();
        }
    }

    private async Task DeleteArtistConfirmedAsync()
    {
        if (_deleteArtistTarget is not { } artist)
        {
            return;
        }

        _deleteArtistTarget = null;
        _deletingArtist = true;
        _artistDeleteError = null;
        try
        {
            DeleteArtistResult result = await Api.DeleteArtistAsync(artist.Id);
            if (!result.Deleted)
            {
                _artistDeleteError = CleanApiError(result.Error);
                return;
            }

            _selectedArtistId = null;
            _artistDetail = null;
            _artists = await Api.GetArtistsAsync();
            await LoadTracksAsync();
        }
        finally
        {
            _deletingArtist = false;
        }
    }

    public void Dispose() => _statusTimer?.Dispose();

    private static string PendingArtistTitle(PendingArtistCreation pending)
        => pending.Status switch
        {
            PendingArtistCreationStatus.Creating => "Creating artist...",
            PendingArtistCreationStatus.Failed => "Artist creation failed",
            _ => "Artist queued",
        };

    private static string PendingArtistStatusText(PendingArtistCreation pending)
        => pending.Status switch
        {
            PendingArtistCreationStatus.Creating => "creating",
            PendingArtistCreationStatus.Failed => "failed",
            _ => "queued",
        };

    private static string PendingArtistTag(PendingArtistCreation pending)
        => pending.Status == PendingArtistCreationStatus.Failed ? "red" : "amber";

    private static string CleanApiError(string? error)
    {
        if (string.IsNullOrWhiteSpace(error))
        {
            return "Artist creation failed.";
        }

        var trimmed = error.Trim().Trim('"');
        if (trimmed.StartsWith("{", StringComparison.Ordinal))
        {
            try
            {
                using var document = System.Text.Json.JsonDocument.Parse(trimmed);
                if (document.RootElement.TryGetProperty("detail", out var detail)
                    && detail.GetString() is { Length: > 0 } detailText)
                {
                    return detailText;
                }

                if (document.RootElement.TryGetProperty("title", out var title)
                    && title.GetString() is { Length: > 0 } titleText)
                {
                    return titleText;
                }
            }
            catch (System.Text.Json.JsonException)
            {
                // Keep the original server text below.
            }
        }

        return trimmed;
    }

    private sealed class PendingArtistCreation(string hint)
    {
        public string Hint { get; } = hint;

        public PendingArtistCreationStatus Status { get; set; } = PendingArtistCreationStatus.Queued;

        public string? Error { get; set; }
    }

    private enum PendingArtistCreationStatus
    {
        Queued,
        Creating,
        Failed,
    }
}
