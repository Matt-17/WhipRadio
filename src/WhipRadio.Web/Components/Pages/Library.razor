@page "/library"
@page "/library/artists/{ArtistSlug}"
@using WhipRadio.Core.Api
@using WhipRadio.Core.Helpers
@using WhipRadio.Web.Components.Library
@using WhipRadio.Web.Services
@implements IDisposable
@inject LibraryApiClient Api
@inject ProductionApiClient Production
@inject NavigationManager Navigation

<PageTitle>WhipRadio — Library</PageTitle>

<h1 class="stage-title">Record Collection</h1>
<div class="stage-sub">every track composed in-house • by fictional artists</div>

<div class="library-split">
    <ArtistRail Artists="_artists"
                Search="@_search"
                SelectedArtistId="_selectedArtistId"
                Status="_status"
                PendingCreations="_artistCreationQueue"
                Redefinitions="_artistRedefinitionQueue"
                ArtistFilter="ArtistMatchesSearch"
                OnSearchChanged="OnSearchChangedAsync"
                OnSelectArtist="SelectArtistAsync"
                OnCreateArtist="OpenCreateArtist" />

    <div class="library-main">
        @if (_selectedArtistId is { } selectedId)
        {
            var artist = _artistDetail ?? _artists.FirstOrDefault(a => a.Id == selectedId);
            if (artist is not null)
            {
                <ArtistDetailPanel Artist="artist"
                                   Detail="_artistDetail"
                                   QueuedCount="QueuedCount(selectedId)"
                                   RedefineDisabled="@(ActiveRedefinitionFor(artist.Id) is not null)"
                                   RedefineTitle="@ArtistRedefineTitle(artist)"
                                   DeleteDisabled="@(_deletingArtist || !CanDeleteArtist(artist))"
                                   DeleteTitle="@ArtistDeleteTitle(artist)"
                                   RedefineError="@(RedefinitionFor(artist.Id) is { Status: PendingArtistRedefinitionStatus.Failed } failedRedefinition ? failedRedefinition.Error : null)"
                                   DeleteError="@_artistDeleteError"
                                   VoicePending="_voicePending"
                                   OnCreateSong="CreateSongAsync"
                                   OnRedefineRequested="OpenRedefineArtist"
                                   OnDeleteRequested="artistToDelete => _deleteArtistTarget = artistToDelete"
                                   OnRecreateVoice="RecreateMemberVoiceAsync" />
            }
        }

        <TrackTable Tracks="_tracks"
                    Status="_status"
                    SelectedArtistId="_selectedArtistId"
                    Search="@_search"
                    Sort="@_sort"
                    OnSortChanged="SortAsync"
                    OnDeleted="TrackDeletedAsync"
                    OnStatusChanged="status => _status = status" />
    </div>
</div>

<CreateArtistModal Visible="@_createArtistOpen"
                   OnClose="CloseCreateArtist"
                   OnQueued="QueueArtistCreation" />

<ConfirmDialog Visible="@(_redefineArtistTarget is not null)"
               Title="Redefine artist"
               ConfirmText="Redefine"
               CancelText="Keep current"
               OnConfirm="RedefineArtistAsync"
               OnCancel="CloseRedefineArtist">
    @if (_redefineArtistTarget is { } artistToRedefine)
    {
        <text>Recreate the profile for <strong>"@artistToRedefine.Name"</strong>?
        The artist name, songs and votes stay attached; biography, hidden background, style details and member roster are rebuilt.</text>
    }
</ConfirmDialog>

<ConfirmDialog Visible="@(_deleteArtistTarget is not null)"
               Title="Delete artist"
               ConfirmText="Delete"
               CancelText="Keep it"
               Danger="true"
               OnConfirm="DeleteArtistConfirmedAsync"
               OnCancel="() => _deleteArtistTarget = null">
    @if (_deleteArtistTarget is { } artistToDelete)
    {
        <text>Delete <strong>"@artistToDelete.Name"</strong>? This is only allowed while the artist has no songs.
        The artist biography and member roster will be removed.</text>
    }
</ConfirmDialog>

@code {
    [Parameter] public string? ArtistSlug { get; set; }

    private List<TrackDto>? _tracks;
    private List<TrackDto>? _allTracks;
    private List<ArtistDto> _artists = [];
    private ArtistDto? _artistDetail;
    private MusicProductionStatusDto? _status;
    private string _sort = "title";
    private string _search = "";
    private Guid? _selectedArtistId;
    private readonly HashSet<Guid> _voicePending = [];
    private ArtistDto? _deleteArtistTarget;
    private string? _artistDeleteError;
    private bool _createArtistOpen;
    private bool _artistCreationPumpRunning;
    private bool _deletingArtist;
    private ArtistDto? _redefineArtistTarget;
    private readonly List<PendingArtistCreation> _artistCreationQueue = [];
    private readonly List<PendingArtistRedefinition> _artistRedefinitionQueue = [];
    private bool _artistRedefinitionPumpRunning;
    private bool _loaded;
    private string? _currentRouteArtistSlug;
    private Timer? _statusTimer;
    private int _polling;

    protected override async Task OnInitializedAsync()
    {
        _artists = await Api.GetArtistsAsync();
        _status = await Production.GetMusicProductionStatusAsync();
        _loaded = true;
        await ApplyArtistRouteAsync(ArtistSlug);

        _statusTimer = new Timer(_ => StatusTickAsync().Forget(), null,
            TimeSpan.FromSeconds(4), TimeSpan.FromSeconds(4));
    }

    // Timer callbacks are void: run the poll on the renderer's dispatcher, skip
    // overlapping ticks, and never let a failed fetch surface as an unobserved
    // exception — the next tick simply retries.
    private async Task StatusTickAsync()
    {
        if (Interlocked.Exchange(ref _polling, 1) == 1)
        {
            return;
        }

        try
        {
            await InvokeAsync(PollStatusAsync);
        }
        catch
        {
            // backend unreachable — retry on the next tick
        }
        finally
        {
            Volatile.Write(ref _polling, 0);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_loaded || string.Equals(ArtistSlug, _currentRouteArtistSlug, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        await ApplyArtistRouteAsync(ArtistSlug);
    }

    private bool IsGenerating(Guid artistId) => _status?.ArtistId == artistId;

    private bool IsQueued(Guid artistId) => _status?.QueuedArtistIds.Contains(artistId) == true;

    private int QueuedCount(Guid artistId) => _status?.QueuedArtistIds.Count(id => id == artistId) ?? 0;

    private PendingArtistRedefinition? RedefinitionFor(Guid artistId)
        => _artistRedefinitionQueue.FirstOrDefault(p => p.ArtistId == artistId);

    private PendingArtistRedefinition? ActiveRedefinitionFor(Guid artistId)
        => _artistRedefinitionQueue.FirstOrDefault(p =>
            p.ArtistId == artistId && p.Status != PendingArtistRedefinitionStatus.Failed);

    private async Task PollStatusAsync()
    {
        var previous = _status?.ArtistId;
        var hadPendingDelete = _tracks?.Any(t => t.DeletionPending) == true;
        _status = await Production.GetMusicProductionStatusAsync();

        // A generation just finished → fresh track exists; refresh the shelves.
        if ((previous is not null && _status?.ArtistId is null) || hadPendingDelete)
        {
            _artists = await Api.GetArtistsAsync();
            await LoadTracksAsync();
            if (_selectedArtistId is not null)
            {
                _allTracks = await Api.GetLibraryAsync(sort: null, genre: null, artistId: null);
            }

        }

        if (_voicePending.Count > 0 && _selectedArtistId is { } voiceArtistId)
        {
            await ReconcileMemberVoicesAsync(voiceArtistId);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadTracksAsync()
    {
        _tracks = await Api.GetLibraryAsync(_sort, genre: null, _selectedArtistId);
        if (_selectedArtistId is null)
        {
            _allTracks = _tracks;
        }
    }

    private bool ArtistMatchesSearch(ArtistDto artist)
        => string.IsNullOrWhiteSpace(_search)
            || artist.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || _allTracks?.Any(t => t.ArtistId == artist.Id
                && t.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)) == true;

    private async Task OnSearchChangedAsync(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";

        // The selected artist fell out of the filter → fall back to all tracks.
        if (_selectedArtistId is { } id
            && _artists.FirstOrDefault(a => a.Id == id) is { } selected
            && !ArtistMatchesSearch(selected))
        {
            await SelectArtistAsync(null);
        }
    }

    private async Task SortAsync(string column)
    {
        _sort = column;
        await LoadTracksAsync();
    }

    private async Task SelectArtistAsync(ArtistDto? artist)
    {
        var target = artist is { } selected ? $"/library/artists/{selected.Slug}" : "/library";
        if (!UriEquals(target))
        {
            Navigation.NavigateTo(target);
            return;
        }

        await ApplyArtistRouteAsync(artist?.Slug);
    }

    private async Task ApplyArtistRouteAsync(string? artistSlug)
    {
        _currentRouteArtistSlug = artistSlug;
        var normalizedSlug = WhipRadio.Core.Slugs.SlugGenerator.Normalize(artistSlug);
        var artist = string.IsNullOrWhiteSpace(artistSlug)
            ? null
            : _artists.FirstOrDefault(a => string.Equals(a.Slug, normalizedSlug, StringComparison.Ordinal));
        _selectedArtistId = artist?.Id;
        _artistDetail = null;
        _artistDeleteError = null;
        await LoadTracksAsync();

        if (_selectedArtistId is { } id)
        {
            // Detail fetch writes the biography on first view — may take a moment.
            _ = FetchDetailAsync(id);
        }
    }

    private bool UriEquals(string relativeUri)
        => string.Equals(
            Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/'),
            relativeUri.TrimStart('/').TrimEnd('/'),
            StringComparison.OrdinalIgnoreCase);

    private async Task FetchDetailAsync(Guid id)
    {
        var detail = await Api.GetArtistAsync(id);
        if (_selectedArtistId == id)
        {
            _artistDetail = detail;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RecreateMemberVoiceAsync(ArtistMemberDto member)
    {
        if (_voicePending.Contains(member.Id))
        {
            return;
        }

        if (await Api.RecreateMemberVoiceAsync(member.Id))
        {
            _voicePending.Add(member.Id);
        }
    }

    // Polled while a voice design is in flight: refreshes the roster and drops a
    // member from the pending set once a clip exists or an error was recorded.
    private async Task ReconcileMemberVoicesAsync(Guid artistId)
    {
        var detail = await Api.GetArtistAsync(artistId);
        if (detail is null || _selectedArtistId != artistId)
        {
            return;
        }

        _artistDetail = detail;
        var members = detail.Members ?? [];
        _voicePending.RemoveWhere(id =>
            members.FirstOrDefault(m => m.Id == id) is not { } m
            || m.HasVoiceReference
            || !string.IsNullOrWhiteSpace(m.VoiceError));
    }

    private async Task CreateSongAsync()
    {
        if (_selectedArtistId is { } id && await Api.ProduceTrackForArtistAsync(id))
        {
            _status = await Production.GetMusicProductionStatusAsync();
        }
    }

    private async Task TrackDeletedAsync(DeleteTrackResult result)
    {
        if (result.Deferred)
        {
            await LoadTracksAsync();
            return;
        }

        _artists = await Api.GetArtistsAsync();
        await LoadTracksAsync();
    }

    private bool CanDeleteArtist(ArtistDto artist)
        => artist.TrackCount == 0
            && !IsGenerating(artist.Id)
            && !IsQueued(artist.Id);

    private string ArtistDeleteTitle(ArtistDto artist)
    {
        if (_deletingArtist)
        {
            return "artist deletion is already running";
        }

        if (artist.TrackCount > 0)
        {
            return $"delete disabled: artist still has {artist.TrackCount} song{(artist.TrackCount == 1 ? "" : "s")}";
        }

        if (IsGenerating(artist.Id))
        {
            return "delete disabled: artist is recording right now";
        }

        if (IsQueued(artist.Id))
        {
            return "delete disabled: artist has songs queued";
        }

        return "delete this artist profile";
    }

    private string ArtistRedefineTitle(ArtistDto artist)
    {
        var active = ActiveRedefinitionFor(artist.Id);
        if (active is not null)
        {
            return active.Status == PendingArtistRedefinitionStatus.Redefining
                ? "artist redefinition is running"
                : "artist redefinition is queued";
        }

        return "rebuild this artist profile and member roster";
    }

    private void OpenCreateArtist() => _createArtistOpen = true;

    private void CloseCreateArtist() => _createArtistOpen = false;

    private void OpenRedefineArtist(ArtistDto artist)
    {
        _redefineArtistTarget = artist;
        _artistRedefinitionQueue.RemoveAll(p =>
            p.ArtistId == artist.Id && p.Status == PendingArtistRedefinitionStatus.Failed);
    }

    private void CloseRedefineArtist()
    {
        _redefineArtistTarget = null;
    }

    private Task RedefineArtistAsync()
    {
        if (_redefineArtistTarget is not { } artist || ActiveRedefinitionFor(artist.Id) is not null)
        {
            return Task.CompletedTask;
        }

        _artistRedefinitionQueue.RemoveAll(p =>
            p.ArtistId == artist.Id && p.Status == PendingArtistRedefinitionStatus.Failed);
        _artistRedefinitionQueue.Add(new PendingArtistRedefinition(artist.Id));
        _redefineArtistTarget = null;
        _ = ProcessArtistRedefinitionQueueAsync();
        return Task.CompletedTask;
    }

    private Task QueueArtistCreation(string hint)
    {
        _artistCreationQueue.Add(new PendingArtistCreation(hint));
        _createArtistOpen = false;
        _search = "";
        _ = ProcessArtistCreationQueueAsync();
        return Task.CompletedTask;
    }

    private async Task ProcessArtistCreationQueueAsync()
    {
        if (_artistCreationPumpRunning)
        {
            return;
        }

        _artistCreationPumpRunning = true;
        try
        {
            while (_artistCreationQueue.FirstOrDefault(p => p.Status == PendingArtistCreationStatus.Queued) is { } pending)
            {
                pending.Status = PendingArtistCreationStatus.Creating;
                pending.Error = null;
                await InvokeAsync(StateHasChanged);

                try
                {
                    var (artist, error) = await Api.CreateArtistAsync(pending.Hint);
                    if (artist is null)
                    {
                        pending.Status = PendingArtistCreationStatus.Failed;
                        pending.Error = CleanApiError(error);
                        await InvokeAsync(StateHasChanged);
                        continue;
                    }

                    _artistCreationQueue.Remove(pending);
                    _artistDeleteError = null;
                    _artists = await Api.GetArtistsAsync();
                    await SelectArtistAsync(artist);
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    pending.Status = PendingArtistCreationStatus.Failed;
                    pending.Error = ex.Message;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        finally
        {
            _artistCreationPumpRunning = false;
            if (_artistCreationQueue.Any(p => p.Status == PendingArtistCreationStatus.Queued))
            {
                _ = ProcessArtistCreationQueueAsync();
            }
        }
    }

    private async Task ProcessArtistRedefinitionQueueAsync()
    {
        if (_artistRedefinitionPumpRunning)
        {
            return;
        }

        _artistRedefinitionPumpRunning = true;
        try
        {
            while (_artistRedefinitionQueue.FirstOrDefault(p => p.Status == PendingArtistRedefinitionStatus.Queued) is { } pending)
            {
                pending.Status = PendingArtistRedefinitionStatus.Redefining;
                pending.Error = null;
                await InvokeAsync(StateHasChanged);

                try
                {
                    var (artist, error) = await Api.RedefineArtistAsync(pending.ArtistId, hint: null);
                    if (artist is null)
                    {
                        pending.Status = PendingArtistRedefinitionStatus.Failed;
                        pending.Error = CleanApiError(error);
                        await InvokeAsync(StateHasChanged);
                        continue;
                    }

                    _artistRedefinitionQueue.Remove(pending);
                    _artistDeleteError = null;
                    _artists = await Api.GetArtistsAsync();
                    await LoadTracksAsync();
                    if (_selectedArtistId == artist.Id)
                    {
                        _artistDetail = artist;
                    }
                    if (_selectedArtistId is not null)
                    {
                        _allTracks = await Api.GetLibraryAsync(sort: null, genre: null, artistId: null);
                    }

                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    pending.Status = PendingArtistRedefinitionStatus.Failed;
                    pending.Error = ex.Message;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        finally
        {
            _artistRedefinitionPumpRunning = false;
            if (_artistRedefinitionQueue.Any(p => p.Status == PendingArtistRedefinitionStatus.Queued))
            {
                _ = ProcessArtistRedefinitionQueueAsync();
            }
        }
    }

    private async Task DeleteArtistConfirmedAsync()
    {
        if (_deleteArtistTarget is not { } artist)
        {
            return;
        }

        _deleteArtistTarget = null;
        _deletingArtist = true;
        _artistDeleteError = null;
        try
        {
            DeleteArtistResult result = await Api.DeleteArtistAsync(artist.Id);
            if (!result.Deleted)
            {
                _artistDeleteError = CleanApiError(result.Error);
                return;
            }

            _selectedArtistId = null;
            _artistDetail = null;
            _artists = await Api.GetArtistsAsync();
            await LoadTracksAsync();
            Navigation.NavigateTo("/library");
        }
        finally
        {
            _deletingArtist = false;
        }
    }

    public void Dispose() => _statusTimer?.Dispose();

    private static string CleanApiError(string? error)
    {
        if (string.IsNullOrWhiteSpace(error))
        {
            return "Artist creation failed.";
        }

        var trimmed = error.Trim().Trim('"');
        if (trimmed.StartsWith("{", StringComparison.Ordinal))
        {
            try
            {
                using var document = System.Text.Json.JsonDocument.Parse(trimmed);
                if (document.RootElement.TryGetProperty("detail", out var detail)
                    && detail.GetString() is { Length: > 0 } detailText)
                {
                    return detailText;
                }

                if (document.RootElement.TryGetProperty("title", out var title)
                    && title.GetString() is { Length: > 0 } titleText)
                {
                    return titleText;
                }
            }
            catch (System.Text.Json.JsonException)
            {
                // Keep the original server text below.
            }
        }

        return trimmed;
    }
}
