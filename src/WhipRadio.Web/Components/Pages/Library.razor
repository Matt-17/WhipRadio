@page "/library"
@using WhipRadio.Core.Api
@using WhipRadio.Web.Services
@inject RadioApiClient Api

<PageTitle>WhipRadio — Library</PageTitle>

<h1 class="stage-title">Record Collection</h1>
<div class="stage-sub">every track composed in-house · by fictional artists</div>

<div class="panel reveal">
    <div class="panel-label">Artists</div>
    <div class="artist-strip">
        <button class="btn @(_artistFilter is null ? "primary" : null)" @onclick="() => FilterArtistAsync(null)">All</button>
        @foreach (var artist in _artists)
        {
            <button class="btn @(_artistFilter == artist.Id ? "primary" : null)"
                    title="@artist.StyleDescriptor"
                    @onclick="() => FilterArtistAsync(artist.Id)">
                @artist.Name <span class="dim">(@artist.TrackCount)</span>
                @if (artist.IsRetired)
                {
                    <span class="tag red">retired</span>
                }
            </button>
        }
    </div>
    <div class="btn-row" style="margin-top:12px">
        <span class="panel-label" style="margin:0">Genre:</span>
        <button class="btn @(_genreFilter is null ? "primary" : null)" @onclick="() => FilterGenreAsync(null)">all</button>
        @foreach (var genre in _genres)
        {
            <button class="btn @(_genreFilter == genre ? "primary" : null)" @onclick="() => FilterGenreAsync(genre)">@genre</button>
        }
    </div>
</div>

<div class="panel reveal">
    @if (_tracks is null)
    {
        <div class="empty-state"><span class="blink">▮</span> loading the shelves…</div>
    }
    else if (_tracks.Count == 0)
    {
        <div class="empty-state"><span class="blink">▮</span> No records match — try another filter.</div>
    }
    else
    {
        <table class="console-table">
            <thead>
                <tr>
                    <th><button class="@Sorted("title")" @onclick="@(() => SortAsync("title"))">Title</button></th>
                    <th><button class="@Sorted("artist")" @onclick="@(() => SortAsync("artist"))">Artist</button></th>
                    <th>Style</th>
                    <th class="num">Length</th>
                    <th class="num"><button class="@Sorted("plays")" @onclick="@(() => SortAsync("plays"))">Plays</button></th>
                    <th><button class="@Sorted("votes")" @onclick="@(() => SortAsync("votes"))">Votes</button></th>
                    <th><button class="@Sorted("created")" @onclick="@(() => SortAsync("created"))">Created</button></th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var track in _tracks)
                {
                    <tr>
                        <td>@track.Title</td>
                        <td class="dim">@track.ArtistName</td>
                        <td class="dim">@(string.IsNullOrEmpty(track.Subgenre) ? track.Genre : track.Subgenre)</td>
                        <td class="num">@FormatClock(TimeSpan.FromSeconds(track.DurationSeconds))</td>
                        <td class="num">@track.PlayCount</td>
                        <td>
                            <VoteBar Up="track.UpVotes" Down="track.DownVotes" />
                        </td>
                        <td class="dim">@track.CreatedAt.ToLocalTime().ToString("dd.MM. HH:mm")</td>
                        <td>
                            @if (track.IsRetired)
                            {
                                <span class="tag red">retired</span>
                            }
                            else
                            {
                                <span class="tag green">active</span>
                            }
                            @if (track.HasVocals)
                            {
                                <span class="tag amber">vocal</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<TrackDto>? _tracks;
    private List<ArtistDto> _artists = [];
    private List<string> _genres = [];
    private string _sort = "created";
    private string? _genreFilter;
    private Guid? _artistFilter;

    protected override async Task OnInitializedAsync()
    {
        _artists = await Api.GetArtistsAsync();
        await LoadAsync();
        _genres = _tracks?.Select(t => t.Genre).Distinct().OrderBy(g => g).ToList() ?? [];
    }

    private async Task LoadAsync() => _tracks = await Api.GetLibraryAsync(_sort, _genreFilter, _artistFilter);

    private string Sorted(string column) => _sort == column ? "sorted" : "";

    private async Task SortAsync(string column)
    {
        _sort = column;
        await LoadAsync();
    }

    private async Task FilterGenreAsync(string? genre)
    {
        _genreFilter = genre;
        await LoadAsync();
    }

    private async Task FilterArtistAsync(Guid? artistId)
    {
        _artistFilter = artistId;
        await LoadAsync();
    }
}
