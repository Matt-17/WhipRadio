@page "/studios"
@using WhipRadio.Core.Api
@using WhipRadio.Core.Configuration
@using WhipRadio.Web.Services
@implements IDisposable
@inject RadioApiClient Api
@inject StudioLiveClient StudioLive

<PageTitle>WhipRadio — Studios</PageTitle>

<h1 class="stage-title">Studios</h1>
<div class="stage-sub">writer rooms, recording studios &amp; voice booths · jobs queue for the first free room</div>

@if (_formKind is not null && _editId is null)
{
    <div class="panel reveal">
        <div class="panel-label">Add @KindSingular(_formKind)</div>
        @StudioForm
    </div>
}
else
{
    <div class="btn-row reveal panel-gap">
        <button class="btn" @onclick="@(() => OpenCreate("WriterRoom"))">+ add writer room</button>
        <button class="btn" @onclick="@(() => OpenCreate("Recording"))">+ connect studio</button>
        <button class="btn" @onclick="@(() => OpenCreate("VoiceBooth"))">+ connect booth</button>
    </div>
}

    @foreach (var kind in StudioKinds)
    {
        var kindStudios = _studios.Where(s => s.Kind == kind).ToList();
        var kindPendingOperations = _pendingOperations.Where(operation => operation.Kind == kind).ToList();
        var hasRows = kindStudios.Count > 0 || kindPendingOperations.Count > 0;
        <div class="panel reveal studio-section">
            <div class="studio-section-head">
                <div>
                    <div class="studio-section-title">@KindTitle(kind)</div>
                    <div class="studio-section-sub">@KindDescription(kind)</div>
                </div>
                <button class="btn small" @onclick="@(() => OpenCreate(kind))">@AddButtonText(kind)</button>
            </div>

            @if (_loading && !hasRows)
            {
                <div class="empty-state">loading @KindTitle(kind).ToLowerInvariant()...</div>
            }
            else if (!hasRows)
            {
                <div class="empty-state">no @(KindTitle(kind).ToLowerInvariant()) connected yet</div>
            }
        else
        {
            <div class="studio-table-wrap">
                <table class="console-table studio-table">
                    <tbody>
                        @foreach (var pending in kindPendingOperations)
                        {
                            <tr class="studio-pending-row">
                                <td class="studio-name-cell">
                                    <div class="studio-name-line">
                                        <strong>@PendingName(pending)</strong>
                                    </div>
                                    <div class="dim micro-copy">@PendingResourceLabel(pending)</div>
                                </td>
                                <td class="studio-state-cell">
                                    <div class="studio-job-line">
                                        <StatusBadge Text="@pending.Status"
                                                     Tone="@PendingTone(pending)"
                                                     Pulse="@PendingPulse(pending)" />
                                        <span class="studio-job-title" title="@pending.Label">@pending.Label</span>
                                    </div>
                                    <div class="dim studio-job-time">@PendingStatusDetail(pending)</div>
                                </td>
                                <td colspan="2" class="studio-pending-tail">runtime</td>
                            </tr>
                        }
                        @foreach (var studio in kindStudios)
                        {
                            <tr>
                                <td class="studio-name-cell">
                                    <div class="studio-name-line">
                                        <strong>@studio.Name</strong><span class="dim"> &bull; @(string.IsNullOrEmpty(studio.Url) ? "online API" : studio.Url)</span>
                                    </div>
                                    <div class="dim micro-copy">@ProviderLabel(studio)</div>
                                </td>
                                <td class="studio-state-cell">
                                    @if (studio.CurrentJob is { } job)
                                    {
                                        <div class="studio-job-line">
                                            <StatusBadge Text="@BusyLabel(studio.Kind)" Pulse="true" />
                                            <span class="studio-job-title" title="@job">@job</span>
                                        </div>
                                        <div class="dim studio-job-time">
                                            <StudioJobStatus StartedAtUtc="@studio.JobStartedAtUtc"
                                                             Progress="@studio.CurrentJobProgress" />
                                        </div>
                                    }
                                    else if (studio.IsActive)
                                    {
                                        <StatusBadge Text="@RuntimeLabel(studio)"
                                                     Tone="@RuntimeTone(studio)"
                                                     Marker="@RuntimeMarker(studio)" />
                                    }
                                    else
                                    {
                                        <StatusBadge Text="off" />
                                    }
                                </td>
                                <td style="width:58px; text-align:center">
                                    <a class="btn small icon-only" href="@HistoryHref(studio.Id)" title="show studio history">
                                        <Icon Name="history" />
                                    </a>
                                </td>
                                <td style="width:220px; white-space:nowrap; text-align:right">
                                    @if (!string.IsNullOrEmpty(studio.Url))
                                    {
                                        <button class="btn small" title="restart the container"
                                                disabled="@_restartBusy"
                                                @onclick="() => AskRestart(studio)">restart</button>
                                    }
                                    <button class="btn small" @onclick="() => StartEdit(studio)">edit</button>
                                    <UiSwitch Value="@studio.IsActive"
                                              ValueChanged="@(_ => ToggleAsync(studio.Id))"
                                              Title="@(studio.IsActive ? "active" : "inactive")" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_formKind == kind && _editId is not null)
        {
            @StudioForm
        }
    </div>
}

@if (_restartNotice is not null)
{
    <div class="@(_restartOk ? "flash" : "text-danger")" style="margin-top:8px">@_restartNotice</div>
}

<ConfirmDialog Visible="@(_restartTarget is not null)"
               Title="Restart studio container"
               ConfirmText="Restart"
               Danger="@(_restartTarget?.CurrentJob is not null)"
               OnConfirm="RestartConfirmedAsync"
               OnCancel="@(() => _restartTarget = null)">
    @if (_restartTarget?.CurrentJob is { } job)
    {
        <p><strong>@_restartTarget?.Name</strong> is busy right now (@job) — restarting kills that job.</p>
    }
    else
    {
        <p>Restart the container behind <strong>@_restartTarget?.Name</strong>? Models reload on the next job.</p>
    }
</ConfirmDialog>

@code {
    private RenderFragment StudioForm => __builder =>
    {
        <div class="studio-form">
            <div class="seg" role="radiogroup" aria-label="Studio source" style="margin-bottom:12px">
                <button type="button" class="seg-btn @(_formSource == "local" ? "active" : null)"
                        @onclick="@(() => SetSource("local"))">Local container</button>
                <button type="button" class="seg-btn @(_formSource == "api" ? "active" : null)"
                        @onclick="@(() => SetSource("api"))">Online API</button>
            </div>
            <div class="form-grid">
                <div class="field">
                    <label>Name</label>
                    <input @bind="_formName" placeholder="@DefaultName(_formKind!)" />
                </div>
                @if (_formSource == "local")
                {
                    <div class="field">
                        <label>URL</label>
                        <input @bind="_formUrl" placeholder="@DefaultUrl(_formKind!)" />
                    </div>
                }
                else
                {
                    <div class="field">
                        <label>Provider</label>
                        <select @bind="_formProvider">
                            @foreach (var provider in ApiProviders(_formKind!))
                            {
                                <option value="@provider.Value">@provider.Label</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>API key</label>
                        <input type="password" @bind="_formApiKey" placeholder="@ApiKeyPlaceholder(_formProvider)" />
                    </div>
                }
            </div>
            <div class="btn-row">
                <button class="btn" @onclick="TestAsync">
                    Test
                </button>
                @if (_testResult is not null)
                {
                    <StatusBadge Text="@(_testResult.Ok ? "connected" : "failed")"
                                 Tone="@(_testResult.Ok ? StatusBadgeTone.Green : StatusBadgeTone.Red)"
                                 Title="@_testResult.Detail" />
                }
                <button class="btn primary" disabled="@(!(_testResult?.Ok ?? false))" @onclick="SaveAsync">
                    @(_editId is null ? "Create" : "Save")
                </button>
                <button class="btn" @onclick="CloseForm">cancel</button>
                @if (_editId is { } editId)
                {
                    <button class="btn vote-down push-right" @onclick="() => DeleteAsync(editId)">delete</button>
                }
                @if (_saveError is not null)
                {
                    <span class="text-danger">@_saveError</span>
                }
            </div>
        </div>
    };

    private List<StudioDto> _studios = [];
    private List<StudioPendingOperationDto> _pendingOperations = [];
    private bool _loading = true;

    private string? _formKind;
    private Guid? _editId;
    private string _formSource = "local";
    private string _formName = "";
    private string _formUrl = "";
    private string _formProvider = "elevenlabs";
    private string _formApiKey = "";
    private StudioTestResultDto? _testResult;
    private string? _saveError;

    private StudioDto? _restartTarget;
    private bool _restartBusy;
    private bool _restartOk;
    private string? _restartNotice;

    private static readonly string[] StudioKinds = ["WriterRoom", "Recording", "VoiceBooth"];

    private static readonly (string Value, string Label)[] WriterRoomApiProviders = [("openai", "OpenAI")];

    private static readonly (string Value, string Label)[] StudioApiProviders = [("elevenlabs", "ElevenLabs")];

    protected override void OnInitialized()
    {
        StudioLive.Changed += OnStudiosChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await StudioLive.EnsureStartedAsync();
            SyncStudios();
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        await StudioLive.RefreshSnapshotAsync();
        SyncStudios();
    }

    private void OnStudiosChanged()
    {
        SyncStudios();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SyncStudios()
    {
        _studios = StudioLive.Studios.ToList();
        _pendingOperations = StudioLive.PendingOperations.ToList();
    }

    private string DefaultName(string kind)
        => kind switch
        {
            "WriterRoom" => $"Writer Room #{_studios.Count(s => s.Kind == "WriterRoom") + 1}",
            "VoiceBooth" => $"Booth #{_studios.Count(s => s.Kind == "VoiceBooth") + 1}",
            _ => $"Studio #{_studios.Count(s => s.Kind == "Recording") + 1}",
        };

    private static string DefaultUrl(string kind)
        => kind switch
        {
            "WriterRoom" => ServiceEndpointDefaults.WriterRoom,
            "VoiceBooth" => ServiceEndpointDefaults.VoiceBooth,
            _ => ServiceEndpointDefaults.RecordingStudioLoopback,
        };

    private static string KindTitle(string kind)
        => kind switch
        {
            "WriterRoom" => "Writer Rooms",
            "VoiceBooth" => "Voice Booths",
            _ => "Recording Studios",
        };

    private static string KindSingular(string kind)
        => kind switch
        {
            "WriterRoom" => "Writer Room",
            "VoiceBooth" => "Voice Booth",
            _ => "Recording Studio",
        };

    private static string KindDescription(string kind)
        => kind switch
        {
            "WriterRoom" => "scripts, titles and director reasoning",
            "VoiceBooth" => "announcements, hosts and designed voices",
            _ => "music AI generation endpoints",
        };

    private static string AddButtonText(string kind)
        => kind switch
        {
            "WriterRoom" => "+ add room",
            "Recording" => "+ add studio",
            "VoiceBooth" => "+ add booth",
            _ => "+ add"
        };

    private static string BusyLabel(string kind)
        => kind == "WriterRoom" ? "WORK" : "REC";

    private static string PendingName(StudioPendingOperationDto pending)
        => $"{KindSingular(pending.Kind)} pending";

    private static string PendingResourceLabel(StudioPendingOperationDto pending)
        => string.IsNullOrWhiteSpace(pending.ResourceGroup)
            ? "runtime"
            : pending.ResourceGroup;

    private static StatusBadgeTone? PendingTone(StudioPendingOperationDto pending)
        => pending.Status.Equals("WAITING", StringComparison.OrdinalIgnoreCase)
            || pending.Status.Equals("LOADING", StringComparison.OrdinalIgnoreCase)
            || pending.Status.Equals("PREPARING", StringComparison.OrdinalIgnoreCase)
                ? StatusBadgeTone.Amber
                : null;

    private static bool PendingPulse(StudioPendingOperationDto pending)
        => pending.Status.Equals("LOADING", StringComparison.OrdinalIgnoreCase)
            || pending.Status.Equals("WORK", StringComparison.OrdinalIgnoreCase)
            || pending.Status.Equals("REC", StringComparison.OrdinalIgnoreCase);

    private static string PendingStatusDetail(StudioPendingOperationDto pending)
    {
        var elapsed = FormatElapsed(DateTime.UtcNow - pending.StartedAtUtc);
        var detail = string.IsNullOrWhiteSpace(pending.Progress)
            ? pending.Detail
            : pending.Progress;

        return string.IsNullOrWhiteSpace(detail)
            ? elapsed
            : $"{elapsed} - {detail}";
    }

    private static string RuntimeLabel(StudioDto studio)
        => studio.RuntimeStatus switch
        {
            "ready" => "idle",
            "busy" => "blocked",
            "offline" => "offline",
            "unknown" => "checking",
            _ => studio.RuntimeStatus,
        };

    private static StatusBadgeTone? RuntimeTone(StudioDto studio)
        => studio.RuntimeStatus == "busy" ? StatusBadgeTone.Amber : null;

    private static bool? RuntimeMarker(StudioDto studio)
        => studio.RuntimeStatus == "busy" ? false : null;

    private static string ProviderLabel(StudioDto studio)
        => !string.IsNullOrWhiteSpace(studio.Url) && !string.IsNullOrWhiteSpace(studio.RuntimeDetail)
            ? studio.RuntimeDetail
            : studio.Provider;

    private static IReadOnlyList<(string Value, string Label)> ApiProviders(string kind)
        => kind == "WriterRoom" ? WriterRoomApiProviders : StudioApiProviders;

    private static string DefaultApiProvider(string kind)
        => ApiProviders(kind)[0].Value;

    private static string ApiKeyPlaceholder(string provider)
        => provider == "openai" ? "sk-..." : "xi-...";

    private static string HistoryHref(Guid studioId)
        => $"studio-history?studioId={studioId}";

    private static string JobElapsed(StudioDto studio)
        => studio.JobStartedAtUtc is { } started ? FormatElapsed(DateTime.UtcNow - started) : "";

    private static string JobStatusDetail(StudioDto studio)
    {
        var elapsed = JobElapsed(studio);
        return string.IsNullOrWhiteSpace(studio.CurrentJobProgress)
            ? elapsed
            : $"{elapsed} · {studio.CurrentJobProgress}";
    }

    private void OpenCreate(string kind)
    {
        _formKind = kind;
        _editId = null;
        _formSource = "local";
        _formName = "";
        _formUrl = "";
        _formProvider = DefaultApiProvider(kind);
        _formApiKey = "";
        _testResult = null;
        _saveError = null;
    }

    private void StartEdit(StudioDto studio)
    {
        _formKind = studio.Kind;
        _editId = studio.Id;
        _formSource = string.IsNullOrEmpty(studio.Url) ? "api" : "local";
        _formName = studio.Name;
        _formUrl = studio.Url;
        _formProvider = _formSource == "api" ? studio.Provider : DefaultApiProvider(studio.Kind);
        _formApiKey = "";
        _testResult = null;
        _saveError = null;
    }

    private void SetSource(string source)
    {
        _formSource = source;
        if (_formKind is not null && _formSource == "api")
        {
            _formProvider = DefaultApiProvider(_formKind);
        }

        _testResult = null; // changed config invalidates the previous test
    }

    private void CloseForm()
    {
        _formKind = null;
        _editId = null;
    }

    private async Task TestAsync()
    {
        _saveError = null;
        try
        {
            _testResult = await Api.TestStudioAsync(new TestStudioDto(
                _formKind!, _formSource,
                _formSource == "local" ? _formUrl : null,
                _formSource == "api" ? _formProvider : null,
                _formSource == "api" ? _formApiKey : null));
        }
        catch (Exception ex)
        {
            _testResult = new StudioTestResultDto(Ok: false, Provider: null, Detail: $"test failed: {ex.Message}");
        }
    }

    private async Task SaveAsync()
    {
        _saveError = null;
        try
        {
            var dto = new SaveStudioDto(
                string.IsNullOrWhiteSpace(_formName) ? null : _formName,
                _formKind!, _formSource,
                _formSource == "local" ? _formUrl : null,
                _formSource == "api" ? _formProvider : null,
                _formSource == "api" ? _formApiKey : null);

            var (studio, error) = _editId is { } id
                ? await Api.UpdateStudioAsync(id, dto)
                : await Api.CreateStudioAsync(dto);

            if (studio is null)
            {
                _saveError = error ?? "save failed";
                return;
            }

            CloseForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _saveError = $"Save failed: {ex.Message}";
        }
    }

    private void AskRestart(StudioDto studio)
    {
        _restartNotice = null;
        _restartTarget = studio;
    }

    private async Task RestartConfirmedAsync()
    {
        if (_restartTarget is not { } target)
        {
            return;
        }

        _restartTarget = null;
        _restartBusy = true;
        _restartNotice = $"restarting {target.Name}...";
        _restartOk = true;
        StateHasChanged();

        try
        {
            var result = await Api.RestartStudioAsync(target.Id);
            _restartOk = result.Ok;
            _restartNotice = $"{target.Name}: {result.Detail}";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _restartOk = false;
            _restartNotice = $"{target.Name}: restart failed — {ex.Message}";
        }
        finally
        {
            _restartBusy = false;
        }
    }

    private async Task ToggleAsync(Guid id)
    {
        try
        {
            await Api.ToggleStudioAsync(id);
            await LoadAsync();
        }
        catch
        {
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        try
        {
            _saveError = await Api.DeleteStudioAsync(id);
            if (_saveError is null)
            {
                CloseForm();
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            _saveError = $"Delete failed: {ex.Message}";
        }
    }

    public void Dispose()
    {
        StudioLive.Changed -= OnStudiosChanged;
    }
}
