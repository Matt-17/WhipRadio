@page "/moderators"
@page "/moderators/{HostSlug}"
@using WhipRadio.Core.Api
@using WhipRadio.Core.Entities
@using WhipRadio.Web.Components.Moderators
@using WhipRadio.Web.Services
@inject ModeratorsApiClient Api
@inject SettingsApiClient Settings
@inject NavigationManager Navigation

<PageTitle>WhipRadio — Hosts</PageTitle>

<h1 class="stage-title">The Hosts</h1>
<div class="stage-sub">synthetic personalities · real opinions about music</div>

@if (_moderators is null)
{
    <div class="panel reveal"><div class="empty-state"><span class="blink">▮</span> waking up the hosts...</div></div>
}
else
{
    <div class="host-layout reveal">
        <div class="panel host-list">
            <div class="host-list-head">
                <span class="panel-label">Roster</span>
                <button class="btn small primary" @onclick="OpenHire">+ Hire Host</button>
            </div>
            @if (_created is not null)
            {
                <div class="flash" style="margin-bottom:10px">✓ @_created joined the roster</div>
            }
            @if (_moderators.Count == 0)
            {
                <div class="empty-state">nobody on the roster yet</div>
            }
            @foreach (var moderator in RosterHosts)
            {
                <div class="host-row @(moderator.Id == _selectedId ? "selected" : null) @(moderator.IsActive ? null : "inactive")"
                     role="button"
                     tabindex="0"
                     title="select @moderator.Name"
                     @onclick="() => Select(moderator)"
                     @onkeydown="@(args => HostRowKeyDown(args, moderator))">
                    <PersonAvatar PhotoUrl="@moderator.PhotoUrl" Name="@moderator.Name" Size="thumb" />
                    <div>
                        <div class="host-row-name">@moderator.Name</div>
                        <div class="host-row-sub">@HostFormat.TalkLabel(moderator.Talkativeness) · @HostFormat.MoodSummary(moderator.CurrentTraits)</div>
                    </div>
                    <span class="status-dot @(moderator.IsActive ? "on" : null)" aria-hidden="true"
                          title="@(moderator.IsActive ? "on roster" : "off roster")"></span>
                </div>
            }
        </div>

        @if (Selected is not { } host)
        {
            <div class="panel host-detail"><div class="empty-state">select a host from the roster</div></div>
        }
        else
        {
            <HostDetailPanel Host="host"
                             FireDisabled="_firingHost"
                             FiringThisHost="@(_firingHost && _fireTarget?.Id == host.Id)"
                             OnFireRequested="OpenFireAsync"
                             OnHostUpdated="ReplaceHost"
                             OnRosterChanged="ReloadRosterAsync" />
        }
    </div>
}

<HireHostModal Visible="@_hireOpen"
               StationLanguage="@_stationLanguage"
               OnClose="CloseHire"
               OnHired="HostHiredAsync" />

<FireHostDialog Target="_fireTarget"
                Usage="_fireUsage"
                Error="_fireError"
                Working="_firingHost"
                OnConfirm="FireConfirmedAsync"
                OnCancel="CloseFireDialog" />

@code {
    [Parameter] public string? HostSlug { get; set; }

    private List<ModeratorDto>? _moderators;
    private int? _selectedId;

    private bool _hireOpen;
    private string _stationLanguage = "en";
    private string? _created;
    private ModeratorDto? _fireTarget;
    private ModeratorUsageDto? _fireUsage;
    private string? _fireError;
    private bool _firingHost;
    private bool _loaded;
    private string? _currentRouteHostSlug;

    private ModeratorDto? Selected => _moderators?.FirstOrDefault(m => m.Id == _selectedId);

    private IEnumerable<ModeratorDto> RosterHosts
        => (_moderators ?? [])
            .OrderBy(host => host.Name, StringComparer.OrdinalIgnoreCase)
            .ThenBy(host => host.Id);

    protected override async Task OnInitializedAsync()
    {
        _moderators = SortHosts(await Api.GetModeratorsAsync());
        _stationLanguage = (await Settings.GetSettingsAsync())?.DefaultLanguage ?? "en";
        _loaded = true;
        ApplyHostRoute(HostSlug);
    }

    protected override Task OnParametersSetAsync()
    {
        if (!_loaded || string.Equals(HostSlug, _currentRouteHostSlug, StringComparison.OrdinalIgnoreCase))
        {
            return Task.CompletedTask;
        }

        ApplyHostRoute(HostSlug);
        return Task.CompletedTask;
    }

    private static List<ModeratorDto> SortHosts(IEnumerable<ModeratorDto> hosts)
        => hosts
            .OrderBy(host => host.Name, StringComparer.OrdinalIgnoreCase)
            .ThenBy(host => host.Id)
            .ToList();

    private void Select(ModeratorDto host)
    {
        var target = $"/moderators/{host.Slug}";
        if (!UriEquals(target))
        {
            Navigation.NavigateTo(target);
            return;
        }

        ApplyHostRoute(host.Slug);
    }

    private void HostRowKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args, ModeratorDto host)
    {
        if (args.Key is "Enter" or " ")
        {
            Select(host);
        }
    }

    private void ApplyHostRoute(string? hostSlug)
    {
        _currentRouteHostSlug = hostSlug;
        var normalizedSlug = WhipRadio.Core.Slugs.SlugGenerator.Normalize(hostSlug);
        var host = string.IsNullOrWhiteSpace(hostSlug)
            ? null
            : _moderators?.FirstOrDefault(m => string.Equals(m.Slug, normalizedSlug, StringComparison.Ordinal));
        _selectedId = host?.Id ?? RosterHosts.FirstOrDefault()?.Id;
    }

    private bool UriEquals(string relativeUri)
        => string.Equals(
            Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/'),
            relativeUri.TrimStart('/').TrimEnd('/'),
            StringComparison.OrdinalIgnoreCase);

    private void OpenHire()
    {
        _created = null;
        _hireOpen = true;
    }

    private void CloseHire() => _hireOpen = false;

    private async Task HostHiredAsync(ModeratorDto created)
    {
        _created = created.Name;
        _hireOpen = false;
        _moderators = SortHosts(await Api.GetModeratorsAsync());
        Select(created);
    }

    private void ReplaceHost(ModeratorDto updated)
    {
        if (_moderators is null)
        {
            return;
        }

        var index = _moderators.FindIndex(m => m.Id == updated.Id);
        if (index >= 0)
        {
            _moderators[index] = updated;
        }
    }

    private async Task ReloadRosterAsync()
        => _moderators = SortHosts(await Api.GetModeratorsAsync());

    private async Task OpenFireAsync(ModeratorDto host)
    {
        _fireTarget = host;
        _fireUsage = null;
        _fireError = null;
        try
        {
            _fireUsage = await Api.GetModeratorUsageAsync(host.Id);
            if (_fireUsage is null)
            {
                _fireError = "Could not load host usage.";
            }
        }
        catch (Exception ex)
        {
            _fireError = $"Failed to load host usage: {ex.Message}";
        }
    }

    private void CloseFireDialog()
    {
        _fireTarget = null;
        _fireUsage = null;
        _fireError = null;
        _firingHost = false;
    }

    private async Task FireConfirmedAsync()
    {
        if (_fireTarget is not { } host)
        {
            return;
        }

        _firingHost = true;
        _fireError = null;
        try
        {
            var (result, error) = await Api.FireModeratorAsync(host.Id);
            if (result is null)
            {
                _fireError = string.IsNullOrWhiteSpace(error) ? "Could not fire host." : error;
                return;
            }

            _created = null;
            _moderators = SortHosts(await Api.GetModeratorsAsync());
            Select(result.Moderator);
            CloseFireDialog();
        }
        catch (Exception ex)
        {
            _fireError = $"Failed to fire host: {ex.Message}";
        }
        finally
        {
            _firingHost = false;
        }
    }
}
