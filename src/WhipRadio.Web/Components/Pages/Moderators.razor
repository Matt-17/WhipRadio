@page "/moderators"
@using WhipRadio.Core.Api
@using WhipRadio.Web.Services
@inject RadioApiClient Api
@inject PlayerState Player
@inject IJSRuntime Js

<PageTitle>WhipRadio — Hosts</PageTitle>

<h1 class="stage-title">The Hosts</h1>
<div class="stage-sub">synthetic personalities · real opinions about music</div>

<div class="panel reveal">
    <div class="panel-label">Create a Host</div>
    <div class="form-grid">
        <div class="field"><label>Name</label><input @bind="_newName" placeholder="e.g. Mia Morningwave" /></div>
        <div class="field">
            <label>Gender</label>
            <select @bind="_newGender"><option value="f">female</option><option value="m">male</option></select>
        </div>
        <div class="field">
            <label>Language</label>
            <input value="@_stationLanguage (station language)" disabled />
        </div>
        <div class="field">
            <label>TTS Engine</label>
            <select @bind="_newEngine">
                <option value="qwen">qwen (local, designed voice — recommended)</option>
                <option value="kokoro">kokoro (local, en)</option>
                <option value="piper">piper (local, de/en)</option>
                <option value="elevenlabs">elevenlabs (cloud, needs key)</option>
            </select>
        </div>
        <div class="field"><label>Style</label><input @bind="_newStyle" placeholder="fast-energetic / slow-thoughtful / …" /></div>
        <div class="field">
            <label>Talkativeness</label>
            <select @bind="_newTalkativeness">
                <option value="0.2">quiet — mostly music</option>
                <option value="0.5">balanced</option>
                <option value="0.8">talky — loves the mic</option>
            </select>
        </div>
        <div class="field"><label>Preferred Genres (csv)</label><input @bind="_newGenres" placeholder="electronic,lofi" /></div>
    </div>
    <div class="field" style="margin-bottom:16px">
        <label>Persona (how they talk, what they love)</label>
        <input @bind="_newPersona" placeholder="You are a warm late-night host who loves vinyl stories …" />
    </div>
    @if (_newEngine == "qwen")
    {
        <div class="field" style="margin-bottom:16px">
            <label>Voice description (Qwen designs the voice from this)</label>
            <input @bind="_newVoiceDescription"
                   placeholder="Deep, warm, slightly raspy late-night voice with a calm pace …" />
        </div>
        <div class="btn-row" style="margin-bottom:16px">
            <button class="btn" disabled="@_designing" @onclick="DesignNewVoiceAsync">
                @(_designing ? "designing… (first run downloads the model)" : "🎙 Design & preview voice")
            </button>
            @if (_newDesigned is not null)
            {
                <button class="btn small" @onclick="() => PlayPreview(string.IsNullOrWhiteSpace(_newName) ? "new voice" : _newName, _newDesigned)">▶ preview</button>
                <span class="flash">✓ voice @_newDesigned.Handle ready</span>
            }
            @if (_designError is not null)
            {
                <span class="dim">@_designError</span>
            }
        </div>
    }
    <div class="btn-row">
        <button class="btn primary" disabled="@(_newEngine == "qwen" && _newVoiceHandle is null)" @onclick="CreateAsync">Hire Host</button>
        @if (_newEngine == "qwen" && _newVoiceHandle is null)
        {
            <span class="dim">design the voice first</span>
        }
        @if (_created is not null)
        {
            <span class="flash">✓ @_created joined the roster</span>
        }
    </div>
</div>

@if (_moderators is null)
{
    <div class="panel reveal"><div class="empty-state"><span class="blink">▮</span> waking up the hosts…</div></div>
}
else
{
    <div class="mod-grid">
        @foreach (var moderator in _moderators)
        {
            <div class="panel mod-card reveal @(moderator.IsActive ? null : "inactive")">
                <div class="mod-name">@moderator.Name</div>
                <div class="mod-meta">
                    <span class="tag">@moderator.Language</span>
                    <span class="tag">@(moderator.Gender == "m" ? "male" : "female")</span>
                    <span class="tag amber">@moderator.TtsEngine</span>
                    <span class="tag">voice @moderator.VoiceId</span>
                    <span class="tag">@moderator.Style</span>
                    <span class="tag">@TalkLabel(moderator.Talkativeness)</span>
                    @if (moderator.IsAutoGenerated)
                    {
                        <span class="tag green">director's pick</span>
                    }
                </div>
                <div class="mod-persona">@moderator.PersonaPrompt</div>
                @if (_redesignFor == moderator.Id && _redesigned is not null)
                {
                    <div class="btn-row" style="margin-top:10px">
                        <button class="btn small" @onclick="() => PlayPreview(moderator.Name, _redesigned)">▶ preview new voice</button>
                        <button class="btn small primary" @onclick="() => ApplyRedesignAsync(moderator.Id)">apply</button>
                        <button class="btn small" @onclick="() => { _redesignFor = null; _redesigned = null; }">discard</button>
                    </div>
                }
                <footer>
                    <div class="btn-row">
                        <button class="btn small" @onclick="() => ToggleTalksAsync(moderator.Id)">
                            @(_talksFor == moderator.Id ? "hide talks" : "recent talks")
                        </button>
                        <button class="btn small" disabled="@_designing" title="mint a new Qwen voice from this host's persona"
                                @onclick="() => RedesignAsync(moderator.Id)">
                            @(_designing && _redesignFor == moderator.Id ? "designing…" : "🎙 redesign voice")
                        </button>
                        <span class="tag @(moderator.IsActive ? "green" : "red")">
                            @(moderator.IsActive ? "on roster" : "off roster")
                        </span>
                    </div>
                    <div class="switch @(moderator.IsActive ? "on" : null)"
                         title="Toggle active (the director will rearrange the schedule over time)"
                         @onclick="() => ToggleAsync(moderator.Id)"></div>
                </footer>
                @if (_talksFor == moderator.Id)
                {
                    <div style="margin-top:14px">
                        @if (_talks.Count == 0)
                        {
                            <div class="empty-state">no talks yet</div>
                        }
                        @foreach (var talk in _talks)
                        {
                            <div class="talk-row">
                                <button class="btn small" @onclick="() => PlayTalkAsync(talk.ItemId)">▶</button>
                                <span class="tag">@talk.Title</span>
                                <span class="dim">@talk.PlayedAt.ToLocalTime().ToString("dd.MM. HH:mm") · @FormatClock(TimeSpan.FromSeconds(talk.DurationSeconds))</span>
                            </div>
                            <div class="transcript small">@talk.Transcript</div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private List<ModeratorDto>? _moderators;
    private List<PlayLogEntryDto> _talks = [];
    private int? _talksFor;

    private string _newName = "";
    private string _newGender = "f";
    private string _stationLanguage = "en";
    private string _newEngine = "kokoro";
    private string _newStyle = "";
    private string _newGenres = "";
    private string _newTalkativeness = "0.5";
    private string _newPersona = "";
    private string? _created;
    private string _newVoiceDescription = "";
    private string? _newVoiceHandle;
    private DesignedVoiceDto? _newDesigned;
    private bool _designing;
    private string? _designError;
    private int? _redesignFor;
    private DesignedVoiceDto? _redesigned;

    protected override async Task OnInitializedAsync()
    {
        _moderators = await Api.GetModeratorsAsync();
        _stationLanguage = (await Api.GetSettingsAsync())?.DefaultLanguage ?? "de";
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName))
        {
            return;
        }

        var created = await Api.CreateModeratorAsync(new CreateModeratorDto(
            _newName, _stationLanguage, _newGender, _newEngine, _newStyle, _newPersona, null, _newGenres,
            double.TryParse(_newTalkativeness, System.Globalization.CultureInfo.InvariantCulture, out var talk) ? talk : 0.5));

        // Designed Qwen voices are applied explicitly after creation.
        if (created is not null && _newEngine == "qwen" && _newVoiceHandle is not null)
        {
            await Api.ApplyVoiceAsync(created.Id, new ApplyVoiceDto(_newVoiceHandle, _newVoiceDescription));
        }

        _created = created?.Name;
        _newName = "";
        _newVoiceHandle = null;
        _moderators = await Api.GetModeratorsAsync();
    }

    private async Task DesignNewVoiceAsync()
    {
        if (string.IsNullOrWhiteSpace(_newVoiceDescription))
        {
            _designError = "describe the voice first";
            return;
        }

        _designing = true;
        _designError = null;
        var (voice, error) = await Api.DesignVoiceAsync(
            new DesignVoiceDto(_newVoiceDescription, _newGender, _stationLanguage,
                string.IsNullOrWhiteSpace(_newName) ? null : _newName));
        _designing = false;
        _newVoiceHandle = voice?.Handle;
        _newDesigned = voice;
        _designError = error;
        if (voice is not null)
        {
            PlayPreview(string.IsNullOrWhiteSpace(_newName) ? "new voice" : _newName, voice);
        }
    }

    private async Task RedesignAsync(int moderatorId)
    {
        _designing = true;
        _redesignFor = moderatorId;
        _redesigned = null;
        var (voice, error) = await Api.RedesignVoiceAsync(moderatorId);
        _designing = false;
        _redesigned = voice;
        _designError = error;
        if (voice is not null)
        {
            var name = _moderators?.FirstOrDefault(m => m.Id == moderatorId)?.Name ?? "host";
            PlayPreview(name, voice);
        }
    }

    private async Task ApplyRedesignAsync(int moderatorId)
    {
        if (_redesigned is null)
        {
            return;
        }

        await Api.ApplyVoiceAsync(moderatorId, new ApplyVoiceDto(_redesigned.Handle, _redesigned.Description));
        _redesignFor = null;
        _redesigned = null;
        _moderators = await Api.GetModeratorsAsync();
    }

    /// <summary>Voice previews play in the footer player like song previews.</summary>
    private void PlayPreview(string name, DesignedVoiceDto voice)
        => Player.PlayVoice($"{name} — designed voice", Api.VoicePreviewUrl(voice.Handle), voice.DurationSeconds);

    private async Task ToggleAsync(int id)
    {
        await Api.ToggleModeratorAsync(id);
        _moderators = await Api.GetModeratorsAsync();
    }

    private async Task ToggleTalksAsync(int id)
    {
        if (_talksFor == id)
        {
            _talksFor = null;
            return;
        }

        _talksFor = id;
        _talks = await Api.GetModeratorTalksAsync(id);
    }

    private async Task PlayTalkAsync(Guid id)
        => await Js.InvokeVoidAsync("whipRadio.playClip", Api.AnnouncementAudioUrl(id));

    private static string TalkLabel(double talkativeness) => talkativeness switch
    {
        < 0.35 => "quiet",
        > 0.65 => "talky",
        _ => "balanced",
    };
}
