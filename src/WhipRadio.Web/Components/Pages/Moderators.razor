@page "/moderators"
@using WhipRadio.Core.Api
@using WhipRadio.Web.Services
@inject RadioApiClient Api
@inject PlayerState Player
@inject IJSRuntime Js

<PageTitle>WhipRadio — Hosts</PageTitle>

<h1 class="stage-title">The Hosts</h1>
<div class="stage-sub">synthetic personalities · real opinions about music</div>

@if (_moderators is null)
{
    <div class="panel reveal"><div class="empty-state"><span class="blink">▮</span> waking up the hosts…</div></div>
}
else
{
    <div class="host-layout reveal">
        <div class="panel host-list">
            <div class="host-list-head">
                <span class="panel-label">Roster</span>
                <button class="btn small primary" @onclick="OpenHire">+ Hire Host</button>
            </div>
            @if (_created is not null)
            {
                <div class="flash" style="margin-bottom:10px">✓ @_created joined the roster</div>
            }
            @if (_moderators.Count == 0)
            {
                <div class="empty-state">nobody on the roster yet</div>
            }
            @foreach (var moderator in RosterHosts)
            {
                <div class="host-row @(moderator.Id == _selectedId ? "selected" : null) @(moderator.IsActive ? null : "inactive")"
                     @onclick="() => Select(moderator.Id)">
                    <div class="host-photo thumb @(HasPhoto(moderator) ? null : "skeleton")">
                        @if (HasPhoto(moderator))
                        {
                            <img src="@moderator.PhotoUrl" alt="@moderator.Name" />
                        }
                    </div>
                    <div>
                        <div class="host-row-name">@moderator.Name</div>
                        <div class="host-row-sub">@TalkLabel(moderator.Talkativeness) · @MoodSummary(moderator.CurrentTraits)</div>
                    </div>
                    <span class="status-dot @(moderator.IsActive ? "on" : null)"
                          title="@(moderator.IsActive ? "on roster" : "off roster")"></span>
                </div>
            }
        </div>

        @if (Selected is not { } host)
        {
            <div class="panel host-detail"><div class="empty-state">select a host from the roster</div></div>
        }
        else
        {
            <div class="panel host-detail @(host.IsActive ? null : "inactive")">
                <div class="host-detail-head">
                    <div class="host-photo-col">
                        <div class="host-photo portrait @(HasPhoto(host) ? null : "skeleton")">
                            @if (HasPhoto(host))
                            {
                                <img src="@host.PhotoUrl" alt="@host.Name" />
                            }
                        </div>
                        <div class="host-photo-edit">
                            <input @bind="_photoUrlEdit" placeholder="photo url…" />
                            <button class="btn small" title="set photo" @onclick="() => SetPhotoAsync(host.Id)">set</button>
                        </div>
                    </div>
                    <div class="host-detail-info">
                        <div class="mod-name">@host.Name</div>
                        <div class="mod-meta">
                            <span class="tag">@host.Language</span>
                            <span class="tag">@(host.Gender == "m" ? "male" : "female")</span>
                            @if (!string.IsNullOrWhiteSpace(host.Style))
                            {
                                <span class="tag">@host.Style</span>
                            }
                            <span class="tag">@TalkLabel(host.Talkativeness)</span>
                            @if (!string.IsNullOrWhiteSpace(host.PreferredGenres))
                            {
                                <span class="tag">@host.PreferredGenres</span>
                            }
                            @if (host.IsAutoGenerated)
                            {
                                <span class="tag green">director's pick</span>
                            }
                            @if (host.IsNewsSpecialist)
                            {
                                <span class="tag amber">news</span>
                            }
                            @if (host.IsWeatherSpecialist)
                            {
                                <span class="tag amber">weather</span>
                            }
                            <span class="tag @(host.IsActive ? "green" : "red")">
                                @(host.IsActive ? "on roster" : "off roster")
                            </span>
                        </div>
                        <div class="mod-persona">@host.PersonaPrompt</div>
                        @if (host.BaselineTraits is not null && host.CurrentTraits is not null)
                        {
                            <div class="trait-board">
                                <div class="trait-row stable">
                                    <span class="trait-label">baseline</span>
                                    <span class="trait-chip"><b>energy</b>@TraitLabel(host.BaselineTraits.Energy)</span>
                                    <span class="trait-chip"><b>formality</b>@TraitLabel(host.BaselineTraits.Formality)</span>
                                    <span class="trait-chip"><b>humor</b>@TraitLabel(host.BaselineTraits.HumorLevel)</span>
                                    <span class="trait-chip"><b>talk</b>@TraitLabel(host.BaselineTraits.Talkativeness)</span>
                                    <span class="trait-chip"><b>warmth</b>@TraitLabel(host.BaselineTraits.Warmth)</span>
                                </div>
                                <div class="trait-row variable">
                                    <span class="trait-label">current</span>
                                    <span class="trait-chip"><b>energy</b>@TraitLabel(host.CurrentTraits.Energy)</span>
                                    <span class="trait-chip"><b>formality</b>@TraitLabel(host.CurrentTraits.Formality)</span>
                                    <span class="trait-chip"><b>humor</b>@TraitLabel(host.CurrentTraits.HumorLevel)</span>
                                    <span class="trait-chip"><b>talk</b>@TraitLabel(host.CurrentTraits.Talkativeness)</span>
                                    <span class="trait-chip"><b>warmth</b>@TraitLabel(host.CurrentTraits.Warmth)</span>
                                </div>
                            </div>
                        }
                        @if (host.TalkProfile is not null)
                        {
                            <div class="trait-row stable talk-profile-row">
                                <span class="trait-label">profile</span>
                                <span class="trait-chip"><b>break</b>@BreakFrequencyLabel(host.TalkProfile.BreakFrequencyTracks)</span>
                                <span class="trait-chip"><b>parts</b>@host.TalkProfile.MinPartsPerBreak-@host.TalkProfile.MaxPartsPerBreak</span>
                                <span class="trait-chip"><b>replay</b>@host.TalkProfile.ExactReplayTolerance</span>
                                <span class="trait-chip"><b>evergreen</b>@host.TalkProfile.EvergreenBitTolerance.ToString("0.##")</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(host.VoiceId) && _redesignFor == host.Id && _redesigned is not null)
                        {
                            <div class="btn-row" style="margin-top:12px">
                                <button class="btn small" @onclick="() => PlayPreview(host.Name, _redesigned)">▶ preview new voice</button>
                                <button class="btn small primary" @onclick="() => ApplyRedesignAsync(host.Id)">apply</button>
                                <button class="btn small" @onclick="() => { _redesignFor = null; _redesigned = null; }">discard</button>
                            </div>
                        }
                    </div>
                </div>
                <footer>
                    <div class="btn-row">
                        <button class="btn small" @onclick="() => ToggleTalksAsync(host.Id)">
                            @(_talksFor == host.Id ? "hide talks" : "recent talks")
                        </button>
                        <button class="btn small" disabled="@_designing" title="mint a new voice from this host's persona"
                                @onclick="() => RedesignAsync(host.Id)">
                            @(_designing && _redesignFor == host.Id ? "designing..." : "redesign voice")
                        </button>
                    </div>
                    <button class="btn small danger host-fire-action" disabled="@_firingHost" title="remove this host from active use"
                            @onclick="() => OpenFireAsync(host)">
                        @(_firingHost && _fireTarget?.Id == host.Id ? "firing..." : "Fire")
                    </button>
                </footer>
                @if (_talksFor == host.Id)
                {
                    <div style="margin-top:14px">
                        @if (_talks.Count == 0)
                        {
                            <div class="empty-state">no talks yet</div>
                        }
                        @foreach (var talk in _talks)
                        {
                            <div class="talk-row">
                                <button class="btn small" @onclick="() => PlayTalkAsync(talk.ItemId)">▶</button>
                                <span class="tag">@talk.Title</span>
                                <span class="dim">@talk.PlayedAt.ToLocalTime().ToString("dd.MM. HH:mm") · @FormatClock(TimeSpan.FromSeconds(talk.DurationSeconds))</span>
                            </div>
                            <div class="transcript small">@talk.Transcript</div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

<Modal Visible="@_hireOpen" Title="Hire a Host" Class="modal-wide" OnClose="CloseHire">
    <ChildContent>
        <div class="form-grid">
            <div class="field"><label>Name</label><input @bind="_newName" placeholder="e.g. Mia Morningwave" /></div>
            <div class="field">
                <label>Gender</label>
                <select @bind="_newGender"><option value="f">female</option><option value="m">male</option></select>
            </div>
            <div class="field">
                <label>Language</label>
                <input value="@_stationLanguage (station language)" disabled />
            </div>
            <div class="field" hidden>
                <label>TTS Engine</label>
                <select @bind="_newEngine">
                    <option value="qwen">qwen (local, designed voice — recommended)</option>
                    <option value="kokoro">kokoro (local, en)</option>
                    <option value="piper">piper (local fallback)</option>
                    <option value="elevenlabs">elevenlabs (cloud, needs key)</option>
                </select>
            </div>
            <div class="field"><label>Style</label><input @bind="_newStyle" placeholder="fast-energetic / slow-thoughtful / …" /></div>
            <div class="field">
                <label>Weather specialist</label>
                <select @bind="_newWeatherSpecialist">
                    <option value="false">no</option>
                    <option value="true">yes</option>
                </select>
            </div>
            <div class="field">
                <label>Talkativeness</label>
                <select @bind="_newTalkativeness">
                    <option value="0.2">quiet — mostly music</option>
                    <option value="0.5">balanced</option>
                    <option value="0.8">talky — loves the mic</option>
                </select>
            </div>
            <div class="field">
                <label>Energy</label>
                <select @bind="_newEnergy">
                    @foreach (var level in TraitLevels)
                    {
                        <option value="@level">@TraitLabel(level)</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Formality</label>
                <select @bind="_newFormality">
                    <option value="VeryCasual">very casual</option>
                    <option value="Casual">casual</option>
                    <option value="Balanced">balanced</option>
                    <option value="Formal">formal</option>
                    <option value="VeryFormal">very formal</option>
                </select>
            </div>
            <div class="field">
                <label>Humor</label>
                <select @bind="_newHumorLevel">
                    @foreach (var level in TraitLevels)
                    {
                        <option value="@level">@TraitLabel(level)</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Warmth</label>
                <select @bind="_newWarmth">
                    @foreach (var level in TraitLevels)
                    {
                        <option value="@level">@TraitLabel(level)</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Break Frequency</label>
                <select @bind="_newBreakFrequency">
                    <option value="0">music only</option>
                    <option value="1">every track</option>
                    <option value="2">every second track</option>
                    <option value="3">every third track</option>
                </select>
            </div>
            <div class="field">
                <label>Parts Per Break</label>
                <select @bind="_newMaxPartsPerBreak">
                    <option value="1">one part</option>
                    <option value="2">up to two parts</option>
                    <option value="3">up to three parts</option>
                </select>
            </div>
            <div class="field"><label>Preferred Genres (csv)</label><input @bind="_newGenres" placeholder="electronic,lofi" /></div>
            <div class="field"><label>Photo URL (optional)</label><input @bind="_newPhotoUrl" placeholder="https://… or /images/host.jpg" /></div>
        </div>
        <div class="field" style="margin-bottom:16px">
            <label>Persona (how they talk, what they love)</label>
            <input @bind="_newPersona" placeholder="You are a warm late-night host who loves vinyl stories …" />
        </div>
        @if (false && _newEngine == "qwen")
        {
            <div class="field" style="margin-bottom:16px">
                <label>Voice description (Qwen designs the voice from this)</label>
                <input @bind="_newVoiceDescription"
                       placeholder="Deep, warm, slightly raspy late-night voice with a calm pace …" />
            </div>
            <div class="btn-row">
                <button class="btn" disabled="@_designing" @onclick="DesignNewVoiceAsync">
                    @(_designing ? "designing… (first run downloads the model)" : "🎙 Design & preview voice")
                </button>
                @if (_newDesigned is not null)
                {
                    <button class="btn small" @onclick="PlayNewPreview">▶ preview</button>
                    <span class="flash">✓ voice @_newDesigned.Handle ready</span>
                }
                @if (_designError is not null)
                {
                    <span class="dim">@_designError</span>
                }
            </div>
        }
        @if (_designError is not null)
        {
            <div class="production-warning">@_designError</div>
        }
    </ChildContent>
    <Footer>
        @if (false && _newEngine == "qwen" && _newVoiceHandle is null)
        {
            <span class="dim">design the voice first</span>
        }
        <button class="btn primary" disabled="@_creatingHost" @onclick="CreateAsync">@(_creatingHost ? "hiring..." : "Hire Host")</button>
    </Footer>
</Modal>

<ConfirmDialog Visible="@(_fireTarget is not null)"
               Title="Fire host"
               ConfirmText="Fire"
               CancelText="Keep"
               Danger="true"
               OnConfirm="FireConfirmedAsync"
               OnCancel="CloseFireDialog">
    @if (_fireTarget is { } hostToFire)
    {
        <p>Fire <strong>@hostToFire.Name</strong>?</p>
        <p class="dim">This turns the host off and removes future assignments. Existing aired audio and logs stay in history.</p>
        @if (_fireUsage is null)
        {
            <div class="empty-state">checking usage...</div>
        }
        else
        {
            var clearedItems = FireClearedItems(_fireUsage);
            <div class="host-fire-impact">
                <div class="host-fire-impact-title">Firing this host will clear:</div>
                @if (clearedItems.Count == 0)
                {
                    <div class="host-fire-empty">No active assignments.</div>
                }
                else
                {
                    <ul class="host-fire-list">
                        @foreach (var item in clearedItems)
                        {
                            <li>@item</li>
                        }
                    </ul>
                }
                <div class="host-fire-history">@FireHistoryText(_fireUsage)</div>
            </div>
        }
        @if (_fireError is not null)
        {
            <div class="production-warning">@_fireError</div>
        }
    }
</ConfirmDialog>

@code {
    private List<ModeratorDto>? _moderators;
    private List<PlayLogEntryDto> _talks = [];
    private int? _talksFor;
    private int? _selectedId;
    private string _photoUrlEdit = "";

    private bool _hireOpen;
    private string _newName = "";
    private string _newGender = "f";
    private string _stationLanguage = "en";
    private string _newEngine = "kokoro";
    private string _newStyle = "";
    private string _newGenres = "";
    private string _newTalkativeness = "0.5";
    private string _newWeatherSpecialist = "false";
    private string _newEnergy = "Medium";
    private string _newFormality = "Balanced";
    private string _newHumorLevel = "Medium";
    private string _newWarmth = "Medium";
    private string _newBreakFrequency = "1";
    private string _newMaxPartsPerBreak = "3";
    private string _newPersona = "";
    private string _newPhotoUrl = "";
    private string? _created;
    private string _newVoiceDescription = "";
    private string? _newVoiceHandle;
    private DesignedVoiceDto? _newDesigned;
    private bool _designing;
    private bool _creatingHost;
    private string? _designError;
    private int? _redesignFor;
    private DesignedVoiceDto? _redesigned;
    private ModeratorDto? _fireTarget;
    private ModeratorUsageDto? _fireUsage;
    private string? _fireError;
    private bool _firingHost;

    private ModeratorDto? Selected => _moderators?.FirstOrDefault(m => m.Id == _selectedId);

    private IEnumerable<ModeratorDto> RosterHosts
        => (_moderators ?? [])
            .OrderBy(host => host.Name, StringComparer.OrdinalIgnoreCase)
            .ThenBy(host => host.Id);

    protected override async Task OnInitializedAsync()
    {
        _moderators = SortHosts(await Api.GetModeratorsAsync());
        _selectedId = RosterHosts.FirstOrDefault()?.Id;
        _photoUrlEdit = Selected?.PhotoUrl ?? "";
        _stationLanguage = (await Api.GetSettingsAsync())?.DefaultLanguage ?? "en";
    }

    private static bool HasPhoto(ModeratorDto m) => !string.IsNullOrWhiteSpace(m.PhotoUrl);

    private static List<ModeratorDto> SortHosts(IEnumerable<ModeratorDto> hosts)
        => hosts
            .OrderBy(host => host.Name, StringComparer.OrdinalIgnoreCase)
            .ThenBy(host => host.Id)
            .ToList();

    private void Select(int id)
    {
        _selectedId = id;
        _photoUrlEdit = Selected?.PhotoUrl ?? "";
        _talksFor = null;
        _redesignFor = null;
        _redesigned = null;
    }

    private void OpenHire()
    {
        _created = null;
        _hireOpen = true;
    }

    private void CloseHire()
    {
        _hireOpen = false;
        _designError = null;
        _creatingHost = false;
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName))
        {
            return;
        }

        _creatingHost = true;
        _designError = null;
        var (created, error) = await Api.CreateModeratorAsync(new CreateModeratorDto(
            Name: _newName,
            Language: _stationLanguage,
            Gender: _newGender,
            TtsEngine: "qwen",
            Style: _newStyle,
            PersonaPrompt: _newPersona,
            PrefersVocals: null,
            PreferredGenres: _newGenres,
            Talkativeness: double.TryParse(_newTalkativeness, System.Globalization.CultureInfo.InvariantCulture, out var talk) ? talk : 0.5,
            IsWeatherSpecialist: _newWeatherSpecialist == "true",
            PhotoUrl: string.IsNullOrWhiteSpace(_newPhotoUrl) ? null : _newPhotoUrl,
            BaselineTraits: NewBaselineTraits(),
            TalkProfile: NewTalkProfile(),
            IsNewsSpecialist: false,
            VoiceDescription: BuildNewVoiceDescription()));
        _creatingHost = false;

        if (created is null)
        {
            _designError = string.IsNullOrWhiteSpace(error) ? "host creation failed" : error;
            return;
        }

        _created = created.Name;
        _newName = "";
        _newPersona = "";
        _newPhotoUrl = "";
        _newWeatherSpecialist = "false";
        _newVoiceHandle = null;
        _newDesigned = null;
        _hireOpen = false;
        _moderators = SortHosts(await Api.GetModeratorsAsync());
        Select(created.Id);
    }

    private async Task SetPhotoAsync(int moderatorId)
    {
        var updated = await Api.SetModeratorPhotoAsync(
            moderatorId, string.IsNullOrWhiteSpace(_photoUrlEdit) ? null : _photoUrlEdit);
        if (updated is not null && _moderators is not null)
        {
            var index = _moderators.FindIndex(m => m.Id == moderatorId);
            if (index >= 0)
            {
                _moderators[index] = updated;
            }
        }
    }

    private async Task DesignNewVoiceAsync()
    {
        if (string.IsNullOrWhiteSpace(_newVoiceDescription))
        {
            _designError = "describe the voice first";
            return;
        }

        _designing = true;
        _designError = null;
        var (voice, error) = await Api.DesignVoiceAsync(
            new DesignVoiceDto(_newVoiceDescription, _newGender, _stationLanguage,
                string.IsNullOrWhiteSpace(_newName) ? null : _newName));
        _designing = false;
        _newVoiceHandle = voice?.Handle;
        _newDesigned = voice;
        _designError = error;
        if (voice is not null)
        {
            PlayPreview(string.IsNullOrWhiteSpace(_newName) ? "new voice" : _newName, voice);
        }
    }

    private async Task RedesignAsync(int moderatorId)
    {
        _designing = true;
        _redesignFor = moderatorId;
        _redesigned = null;
        var (voice, error) = await Api.RedesignVoiceAsync(moderatorId);
        _designing = false;
        _redesigned = voice;
        _designError = error;
        if (voice is not null)
        {
            var name = _moderators?.FirstOrDefault(m => m.Id == moderatorId)?.Name ?? "host";
            PlayPreview(name, voice);
        }
    }

    private async Task ApplyRedesignAsync(int moderatorId)
    {
        if (_redesigned is null)
        {
            return;
        }

        await Api.ApplyVoiceAsync(moderatorId, new ApplyVoiceDto(_redesigned.Handle, _redesigned.Description));
        _redesignFor = null;
        _redesigned = null;
        _moderators = SortHosts(await Api.GetModeratorsAsync());
    }

    private async Task OpenFireAsync(ModeratorDto host)
    {
        _fireTarget = host;
        _fireUsage = null;
        _fireError = null;
        _fireUsage = await Api.GetModeratorUsageAsync(host.Id);
        if (_fireUsage is null)
        {
            _fireError = "Could not load host usage.";
        }
    }

    private void CloseFireDialog()
    {
        _fireTarget = null;
        _fireUsage = null;
        _fireError = null;
        _firingHost = false;
    }

    private async Task FireConfirmedAsync()
    {
        if (_fireTarget is not { } host)
        {
            return;
        }

        _firingHost = true;
        _fireError = null;
        var (result, error) = await Api.FireModeratorAsync(host.Id);
        _firingHost = false;
        if (result is null)
        {
            _fireError = string.IsNullOrWhiteSpace(error) ? "Could not fire host." : error;
            return;
        }

        _created = null;
        _talksFor = null;
        _redesignFor = null;
        _redesigned = null;
        _moderators = SortHosts(await Api.GetModeratorsAsync());
        Select(result.Moderator.Id);
        CloseFireDialog();
    }

    /// <summary>Voice previews play in the footer player like song previews.</summary>
    private void PlayPreview(string name, DesignedVoiceDto voice)
        => Player.PlayVoice($"{name} — designed voice", Api.VoicePreviewUrl(voice.Handle), voice.DurationSeconds);

    private void PlayNewPreview()
    {
        if (_newDesigned is not null)
        {
            PlayPreview(string.IsNullOrWhiteSpace(_newName) ? "new voice" : _newName, _newDesigned);
        }
    }

    private async Task ToggleTalksAsync(int id)
    {
        if (_talksFor == id)
        {
            _talksFor = null;
            return;
        }

        _talksFor = id;
        _talks = await Api.GetModeratorTalksAsync(id);
    }

    private async Task PlayTalkAsync(Guid id)
        => await Js.InvokeVoidAsync("whipRadio.playClip", Api.AnnouncementAudioUrl(id));

    private static string TalkLabel(double talkativeness) => talkativeness switch
    {
        < 0.35 => "quiet",
        > 0.65 => "talky",
        _ => "balanced",
    };

    private static readonly string[] TraitLevels = ["VeryLow", "Low", "Medium", "High", "VeryHigh"];

    private ModeratorTraitsDto NewBaselineTraits()
        => new(_newEnergy, _newFormality, _newHumorLevel, TalkTraitFromScore(_newTalkativeness), _newWarmth);

    private HostTalkProfileDto NewTalkProfile()
        => new(
            BreakFrequencyTracks: int.TryParse(_newBreakFrequency, out var frequency) ? frequency : 1,
            MinPartsPerBreak: 1,
            MaxPartsPerBreak: int.TryParse(_newMaxPartsPerBreak, out var maxParts) ? maxParts : 3);

    private string BuildNewVoiceDescription()
    {
        var gender = _newGender == "m" ? "male" : "female";
        var style = string.IsNullOrWhiteSpace(_newStyle) ? "balanced radio host" : _newStyle.Trim();
        var persona = string.IsNullOrWhiteSpace(_newPersona) ? "warm WhipRadio host" : _newPersona.Trim();
        return $"A {gender} radio host voice with {style} delivery. {persona}";
    }

    private static string TalkTraitFromScore(string score)
    {
        var talkativeness = double.TryParse(score, System.Globalization.CultureInfo.InvariantCulture, out var parsed)
            ? Math.Clamp(parsed, 0, 1)
            : 0.5;
        return talkativeness switch
        {
            < 0.2 => "VeryLow",
            < 0.4 => "Low",
            > 0.8 => "VeryHigh",
            > 0.6 => "High",
            _ => "Medium",
        };
    }

    private static string MoodSummary(ModeratorTraitsDto? traits)
        => traits is null ? "mood pending" : $"{TraitLabel(traits.Energy)} energy";

    private static string BreakFrequencyLabel(int frequency)
        => frequency <= 0 ? "music only" : frequency == 1 ? "every track" : $"every {frequency}";

    private static string TraitLabel(string value)
        => value switch
        {
            "VeryLow" => "very low",
            "VeryHigh" => "very high",
            "VeryCasual" => "very casual",
            "VeryFormal" => "very formal",
            _ => value.ToLowerInvariant(),
        };

    private static IReadOnlyList<string> FireClearedItems(ModeratorUsageDto usage)
    {
        var items = new List<string>();
        if (usage.IsNewsPresenter)
        {
            items.Add("News presenter assignment");
        }

        if (usage.IsWeatherSpecialist)
        {
            items.Add("Weather specialist assignment");
        }

        AddCount(items, usage.AssignedFormatCount, "show format assignment");
        AddCount(items, usage.ActiveTalkBitCount, "active reusable talk bit");
        AddCount(items, usage.PendingTalkBreakCount, "pending talk");
        AddCount(items, usage.AssignedListenerMessageCount, "assigned listener message");
        return items;
    }

    private static void AddCount(List<string> items, int count, string singular)
    {
        if (count > 0)
        {
            items.Add($"{count} {singular}{(count == 1 ? "" : "s")}");
        }
    }

    private static string FireHistoryText(ModeratorUsageDto usage)
        => $"History kept: {CountText(usage.HistoricalAnnouncementCount, "archived talk")}, "
            + $"{CountText(usage.HistoricalPlayCount, "logged play")}.";

    private static string CountText(int count, string singular)
        => $"{count} {singular}{(count == 1 ? "" : "s")}";
}
