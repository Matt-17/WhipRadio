@page "/moderators"
@using WhipRadio.Core.Api
@using WhipRadio.Web.Services
@inject RadioApiClient Api
@inject IJSRuntime Js

<PageTitle>WhipRadio — Hosts</PageTitle>

<h1 class="stage-title">The Hosts</h1>
<div class="stage-sub">synthetic personalities · real opinions about music</div>

<div class="panel reveal">
    <div class="panel-label">Create a Host</div>
    <div class="form-grid">
        <div class="field"><label>Name</label><input @bind="_newName" placeholder="e.g. Mia Morningwave" /></div>
        <div class="field">
            <label>Gender</label>
            <select @bind="_newGender"><option value="f">female</option><option value="m">male</option></select>
        </div>
        <div class="field">
            <label>Language</label>
            <input value="@_stationLanguage (station language)" disabled />
        </div>
        <div class="field">
            <label>TTS Engine</label>
            <select @bind="_newEngine">
                <option value="kokoro">kokoro (local, en)</option>
                <option value="piper">piper (local, de/en)</option>
                <option value="elevenlabs">elevenlabs (cloud, needs key)</option>
            </select>
        </div>
        <div class="field"><label>Style</label><input @bind="_newStyle" placeholder="fast-energetic / slow-thoughtful / …" /></div>
        <div class="field"><label>Preferred Genres (csv)</label><input @bind="_newGenres" placeholder="electronic,lofi" /></div>
    </div>
    <div class="field" style="margin-bottom:16px">
        <label>Persona (how they talk, what they love)</label>
        <input @bind="_newPersona" placeholder="You are a warm late-night host who loves vinyl stories …" />
    </div>
    <div class="btn-row">
        <button class="btn primary" @onclick="CreateAsync">Hire Host</button>
        @if (_created is not null)
        {
            <span class="flash">✓ @_created joined the roster (voice assigned by gender & engine)</span>
        }
    </div>
</div>

@if (_moderators is null)
{
    <div class="panel reveal"><div class="empty-state"><span class="blink">▮</span> waking up the hosts…</div></div>
}
else
{
    <div class="mod-grid">
        @foreach (var moderator in _moderators)
        {
            <div class="panel mod-card reveal @(moderator.IsActive ? null : "inactive")">
                <div class="mod-name">@moderator.Name</div>
                <div class="mod-meta">
                    <span class="tag">@moderator.Language</span>
                    <span class="tag">@(moderator.Gender == "m" ? "male" : "female")</span>
                    <span class="tag amber">@moderator.TtsEngine</span>
                    <span class="tag">voice @moderator.VoiceId</span>
                    <span class="tag">@moderator.Style</span>
                    @if (moderator.IsAutoGenerated)
                    {
                        <span class="tag green">director's pick</span>
                    }
                </div>
                <div class="mod-persona">@moderator.PersonaPrompt</div>
                <footer>
                    <div class="btn-row">
                        <button class="btn small" @onclick="() => ToggleTalksAsync(moderator.Id)">
                            @(_talksFor == moderator.Id ? "hide talks" : "recent talks")
                        </button>
                        <span class="tag @(moderator.IsActive ? "green" : "red")">
                            @(moderator.IsActive ? "on roster" : "off roster")
                        </span>
                    </div>
                    <div class="switch @(moderator.IsActive ? "on" : null)"
                         title="Toggle active (the director will rearrange the schedule over time)"
                         @onclick="() => ToggleAsync(moderator.Id)"></div>
                </footer>
                @if (_talksFor == moderator.Id)
                {
                    <div style="margin-top:14px">
                        @if (_talks.Count == 0)
                        {
                            <div class="empty-state">no talks yet</div>
                        }
                        @foreach (var talk in _talks)
                        {
                            <div class="talk-row">
                                <button class="btn small" @onclick="() => PlayTalkAsync(talk.ItemId)">▶</button>
                                <span class="tag">@talk.Title</span>
                                <span class="dim">@talk.PlayedAt.ToLocalTime().ToString("dd.MM. HH:mm") · @FormatClock(TimeSpan.FromSeconds(talk.DurationSeconds))</span>
                            </div>
                            <div class="transcript small">@talk.Transcript</div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private List<ModeratorDto>? _moderators;
    private List<PlayLogEntryDto> _talks = [];
    private int? _talksFor;

    private string _newName = "";
    private string _newGender = "f";
    private string _stationLanguage = "en";
    private string _newEngine = "kokoro";
    private string _newStyle = "";
    private string _newGenres = "";
    private string _newPersona = "";
    private string? _created;

    protected override async Task OnInitializedAsync()
    {
        _moderators = await Api.GetModeratorsAsync();
        _stationLanguage = (await Api.GetSettingsAsync())?.DefaultLanguage ?? "de";
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName))
        {
            return;
        }

        var created = await Api.CreateModeratorAsync(new CreateModeratorDto(
            _newName, _stationLanguage, _newGender, _newEngine, _newStyle, _newPersona, null, _newGenres));
        _created = created?.Name;
        _newName = "";
        _moderators = await Api.GetModeratorsAsync();
    }

    private async Task ToggleAsync(int id)
    {
        await Api.ToggleModeratorAsync(id);
        _moderators = await Api.GetModeratorsAsync();
    }

    private async Task ToggleTalksAsync(int id)
    {
        if (_talksFor == id)
        {
            _talksFor = null;
            return;
        }

        _talksFor = id;
        _talks = await Api.GetModeratorTalksAsync(id);
    }

    private async Task PlayTalkAsync(Guid id)
        => await Js.InvokeVoidAsync("whipRadio.playClip", Api.AnnouncementAudioUrl(id));
}
