@page "/schedule"
@using WhipRadio.Core.Api
@using System.Globalization
@using WhipRadio.Web.Services
@implements IDisposable
@inject RadioApiClient Api
@inject RadioLiveClient Live

<PageTitle>WhipRadio - Schedule</PageTitle>

<h1 class="stage-title">Weekly Program</h1>
<div class="stage-sub">planned by the AI program director - spots fill in over time</div>

<div class="panel reveal">
    @if (_loadError is not null)
    {
        <div class="empty-state text-danger">@_loadError</div>
    }
    else if (_slots is null)
    {
        <div class="empty-state"><span class="blink">▮</span> reading the program board...</div>
    }
    else
    {
        <div class="schedule-scroll">
            <div class="schedule-grid">
                <div class="schedule-corner"></div>
                @foreach (var day in _dayOrder)
                {
                    <div class="schedule-day" style="@DayHeaderStyle(day)">@DayName(day)</div>
                }

                @for (var hour = 0; hour < 24; hour++)
                {
                    <div class="schedule-hour" style="@HourStyle(hour)">@($"{hour:00}:00")</div>
                }

                <div class="schedule-now-line"
                     style="@NowLineStyle()"
                     aria-hidden="true"></div>

                @foreach (var day in _dayOrder)
                {
                    @foreach (var block in BlocksForDay(day))
                    {
                        <div class="@BlockClass(block)"
                             style="@BlockStyle(block)"
                             title="@BlockTitle(block)">
                            @if (block.IsPlanned && block.Slot is { } slot)
                            {
                                <a class="cell-format schedule-link" href="formats">@(slot.FormatName ?? "in planning")</a>
                                @if (slot.IsNewsShow)
                                {
                                    <span class="tag green">news</span>
                                }
                                @if (string.IsNullOrWhiteSpace(slot.ModeratorName))
                                {
                                    <div class="cell-host">no host</div>
                                }
                                else
                                {
                                    <a class="cell-host schedule-link" href="moderators">@slot.ModeratorName</a>
                                }
                                <div class="cell-time">@FormatRange(block.StartMinute, block.EndMinute)</div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private List<ProgramSlotDto>? _slots;
    private int[] _dayOrder = [1, 2, 3, 4, 5, 6, 0];
    private System.Threading.Timer? _clockTimer;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        Live.ScheduleChanged += OnScheduleChanged;
        await Live.EnsureStartedAsync();

        var settings = await Api.GetSettingsAsync();
        _dayOrder = settings?.FirstDayOfWeek == 0
            ? [0, 1, 2, 3, 4, 5, 6]
            : [1, 2, 3, 4, 5, 6, 0];
        await LoadScheduleAsync();

        _clockTimer = new System.Threading.Timer(
            _ => _ = InvokeAsync(StateHasChanged),
            null,
            TimeSpan.FromSeconds(15),
            TimeSpan.FromSeconds(15));
    }

    public void Dispose()
    {
        _clockTimer?.Dispose();
        Live.ScheduleChanged -= OnScheduleChanged;
    }

    private async Task LoadScheduleAsync()
    {
        _slots = await Api.GetScheduleAsync();
        _loadError = _slots is null
            ? "Failed to load the program board â€” backend unreachable."
            : null;
    }

    private void OnScheduleChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadScheduleAsync();
            StateHasChanged();
        });
    }

    private IEnumerable<ScheduleBlock> BlocksForDay(int day)
    {
        var cursor = 0;
        foreach (var slot in (_slots ?? [])
            .Where(item => item.DayOfWeek == day)
            .OrderBy(item => item.StartMinute)
            .ThenBy(item => item.Id))
        {
            var start = Math.Clamp(slot.StartMinute, 0, 24 * 60);
            var end = Math.Clamp(slot.StartMinute + slot.DurationMinutes, 0, 24 * 60);
            if (end <= start)
            {
                continue;
            }

            if (start > cursor)
            {
                yield return ScheduleBlock.Planning(day, cursor, start - cursor);
            }

            var visibleStart = Math.Max(start, cursor);
            if (end > visibleStart)
            {
                yield return ScheduleBlock.Planned(day, visibleStart, end - visibleStart, slot);
            }

            cursor = Math.Max(cursor, end);
        }

        if (cursor < 24 * 60)
        {
            yield return ScheduleBlock.Planning(day, cursor, 24 * 60 - cursor);
        }
    }

    private string DayHeaderStyle(int day)
        => $"grid-column:{DayColumn(day)};grid-row:1";

    private string HourStyle(int hour)
        => $"grid-column:1;grid-row:{MinuteRow(hour * 60)} / span 2";

    private string BlockStyle(ScheduleBlock block)
        => $"grid-column:{DayColumn(block.DayOfWeek)};grid-row:{MinuteRow(block.StartMinute)} / span {MinuteSpan(block.DurationMinutes)}";

    private string BlockClass(ScheduleBlock block)
        => $"schedule-cell {(block.IsPlanned ? "planned" : "planning")} {(MinuteSpan(block.DurationMinutes) == 1 ? "compact" : null)} {(IsCurrentBlock(block) ? "current" : null)}";

    private string NowLineStyle()
        => $"grid-column:{DayColumn(CurrentDay)};grid-row:{MinuteRow(CurrentMinute)};--now-offset:{MinuteOffsetPercent(CurrentMinute).ToString("0.##", CultureInfo.InvariantCulture)}%";

    private int DayColumn(int day)
        => Array.IndexOf(_dayOrder, day) + 2;

    private static int MinuteRow(int minute)
        => Math.Clamp(minute, 0, 24 * 60 - 1) / 30 + 2;

    private static int MinuteSpan(int minutes)
        => Math.Max(1, (minutes + 29) / 30);

    private static double MinuteOffsetPercent(int minute)
        => Math.Round(Math.Clamp(minute, 0, 24 * 60 - 1) % 30 / 30d * 100d, 2);

    private static int CurrentDay => (int)DateTime.Now.DayOfWeek;

    private static int CurrentMinute => DateTime.Now.Hour * 60 + DateTime.Now.Minute;

    private static bool IsCurrentBlock(ScheduleBlock block)
        => block.IsPlanned
            && block.DayOfWeek == CurrentDay
            && CurrentMinute >= block.StartMinute
            && CurrentMinute < block.EndMinute;

    private static string BlockTitle(ScheduleBlock block)
        => block.Slot is { } slot
            ? $"{FormatRange(block.StartMinute, block.EndMinute)} | {slot.FormatName ?? "in planning"} | {slot.ModeratorName ?? "no host"} | {slot.Genre ?? "no genre"}"
            : $"{FormatRange(block.StartMinute, block.EndMinute)} | still in planning";

    private static string FormatRange(int startMinute, int endMinute)
        => $"{FormatMinute(startMinute)}-{FormatMinute(endMinute)}";

    private static string FormatMinute(int minute)
    {
        var clamped = Math.Clamp(minute, 0, 24 * 60);
        return $"{clamped / 60:00}:{clamped % 60:00}";
    }

    private static string DayName(int day) => ((DayOfWeek)day).ToString()[..3];

    private sealed record ScheduleBlock(
        int DayOfWeek,
        int StartMinute,
        int DurationMinutes,
        ProgramSlotDto? Slot)
    {
        public int EndMinute => StartMinute + DurationMinutes;

        public bool IsPlanned => Slot?.FormatId is not null;

        public static ScheduleBlock Planning(int day, int startMinute, int durationMinutes)
            => new(day, startMinute, durationMinutes, null);

        public static ScheduleBlock Planned(int day, int startMinute, int durationMinutes, ProgramSlotDto slot)
            => new(day, startMinute, durationMinutes, slot);
    }
}
