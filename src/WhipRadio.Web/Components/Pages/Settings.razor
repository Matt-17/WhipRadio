@page "/settings"
@using WhipRadio.Core.Api
@using WhipRadio.Core.Entities
@using WhipRadio.Web.Services
@inject RadioApiClient Api

<PageTitle>WhipRadio — Settings</PageTitle>

<h1 class="stage-title">Station Settings</h1>
<div class="stage-sub">turn the big knobs carefully</div>

@if (_loadError is not null)
{
    <div class="panel reveal"><div class="empty-state text-danger">@_loadError</div></div>
}
else if (_settings is null)
{
    <div class="panel reveal"><div class="empty-state"><span class="blink">▮</span> reading the console memory...</div></div>
}
else
{
    <div class="panel reveal">
        <div class="panel-label">Station Defaults</div>
        <div class="form-grid">
            <div class="field">
                <label>Station language</label>
                <div class="field-flag">
                    <Flag Code="@_defaultLanguage" />
                    <select @bind="_defaultLanguage">
                        @foreach (var lang in StationLanguages.All)
                        {
                            <option value="@lang">@StationLanguages.DisplayName(lang) (@lang)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="field"><label>Display frequency (MHz)</label><input type="number" step="0.1" min="76" max="108" @bind="_frequencyMhz" /></div>
            <div class="field">
                <label>First day of week</label>
                <select @bind="_firstDayOfWeek">
                    <option value="1">Monday</option>
                    <option value="0">Sunday</option>
                </select>
            </div>
        </div>
    </div>

    <div class="btn-row block-end">
        <button class="btn primary" @onclick="SaveAsync">Save to Console</button>
        @if (_saved)
        {
            <span class="flash">✓ applied</span>
        }
    </div>

    <div class="panel reveal">
        <div class="panel-label">Archive — Imported Music</div>
        <div class="admin-row">
            <div>
                <strong>Uploads</strong>
                <div class="dim">Allow dropping existing music files on the <a href="/archive">Archive page</a>.</div>
            </div>
            <UiSwitch Value="@_settings.ArchiveUploadEnabled"
                      ValueChanged="@(_ => ToggleArchiveAsync(s => s with { ArchiveUploadEnabled = !s.ArchiveUploadEnabled }))"
                      Title="@(_settings.ArchiveUploadEnabled ? "Uploads enabled" : "Uploads off")" />
        </div>
        <div class="admin-row">
            <div>
                <strong>Play imported music</strong>
                <div class="dim">Imported tracks join normal rotation next to generated songs.</div>
            </div>
            <UiSwitch Value="@_settings.ArchivePlayoutEnabled"
                      ValueChanged="@(_ => ToggleArchiveAsync(s => s with { ArchivePlayoutEnabled = !s.ArchivePlayoutEnabled }))"
                      Title="@(_settings.ArchivePlayoutEnabled ? "Imported playout enabled" : "Imported playout off")" />
        </div>
        <div class="admin-row">
            <div>
                <strong>Metadata enrichment</strong>
                <div class="dim">Improve imported metadata with open local data and audio analysis. No API keys required.</div>
            </div>
            <UiSwitch Value="@_settings.ArchiveEnrichmentEnabled"
                      ValueChanged="@(_ => ToggleArchiveAsync(s => s with { ArchiveEnrichmentEnabled = !s.ArchiveEnrichmentEnabled }))"
                      Title="@(_settings.ArchiveEnrichmentEnabled ? "Enrichment enabled" : "Enrichment off")" />
        </div>
        <div class="admin-row">
            <div>
                <strong>Host knowledge</strong>
                <div class="dim">Podcast and chat hosts may look up gathered artist facts (Wikipedia/Wikidata digests).</div>
            </div>
            <UiSwitch Value="@_settings.PodcastKnowledgeEnabled"
                      ValueChanged="@(_ => ToggleArchiveAsync(s => s with { PodcastKnowledgeEnabled = !s.PodcastKnowledgeEnabled }))"
                      Title="@(_settings.PodcastKnowledgeEnabled ? "Host knowledge enabled" : "Host knowledge off")" />
        </div>
    </div>
}

@code {
    private StationSettingsDto? _settings;
    private bool _saved;
    private string? _loadError;

    private string _defaultLanguage = "en";
    private double _frequencyMhz = 104.4;
    private int _firstDayOfWeek = 1;

    protected override async Task OnInitializedAsync()
    {
        _settings = await Api.GetSettingsAsync();
        if (_settings is null)
        {
            _loadError = "Failed to read station settings — backend unreachable.";
            return;
        }

        _loadError = null;
        _defaultLanguage = _settings.DefaultLanguage;
        _frequencyMhz = _settings.FrequencyMhz;
        _firstDayOfWeek = _settings.FirstDayOfWeek;
    }

    private async Task SaveAsync()
    {
        var fresh = await Api.GetSettingsAsync();
        if (fresh is null)
        {
            return;
        }

        _settings = await Api.SaveSettingsAsync(fresh with
        {
            DefaultLanguage = _defaultLanguage,
            FrequencyMhz = _frequencyMhz,
            FirstDayOfWeek = _firstDayOfWeek,
        });
        _saved = true;
    }

    // The Archive switches save immediately (design guide) — independent of
    // the staged "Save to Console" form above.
    private async Task ToggleArchiveAsync(Func<StationSettingsDto, StationSettingsDto> mutate)
    {
        var fresh = await Api.GetSettingsAsync();
        if (fresh is null)
        {
            return;
        }

        _settings = await Api.SaveSettingsAsync(mutate(fresh));
    }
}
