@page "/artists/feed"
@using WhipRadio.Core.Api
@using WhipRadio.Web.Services
@implements IDisposable
@inject RadioApiClient Api
@inject ArtistFeedLiveClient Live

<PageTitle>WhipRadio - Artist Feed</PageTitle>

<h1 class="stage-title">Artist Feed</h1>
<div class="stage-sub">public wire notes from the fictional roster</div>

<section class="reveal artist-feed-panel">
    <div class="artist-feed-head">
        <div class="panel-label">Artist Wire</div>
        @if (_loading)
        {
            <StatusBadge Text="checking" />
        }
    </div>

    @if (_posts.Count == 0 && _loading)
    {
        <div class="empty-state"><span class="blink">&#x25AE;</span> tuning the artist wire...</div>
    }
    else if (_posts.Count == 0)
    {
        <div class="empty-state compact">No artist posts on the wire yet.</div>
    }
    else
    {
        <div class="artist-feed-list">
            @foreach (var post in _posts)
            {
                <article class="artist-feed-row @(_freshPostIds.Contains(post.Id) ? "fresh" : null)">
                    <PersonAvatar Name="@post.ArtistName" Size="feed" />
                    <div class="artist-feed-post">
                        <div class="artist-feed-meta">
                            <span class="artist-feed-artist">@post.ArtistName</span>
                            <span class="artist-feed-dot">&bull;</span>
                            <span class="artist-feed-time"><TimeAgo Date="@AsUtc(post.CreatedAtUtc)" /></span>
                        </div>
                        <div class="artist-feed-body">@post.Body</div>
                    </div>
                </article>
            }
        </div>

        <div class="artist-feed-footer">
            @if (HasMore)
            {
                <button class="btn small" disabled="@_loadingOlder" @onclick="LoadOlderAsync">
                    @(_loadingOlder ? "loading..." : "load older")
                </button>
            }
            else
            {
                <span class="dim mono-line">end of feed</span>
            }
        </div>
    }
</section>

@code {
    private const int PageSize = 20;

    private readonly List<ArtistPostDto> _posts = [];
    private int _page = 1;
    private int _total;
    private bool _loading = true;
    private bool _loadingOlder;
    private readonly HashSet<Guid> _freshPostIds = [];

    private bool HasMore => _posts.Count < _total;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync(1, replace: true);
        Live.PostAdded += OnPostAdded;
        await Live.EnsureStartedAsync();
        _loading = false;
    }

    private async Task LoadOlderAsync()
    {
        if (_loadingOlder || !HasMore)
        {
            return;
        }

        _loadingOlder = true;
        try
        {
            await LoadPageAsync(_page + 1, replace: false);
        }
        finally
        {
            _loadingOlder = false;
        }
    }

    private async Task LoadPageAsync(int page, bool replace)
    {
        var result = await Api.GetArtistPostsAsync(page, PageSize);
        _total = result.Total;
        _page = result.Page;
        if (replace)
        {
            _posts.Clear();
        }

        _posts.AddRange(result.Items);
    }

    private void OnPostAdded(ArtistPostDto post)
    {
        _ = InvokeAsync(async () =>
        {
            if (_posts.Any(existing => existing.Id == post.Id))
            {
                return;
            }

            _posts.Insert(0, post);
            _total++;
            _freshPostIds.Add(post.Id);
            StateHasChanged();

            await Task.Delay(TimeSpan.FromSeconds(3));
            if (_freshPostIds.Remove(post.Id))
            {
                StateHasChanged();
            }
        });
    }

    private static DateTime AsUtc(DateTime value)
        => value.Kind == DateTimeKind.Utc
            ? value
            : DateTime.SpecifyKind(value, DateTimeKind.Utc);

    public void Dispose()
    {
        Live.PostAdded -= OnPostAdded;
    }
}
