@using WhipRadio.Web.Services
@implements IDisposable
@inject RadioLiveClient Live

<div class="onair @(Live.NowPlaying is not null ? "live" : null)">
    <span class="lamp"></span> On Air
</div>

@code {
    protected override void OnInitialized() => Live.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Live.EnsureStartedAsync();
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Live.Changed -= OnChanged;
}
