@using WhipRadio.Core.Api
@using WhipRadio.Web.Services
@implements IDisposable
@inject RadioLiveClient Live

<div class="onair @LampClass" title="@LampTitle">
    <span class="lamp"></span> On Air
</div>

@code {
    protected override void OnInitialized() => Live.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Live.EnsureStartedAsync();
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Live.Changed -= OnChanged;

    // The "ON AIR" wording never changes — state is shown purely through the lamp's
    // colour/glow/blink. PlayoutEnabled now rides the live feed, so the lamp shares
    // the exact derivation the admin badge uses and the two can never disagree.
    private StationPresentation State
        => StationPresentationState.Derive(
            Live.StationStatus?.Status,
            Live.StationStatus?.PlayoutEnabled ?? true,
            Live.NowPlaying is not null);

    private string? LampClass => State switch
    {
        StationPresentation.Offline => "offline",       // red, blinking
        StationPresentation.Reconnecting => "reconnecting", // border stays, dot goes amber + blinks
        StationPresentation.OffAir => "offair",         // dark, border off, text grey
        _ => "live",                                    // Live or Standby: red glow
    };

    private string? LampTitle
    {
        get
        {
            var status = Live.StationStatus;
            if (status is null || string.IsNullOrEmpty(status.Reason))
            {
                return null;
            }

            return status.Reason;
        }
    }
}
