@inherits LayoutComponentBase
@using WhipRadio.Web.Services
@inject RadioApiClient Api

<div class="console">
    <header class="masthead">
        <div class="brand">
            <div class="brand-name">Whip<em>Radio</em></div>
            <div class="brand-slogan">Llamas whipped the radio's mix.</div>
        </div>
        <div class="spacer"></div>
        <StudioClock />
        <div class="freq-readout">
            <span>Local AI FM</span>
            <strong>@_frequency.ToString("0.0") MHz</strong>
        </div>
        <OnAirLamp />
    </header>

    <aside class="rack">
        <NavMenu />
    </aside>

    <main class="stage">
        @Body
    </main>

    <FooterPlayer />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Transmission error — the console hiccuped.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private double _frequency = 104.4;

    protected override async Task OnInitializedAsync()
    {
        var settings = await Api.GetSettingsAsync();
        if (settings is not null)
        {
            _frequency = settings.FrequencyMhz;
        }
    }
}
