@using WhipRadio.Core.Api
@using WhipRadio.Web.Services
@implements IAsyncDisposable
@inject RadioLiveClient Live
@inject RadioApiClient Api
@inject PlayerState Player
@inject IJSRuntime Js

<div class="player-area">
    <div class="transcript-drawer @(ShowTranscript ? "open" : null)">
        <div class="panel-label">On the mic — @(Live.NowPlaying?.ModeratorName ?? "host")</div>
        <div class="transcript">@_lastTranscript</div>
    </div>

<footer class="player-bar">
    <button class="btn primary play-btn" @onclick="TogglePlayAsync" title="@(IsAudible ? "stop" : "play")">
        <Icon Name="@(IsAudible ? "stop" : "play")" Size="18" />
    </button>

    <div class="player-info">
        @if (Player.CurrentVoice is { } voice)
        {
            <div class="player-title">
                <span class="player-title-text">🎙 @voice.Title</span>
                <button class="btn small live-btn" @onclick="BackToLiveAsync" title="back to the live stream">◉ back to live</button>
            </div>
            <div class="player-meta">
                Voice preview · @FormatClock(TimeSpan.FromSeconds(_songPos)) / @FormatClock(TimeSpan.FromSeconds(SongDuration))
            </div>
            <div class="player-progress seekable" style="@SeekProgressStyle">
                <input type="range" class="seek-overlay"
                       min="0" max="@SongDuration.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       step="0.1" value="@_songPos.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       @oninput="OnSeekAsync" title="drag to seek" />
            </div>
        }
        else if (Player.CurrentJingle is { } jinglePreview)
        {
            var jingle = jinglePreview.Jingle;
            <div class="player-title">
                <span class="player-title-text">@jingle.Label</span>
                <button class="btn small live-btn" @onclick="BackToLiveAsync" title="back to the live stream">back to live</button>
            </div>
            <div class="player-meta">
                Jingle preview · @FormatClock(TimeSpan.FromSeconds(_songPos)) / @FormatClock(TimeSpan.FromSeconds(SongDuration))
            </div>
            <div class="player-progress seekable" style="@SeekProgressStyle">
                <input type="range" class="seek-overlay"
                       min="0" max="@SongDuration.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       step="0.1" value="@_songPos.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       @oninput="OnSeekAsync" title="drag to seek" />
            </div>
        }
        else if (Player.CurrentTrack is { } track)
        {
            <div class="player-title">
                <span class="player-title-text">@track.ArtistName<span class="dim"> — </span>@track.Title</span>
                <button class="btn small live-btn" @onclick="BackToLiveAsync" title="back to the live stream">◉ back to live</button>
            </div>
            <div class="player-meta">
                Preview · @FormatClock(TimeSpan.FromSeconds(_songPos)) / @FormatClock(TimeSpan.FromSeconds(SongDuration))
            </div>
            <div class="player-progress seekable" style="@SeekProgressStyle">
                <input type="range" class="seek-overlay"
                       min="0" max="@SongDuration.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       step="0.1" value="@_songPos.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       @oninput="OnSeekAsync" title="drag to seek" />
            </div>
        }
        else if (Live.NowPlaying is { } np)
        {
            <div class="player-title">
                <span class="player-title-text">
                    @if (np.ArtistName is not null)
                    {
                        @np.ArtistName<span class="dim"> — </span>
                    }
                    @np.Title
                </span>
                <span class="live-btn-spacer" aria-hidden="true"></span>
            </div>
            <div class="player-meta">
                @(np.FormatName ?? "WhipRadio")@(np.ModeratorName is not null ? $" with {np.ModeratorName}" : "")
                · @FormatClock(Elapsed) / @FormatClock(TimeSpan.FromSeconds(np.DurationSeconds))
            </div>
            <div class="player-progress"><div class="fill" style="@ProgressFillStyle(Progress)"></div></div>
        }
        else
        {
            <div class="player-title dim">
                <span class="player-title-text">— tuning —</span>
                <span class="live-btn-spacer" aria-hidden="true"></span>
            </div>
            <div class="player-meta">waiting for the studio</div>
            <div class="player-progress"><div class="fill" style="width:0%"></div></div>
        }
    </div>

    <div class="player-votes">
        <button class="btn vote-up" disabled="@(!CanVote)" @onclick="() => VoteAsync(1)">👍 @VoteUp</button>
        <button class="btn vote-down" disabled="@(!CanVote)" @onclick="() => VoteAsync(-1)">👎 @VoteDown</button>
    </div>

    <button class="btn transcript-toggle @(_transcriptEnabled ? "active" : null)"
            @onclick="ToggleTranscriptAsync" title="@(_transcriptEnabled ? "transcripts on" : "transcripts off")">
        <Icon Name="transcript" />
    </button>

    <div class="volume-control">
        <input type="range" class="volume-range"
               min="0" max="100" step="1" value="@_volume"
               style="@VolumeStyle" @oninput="OnVolumeChanged"
               title="Volume" aria-label="Volume" />
    </div>
</footer>
</div>

@code {
    private bool _livePlaying;
    private bool _songPlaying;
    private double _songPos;
    private double _songDur;
    private int _volume = 80;
    private string _streamUrl = "";
    private bool _transcriptEnabled;
    private string? _lastTranscript;
    private Timer? _ticker;

    private sealed record AudioStatus(double Position, double Duration, bool Paused, bool Ended);

    private bool IsAudible => Player.IsLive ? _livePlaying : _songPlaying;

    // Drawer slides up only for live announcements with the toggle on; keeping
    // the last transcript lets the close animation show text while sliding down.
    private bool ShowTranscript => _transcriptEnabled
        && Player.IsLive
        && Live.NowPlaying is { Transcript: not null };

    private double SongDuration => _songDur > 0
        ? _songDur
        : Player.CurrentTrack?.DurationSeconds
            ?? Player.CurrentVoice?.DurationSeconds
            ?? Player.CurrentJingle?.Jingle.DurationSeconds
            ?? 0;

    private double SongProgress => SongDuration > 0 ? Math.Clamp(_songPos / SongDuration * 100, 0, 100) : 0;

    private bool CanVote => Player.CurrentVoice is null
        && Player.CurrentJingle is null
        && (Player.CurrentTrack is not null || Live.NowPlaying?.ItemType == "Track");

    private int VoteUp => Player.CurrentTrack?.UpVotes ?? Live.NowPlaying?.UpVotes ?? 0;

    private int VoteDown => Player.CurrentTrack?.DownVotes ?? Live.NowPlaying?.DownVotes ?? 0;

    private TimeSpan Elapsed => Live.NowPlaying is { } np
        ? DateTime.UtcNow - np.StartedAtUtc
        : TimeSpan.Zero;

    private double Progress => Live.NowPlaying is { } np && np.DurationSeconds > 0
        ? Math.Clamp(Elapsed.TotalSeconds / np.DurationSeconds * 100, 0, 100)
        : 0;

    private string VolumeStyle => $"--volume-fill: {_volume}%";

    private string SeekProgressStyle => $"--seek-fill: {FormatCssPercent(SongProgress)}";

    private static string ProgressFillStyle(double percent) => $"width:{FormatCssPercent(percent)}";

    private static string FormatCssPercent(double percent) =>
        $"{Math.Clamp(percent, 0, 100).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}%";

    protected override void OnInitialized()
    {
        // Same-origin proxy: works on http and https pages alike (no mixed content).
        _streamUrl = "/media/live";
        Live.Changed += OnLiveChanged;
        Player.Changed += OnPlayerModeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Live.EnsureStartedAsync();
            _ticker = new Timer(_ => _ = InvokeAsync(TickAsync), null,
                TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));

            var shouldRefresh = false;

            var savedVolume = await Js.InvokeAsync<int>("whipRadio.getVolume");
            savedVolume = Math.Clamp(savedVolume, 0, 100);
            if (savedVolume != _volume)
            {
                _volume = savedVolume;
                shouldRefresh = true;
            }

            var saved = await Js.InvokeAsync<string?>("localStorage.getItem", "whipradio.transcript");
            if (saved == "on")
            {
                _transcriptEnabled = true;
                shouldRefresh = true;
            }

            var restoredLive = await Js.InvokeAsync<bool>("whipRadio.restoreLive", _streamUrl);
            if (Player.IsLive && restoredLive != _livePlaying)
            {
                _livePlaying = restoredLive;
                shouldRefresh = true;
            }

            if (shouldRefresh)
            {
                StateHasChanged();
            }
        }
    }

    private async Task ToggleTranscriptAsync()
    {
        _transcriptEnabled = !_transcriptEnabled;
        await Js.InvokeVoidAsync("localStorage.setItem", "whipradio.transcript", _transcriptEnabled ? "on" : "off");
    }

    private async Task TickAsync()
    {
        if (!Player.IsLive && _songPlaying)
        {
            var status = await Js.InvokeAsync<AudioStatus>("whipRadio.getStatus");
            _songPos = status.Position;
            _songDur = status.Duration;

            if (status.Ended)
            {
                await BackToLiveAsync();
                return;
            }
        }

        StateHasChanged();
    }

    private void OnLiveChanged()
    {
        if (Live.NowPlaying?.Transcript is { } transcript)
        {
            _lastTranscript = transcript;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void OnPlayerModeChanged() => _ = InvokeAsync(async () =>
    {
        if (Player.CurrentTrack is { } track)
        {
            await StartPreviewAsync(Api.TrackAudioUrl(track.Id), track.DurationSeconds);
        }
        else if (Player.CurrentVoice is { } voice)
        {
            await StartPreviewAsync(voice.Url, voice.DurationSeconds);
        }
        else if (Player.CurrentJingle is { } jingle)
        {
            await StartPreviewAsync(jingle.Url, jingle.Jingle.DurationSeconds);
        }

        StateHasChanged();
    });

    private async Task StartPreviewAsync(string url, double durationSeconds)
    {
        _livePlaying = false;
        _songPos = 0;
        _songDur = durationSeconds;
        _songPlaying = await Js.InvokeAsync<bool>("whipRadio.playTrack", url);
        await Js.InvokeVoidAsync("whipRadio.setVolume", _volume / 100.0);
    }

    private async Task BackToLiveAsync()
    {
        var shouldKeepPlaying = _songPlaying;
        _songPlaying = false;
        _livePlaying = shouldKeepPlaying;
        _songPos = 0;
        _songDur = 0;
        Player.BackToLive();
        StateHasChanged();

        await Js.InvokeVoidAsync("whipRadio.nextFrame");

        var livePlaying = await Js.InvokeAsync<bool>("whipRadio.backToLive", _streamUrl);
        _livePlaying = livePlaying;
        await Js.InvokeVoidAsync("whipRadio.setVolume", _volume / 100.0);

        StateHasChanged();
    }

    private async Task TogglePlayAsync()
    {
        if (!Player.IsLive)
        {
            if (_songPlaying)
            {
                _songPlaying = false;
                StateHasChanged();
                await Js.InvokeVoidAsync("whipRadio.nextFrame");
                await Js.InvokeVoidAsync("whipRadio.pause");
            }
            else
            {
                _songPlaying = true;
                StateHasChanged();
                await Js.InvokeVoidAsync("whipRadio.nextFrame");
                var songPlaying = await Js.InvokeAsync<bool>("whipRadio.resumeTrack");
                _songPlaying = songPlaying;
            }

            StateHasChanged();
            return;
        }

        if (_livePlaying)
        {
            _livePlaying = false;
            StateHasChanged();
            await Js.InvokeVoidAsync("whipRadio.nextFrame");
            await Js.InvokeVoidAsync("whipRadio.pause");
        }
        else
        {
            _livePlaying = true;
            StateHasChanged();
            await Js.InvokeVoidAsync("whipRadio.nextFrame");
            var livePlaying = await Js.InvokeAsync<bool>("whipRadio.play", _streamUrl);
            _livePlaying = livePlaying;
            await Js.InvokeVoidAsync("whipRadio.setVolume", _volume / 100.0);
        }

        StateHasChanged();
    }

    private async Task OnSeekAsync(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var position))
        {
            _songPos = position;
            await Js.InvokeVoidAsync("whipRadio.seek", position);
        }
    }

    private async Task OnVolumeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var volume))
        {
            _volume = volume;
            await Js.InvokeVoidAsync("whipRadio.setVolume", _volume / 100.0);
        }
    }

    private async Task VoteAsync(int direction)
    {
        if (Player.CurrentTrack is { } track)
        {
            await Api.VoteAsync(track.Id, direction);
        }
        else if (Live.NowPlaying is { ItemType: "Track" } np)
        {
            await Api.VoteAsync(np.ItemId, direction);
        }
    }

    public ValueTask DisposeAsync()
    {
        Live.Changed -= OnLiveChanged;
        Player.Changed -= OnPlayerModeChanged;
        _ticker?.Dispose();
        return ValueTask.CompletedTask;
    }
}
