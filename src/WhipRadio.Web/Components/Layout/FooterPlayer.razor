@using WhipRadio.Core.Api
@using WhipRadio.Web.Services
@implements IAsyncDisposable
@inject RadioLiveClient Live
@inject RadioApiClient Api
@inject PlayerState Player
@inject IJSRuntime Js

<div class="player-area">
    <TranscriptPanel Open="ShowTranscriptPanel"
                     HeaderLabel="@_lastHeader"
                     Byline="@_lastByline"
                     Body="@_lastBody"
                     OnClose="CloseTranscriptPanelAsync" />
    <footer class="player-bar">
    <button class="btn primary play-btn" @onclick="TogglePlayAsync" title="@(IsAudible ? "stop (Space)" : "play (Space)")">
        <Icon Name="@(IsAudible ? "stop" : "play")" Size="24" />
    </button>

    @if (_autoplayBlocked && Player.IsLive)
    {
        <button class="btn small autoplay-hint" @onclick="ResumeBlockedAudioAsync" title="@AutoplayHintTitle">
            audio blocked
        </button>
    }

    <div class="player-info">
        @if (Preview is { } preview)
        {
            <div class="player-title">
                <span class="player-title-text">
                    <span class="player-track">@preview.Title</span>
                    @if (preview.ArtistName is not null)
                    {
                        <span class="player-byline"> by </span>
                        @preview.ArtistName
                    }
                </span>
                <button class="btn small live-btn" @onclick="BackToLiveAsync" title="back to the live stream (B)">
                    <span class="live-dot" aria-hidden="true"></span>
                    <span>back to live</span>
                </button>
            </div>
            <div class="player-meta">
                <span class="player-meta-time">@PreviewTime</span>
                <span class="player-meta-item">preview <strong>@preview.Type</strong></span>
            </div>
            <ProgressBar Class="player-progress" Value="_songPos" Max="SongDuration" Step="0.1"
                         Color="amber" HasHandle="true" OnValueInput="OnSeekValueAsync"
                         Title="drag to seek" AriaLabel="Preview position" />
        }
        else if (Live.NowPlaying is { } np)
        {
            <div class="player-title">
                <span class="player-title-text">
                    <span class="player-track">@np.Title</span>
                    @if (np.ArtistName is not null)
                    {
                        <span class="player-byline"> by </span>
                        @np.ArtistName
                    }
                </span>
                <span class="live-btn-spacer" aria-hidden="true"></span>
            </div>
            <div class="player-meta">
                <span class="player-meta-time">@($"{FormatClock(Elapsed)}{ThinSpace}/{ThinSpace}{FormatClock(TimeSpan.FromSeconds(np.DurationSeconds))}")</span>
                <span class="player-meta-item">now <strong>@(np.FormatName ?? "WhipRadio")</strong></span>
                @if (np.ModeratorName is not null)
                {
                    <span class="player-meta-item">host <strong>@np.ModeratorName</strong></span>
                }
            </div>
            <ProgressBar Class="player-progress" Value="Progress" Color="amber" AriaLabel="Current song progress" />
        }
        else
        {
            <div class="player-title dim">
                <span class="player-title-text">— tuning —</span>
                <span class="live-btn-spacer" aria-hidden="true"></span>
            </div>
            <div class="player-meta">waiting for the studio</div>
            <ProgressBar Class="player-progress" Value="0" Color="amber" AriaLabel="Current song progress" />
        }
    </div>

    <div class="player-votes">
        <button class="btn vote-up @(_myVote == 1 ? "voted" : null)" disabled="@(!CanVote)"
                aria-pressed="@(_myVote == 1)" @onclick="() => VoteAsync(1)"
                title="@(_myVote == 1 ? "remove thumbs up (L)" : "thumbs up (L)")">
            <Icon Name="thumb-up" Size="20" Class="player-vote-icon" />
            <span>@VoteUp</span>
        </button>
        <button class="btn vote-down @(_myVote == -1 ? "voted" : null)" disabled="@(!CanVote)"
                aria-pressed="@(_myVote == -1)" @onclick="() => VoteAsync(-1)"
                title="@(_myVote == -1 ? "remove thumbs down (H)" : "thumbs down (H)")">
            <Icon Name="thumb-down" Size="20" Class="player-vote-icon" />
            <span>@VoteDown</span>
        </button>
    </div>

    <button class="btn footer-toggle transcript-toggle @(_transcriptEnabled ? "active" : null)"
            data-footer-toggle="transcript"
            aria-pressed="@_transcriptEnabled"
            @onclick="ToggleTranscriptAsync" title="@(_transcriptEnabled ? "transcripts & lyrics on (T)" : "transcripts & lyrics off (T)")">
        <Icon Name="transcript" Size="22" />
    </button>

    <button class="btn footer-toggle mute-toggle @(_muted ? "active" : null)"
            data-footer-toggle="mute"
            aria-pressed="@_muted"
            @onclick="ToggleMuteAsync" title="@(_muted ? "unmute (M)" : "mute (M)")">
        <Icon Name="@(_muted ? "mute" : "volume")" Size="22" />
    </button>

    <div class="volume-control">
        <ProgressBar Class="volume-range" Value="@(_muted ? 0 : _volume)" Color="amber" HasHandle="true" WheelStep="5"
                     OnValueInput="OnVolumeValueChanged" Title="Volume" AriaLabel="Volume" />
    </div>
    </footer>
</div>

@code {
    private bool _livePlaying;
    private bool _songPlaying;
    private double _songPos;
    private double _songDur;
    private int _volume = 80;
    private bool _muted;
    private string _streamUrl = "";
    private bool _transcriptEnabled;
    private string _lastHeader = "";
    private string? _lastByline;
    private string _lastBody = "";
    private bool _autoplayBlocked;
    private string? _autoplayPolicy;
    private bool _autoplayPolicySupported;
    private int _myVote;
    private Guid? _voteItemId;
    private VoteResultDto? _voteResult;
    private Timer? _ticker;
    private DotNetObjectReference<FooterPlayer>? _interopRef;
    private bool _mediaSessionEnabled;
    private const string ThinSpace = "\u2009";
    private const string PlaceholderArtwork = "/skeleton-art.png";

    private sealed record AudioStatus(double Position, double Duration, bool Paused, bool Ended);
    private sealed record AutoplayStatus(bool Supported, string? Policy, bool Blocked, bool PendingUnlock);
    private sealed record PreviewState(
        string Title,
        string? ArtistName,
        string Type,
        string? PanelHeader,
        string? PanelByline,
        string? PanelBody);
    private sealed record MediaSessionState(string Title, string? Artist, string? Album, string? ArtworkUrl);

    private bool IsAudible => Player.IsLive ? _livePlaying : _songPlaying;

    // Panel slides open for live segments and for previews alike (whenever the
    // toggle is on and there is text to show); keeping the last header/body lets
    // the close animation show content while sliding down.
    private bool ShowTranscriptPanel => _transcriptEnabled
        && (Player.IsLive
            ? Live.NowPlaying is { } np && (np.Transcript is not null || np.Lyrics is not null)
            : Preview is { PanelBody: not null });

    private static string? OrNull(string? text) => string.IsNullOrWhiteSpace(text) ? null : text;

    private static string PanelHeaderFor(NowPlayingDto np) => np.ItemType switch
    {
        "Announcement" => $"{RadioDisplayNames.AnnouncementTitle(np.AnnouncementKind)} — {np.ModeratorName ?? "host"}",
        "Track" => $"Lyrics — {np.Title}",
        _ => "On the mic",
    };

    private double SongDuration => _songDur > 0
        ? _songDur
        : Player.CurrentTrack?.DurationSeconds
            ?? Player.CurrentVoice?.DurationSeconds
            ?? Player.CurrentJingle?.Jingle.DurationSeconds
            ?? Player.CurrentAnnouncement?.DurationSeconds
            ?? 0;

    // Feedback is only meaningful for songs: a library-track preview or a live
    // track. Voice/jingle/announcement previews leave the buttons disabled.
    private bool CanVote => Player.CurrentVoice is null
        && Player.CurrentJingle is null
        && Player.CurrentAnnouncement is null
        && (Player.CurrentTrack is not null || Live.NowPlaying?.ItemType == "Track");

    // The track the feedback buttons act on, or null when nothing is votable.
    private Guid? CurrentVoteItemId => !CanVote
        ? null
        : Player.CurrentTrack?.Id ?? Live.NowPlaying?.ItemId;

    // For a preview the count is a fixed snapshot, so overlay the latest server tally
    // when it matches; the live track instead stays current via the SignalR broadcast.
    private int VoteUp => Player.CurrentTrack is { } track
        ? (_voteResult is { } v && v.TrackId == track.Id ? v.UpVotes : track.UpVotes)
        : Live.NowPlaying?.UpVotes ?? 0;

    private int VoteDown => Player.CurrentTrack is { } track
        ? (_voteResult is { } v && v.TrackId == track.Id ? v.DownVotes : track.DownVotes)
        : Live.NowPlaying?.DownVotes ?? 0;

    private PreviewState? Preview => Player.CurrentTrack is { } track
        ? new PreviewState(track.Title, track.ArtistName, "song",
            $"Lyrics — {track.Title}",
            track.ArtistName is { } artist ? $"by {artist}" : null,
            OrNull(track.Lyrics))
        : Player.CurrentVoice is { } voice
            ? new PreviewState(voice.Title, null, "voice", null, null, null)
            : Player.CurrentJingle is { } jingle
                ? new PreviewState(jingle.Jingle.Label, null, "jingle", null, null, null)
                : Player.CurrentAnnouncement is { } announcement
                    ? new PreviewState(announcement.Title, null, "announcement",
                        announcement.Title, null, OrNull(announcement.Transcript))
                    : null;

    private TimeSpan Elapsed => Live.NowPlaying is { } np
        ? DateTime.UtcNow - np.StartedAtUtc
        : TimeSpan.Zero;

    private double Progress => Live.NowPlaying is { } np && np.DurationSeconds > 0
        ? Math.Clamp(Elapsed.TotalSeconds / np.DurationSeconds * 100, 0, 100)
        : 0;

    private string PreviewTime
        => $"{FormatClock(TimeSpan.FromSeconds(_songPos))}{ThinSpace}/{ThinSpace}{FormatClock(TimeSpan.FromSeconds(SongDuration))}";

    private string AutoplayHintTitle => _autoplayPolicySupported && !string.IsNullOrWhiteSpace(_autoplayPolicy)
        ? $"browser autoplay policy: {_autoplayPolicy}; click to resume audio"
        : "browser blocked autoplay; click to resume audio";

    protected override void OnInitialized()
    {
        // Same-origin proxy: works on http and https pages alike (no mixed content).
        _streamUrl = "/media/live";
        Live.Changed += OnLiveChanged;
        Live.LiveStreamRestored += OnLiveStreamRestored;
        Player.Changed += OnPlayerModeChanged;
    }

    // The studio came back after a restart and swapped the Icecast source; the
    // element is still draining pre-restart audio that lags the now-playing card.
    // Re-tune to the fresh live edge (no-op unless live is actually playing).
    private void OnLiveStreamRestored() => _ = InvokeAsync(async () =>
    {
        try
        {
            await Js.InvokeVoidAsync("whipRadio.retuneLive");
        }
        catch (JSDisconnectedException)
        {
            // Circuit is gone during shutdown.
        }
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Live.EnsureStartedAsync();
            _ticker = new Timer(_ => _ = InvokeAsync(TickAsync), null,
                TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));

            var shouldRefresh = false;

            var savedVolume = await Js.InvokeAsync<int>("whipRadio.getVolume");
            savedVolume = Math.Clamp(savedVolume, 0, 100);
            if (savedVolume != _volume)
            {
                _volume = savedVolume;
                shouldRefresh = true;
            }

            var muted = await Js.InvokeAsync<bool>("whipRadio.getMuted");
            if (muted != _muted)
            {
                _muted = muted;
                shouldRefresh = true;
            }

            var saved = await Js.InvokeAsync<string?>("localStorage.getItem", "whipradio.transcript");
            if (saved == "on")
            {
                _transcriptEnabled = true;
                shouldRefresh = true;
            }

            var restoredLive = await Js.InvokeAsync<bool>("whipRadio.restoreLive", _streamUrl);
            if (Player.IsLive && restoredLive != _livePlaying)
            {
                _livePlaying = restoredLive;
                shouldRefresh = true;
            }

            if (await UpdateAutoplayStatusAsync())
            {
                shouldRefresh = true;
            }

            await RefreshMyVoteAsync();
            shouldRefresh = true;

            if (shouldRefresh)
            {
                StateHasChanged();
            }

            _interopRef = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("whipRadio.registerFooterShortcuts", _interopRef);
            _mediaSessionEnabled = await Js.InvokeAsync<bool>("whipRadio.initMediaSession", _interopRef);
            await UpdateMediaSessionMetadataAsync();
        }
    }

    private async Task ToggleTranscriptAsync()
    {
        _transcriptEnabled = !_transcriptEnabled;
        StateHasChanged();
        _ = Js.InvokeVoidAsync("localStorage.setItem", "whipradio.transcript", _transcriptEnabled ? "on" : "off");
    }

    private async Task CloseTranscriptPanelAsync()
    {
        if (!_transcriptEnabled)
        {
            return;
        }

        _transcriptEnabled = false;
        StateHasChanged();
        _ = Js.InvokeVoidAsync("localStorage.setItem", "whipradio.transcript", "off");
    }

    private async Task ToggleMuteAsync()
    {
        _muted = !_muted;
        await Js.InvokeAsync<bool>("whipRadio.setMuted", _muted);
    }

    [JSInvokable]
    public async Task TogglePlayShortcut() => await TogglePlayAsync();

    [JSInvokable]
    public async Task ToggleTranscriptShortcut() => await ToggleTranscriptAsync();

    [JSInvokable]
    public async Task ToggleMuteShortcut() => await ToggleMuteAsync();

    [JSInvokable]
    public async Task VoteUpShortcut() => await VoteAsync(1);

    [JSInvokable]
    public async Task VoteDownShortcut() => await VoteAsync(-1);

    [JSInvokable]
    public async Task BackToLiveShortcut()
    {
        // No-op while already live; mirrors the on-screen button being preview-only.
        if (!Player.IsLive)
        {
            await BackToLiveAsync();
        }
    }

    [JSInvokable]
    public async Task HandleMediaSessionPlay()
    {
        if (!IsAudible)
        {
            await TogglePlayAsync();
        }
    }

    [JSInvokable]
    public async Task HandleMediaSessionPause()
    {
        if (IsAudible)
        {
            await TogglePlayAsync();
        }
    }

    [JSInvokable]
    public async Task HandleMediaSessionPrevious()
    {
        // Only act while previewing; when already live there is no "back to live"
        // target, so do nothing — never re-tune/reload the running stream.
        if (!Player.IsLive)
        {
            await BackToLiveAsync(shouldPlay: true);
        }
    }

    private async Task TickAsync()
    {
        if (!Player.IsLive && _songPlaying)
        {
            var status = await Js.InvokeAsync<AudioStatus>("whipRadio.getStatus");
            _songPos = status.Position;
            _songDur = status.Duration;

            if (status.Ended)
            {
                await BackToLiveAsync(shouldPlay: true);
                return;
            }
        }

        await UpdateMediaSessionPositionAsync();

        var autoplayChanged = await UpdateAutoplayStatusAsync();

        if (autoplayChanged)
        {
            StateHasChanged();
            return;
        }

        StateHasChanged();
    }

    private async Task<bool> UpdateAutoplayStatusAsync()
    {
        AutoplayStatus status;
        try
        {
            status = await Js.InvokeAsync<AutoplayStatus>("whipRadio.getAutoplayStatus");
        }
        catch (JSDisconnectedException)
        {
            return false;
        }

        var blocked = status.Blocked || status.PendingUnlock;
        var changed = blocked != _autoplayBlocked
            || status.Policy != _autoplayPolicy
            || status.Supported != _autoplayPolicySupported;

        _autoplayBlocked = blocked;
        _autoplayPolicy = status.Policy;
        _autoplayPolicySupported = status.Supported;
        return changed;
    }

    private async Task ResumeBlockedAudioAsync()
    {
        _livePlaying = true;
        _autoplayBlocked = false;
        StateHasChanged();

        var livePlaying = await Js.InvokeAsync<bool>("whipRadio.resumeBlockedLive", _streamUrl);
        _livePlaying = livePlaying;
        await UpdateMediaSessionMetadataAsync();
        await UpdateAutoplayStatusAsync();
        StateHasChanged();
    }

    private void OnLiveChanged()
    {
        _ = InvokeAsync(async () =>
        {
            RefreshTranscriptContent();
            await RefreshMyVoteAsync();
            await UpdateMediaSessionMetadataAsync();
            StateHasChanged();
        });
    }

    // Keep the panel's last header/body in sync with whatever is current, for both
    // live segments and previews. Called on every mode/live change so returning from
    // a preview to live doesn't leave stale preview text behind the close animation.
    private void RefreshTranscriptContent()
    {
        if (!Player.IsLive)
        {
            if (Preview is { PanelBody: { } body } preview)
            {
                _lastHeader = preview.PanelHeader ?? "";
                _lastByline = preview.PanelByline;
                _lastBody = body;
            }

            return;
        }

        if (Live.NowPlaying is { } np)
        {
            if (np.ItemType == "Announcement" && np.Transcript is { } transcript)
            {
                _lastHeader = PanelHeaderFor(np);
                _lastByline = null;
                _lastBody = transcript;
            }
            else if (np.ItemType == "Track" && np.Lyrics is { } lyrics)
            {
                _lastHeader = PanelHeaderFor(np);
                _lastByline = np.ArtistName is { } artist ? $"by {artist}" : null;
                _lastBody = lyrics;
            }
        }
    }

    private void OnPlayerModeChanged() => _ = InvokeAsync(async () =>
    {
        RefreshTranscriptContent();

        if (Player.CurrentTrack is { } track)
        {
            await StartPreviewAsync(Api.TrackAudioUrl(track.Id), track.DurationSeconds);
        }
        else if (Player.CurrentVoice is { } voice)
        {
            await StartPreviewAsync(voice.Url, voice.DurationSeconds);
        }
        else if (Player.CurrentJingle is { } jingle)
        {
            await StartPreviewAsync(jingle.Url, jingle.Jingle.DurationSeconds);
        }
        else if (Player.CurrentAnnouncement is { } announcement)
        {
            await StartPreviewAsync(announcement.Url, announcement.DurationSeconds);
        }
        else
        {
            await UpdateMediaSessionMetadataAsync();
        }

        await RefreshMyVoteAsync();
        StateHasChanged();
    });

    private async Task StartPreviewAsync(string url, double durationSeconds)
    {
        _livePlaying = false;
        _songPos = 0;
        _songDur = durationSeconds;
        _songPlaying = await Js.InvokeAsync<bool>("whipRadio.playTrack", url);
        await Js.InvokeVoidAsync("whipRadio.setVolume", _volume / 100.0);
        await UpdateMediaSessionMetadataAsync();
    }

    private Task BackToLiveAsync() => BackToLiveAsync(shouldPlay: false);

    private async Task BackToLiveAsync(bool shouldPlay)
    {
        var shouldKeepPlaying = shouldPlay || _songPlaying;
        _songPlaying = false;
        _livePlaying = shouldKeepPlaying;
        _songPos = 0;
        _songDur = 0;
        Player.BackToLive();
        StateHasChanged();

        await Js.InvokeVoidAsync("whipRadio.nextFrame");

        var livePlaying = await Js.InvokeAsync<bool>("whipRadio.backToLive", _streamUrl, shouldKeepPlaying);
        _livePlaying = livePlaying;
        await Js.InvokeVoidAsync("whipRadio.setVolume", _volume / 100.0);
        await UpdateMediaSessionMetadataAsync();

        StateHasChanged();
    }

    private async Task TogglePlayAsync()
    {
        if (!Player.IsLive)
        {
            if (_songPlaying)
            {
                _songPlaying = false;
                StateHasChanged();
                await Js.InvokeVoidAsync("whipRadio.nextFrame");
                await Js.InvokeVoidAsync("whipRadio.pause");
            }
            else
            {
                _songPlaying = true;
                StateHasChanged();
                await Js.InvokeVoidAsync("whipRadio.nextFrame");
                var songPlaying = await Js.InvokeAsync<bool>("whipRadio.resumeTrack");
                _songPlaying = songPlaying;
            }

            await UpdateMediaSessionMetadataAsync();
            StateHasChanged();
            return;
        }

        if (_livePlaying)
        {
            _livePlaying = false;
            StateHasChanged();
            await Js.InvokeVoidAsync("whipRadio.nextFrame");
            await Js.InvokeVoidAsync("whipRadio.pause");
        }
        else
        {
            _livePlaying = true;
            StateHasChanged();
            await Js.InvokeVoidAsync("whipRadio.nextFrame");
            var livePlaying = await Js.InvokeAsync<bool>("whipRadio.play", _streamUrl);
            _livePlaying = livePlaying;
            await Js.InvokeVoidAsync("whipRadio.setVolume", _volume / 100.0);
        }

        await UpdateMediaSessionMetadataAsync();
        StateHasChanged();
    }

    private async Task OnSeekValueAsync(double position)
    {
        _songPos = Math.Clamp(position, 0, SongDuration);
        await Js.InvokeVoidAsync("whipRadio.seek", _songPos);
    }

    private async Task OnVolumeValueChanged(double volume)
    {
        _volume = (int)Math.Round(Math.Clamp(volume, 0, 100));
        if (_muted)
        {
            _muted = false;
            await Js.InvokeAsync<bool>("whipRadio.setMuted", false);
        }

        await Js.InvokeVoidAsync("whipRadio.setVolume", _volume / 100.0);
    }

    private MediaSessionState GetMediaSessionState()
    {
        if (Player.IsLive)
        {
            if (Live.NowPlaying is { } np)
            {
                return new MediaSessionState(
                    np.Title,
                    np.ArtistName,
                    np.FormatName ?? "WhipRadio",
                    null);
            }

            return new MediaSessionState(
                "WhipRadio",
                null,
                "Live",
                null);
        }

        if (Player.CurrentTrack is { } track)
        {
            return new MediaSessionState(track.Title, track.ArtistName, "Track", null);
        }

        if (Player.CurrentVoice is { } voice)
        {
            return new MediaSessionState(voice.Title, null, "Voice Preview", null);
        }

        if (Player.CurrentJingle is { } jingle)
        {
            return new MediaSessionState(jingle.Jingle.Label, null, "Jingle", null);
        }

        if (Player.CurrentAnnouncement is { } announcement)
        {
            return new MediaSessionState(announcement.Title, null, "Announcement", null);
        }

        if (Live.NowPlaying is { } nowPlaying)
        {
            return new MediaSessionState(
                nowPlaying.Title,
                nowPlaying.ArtistName,
                nowPlaying.ItemType == "Announcement"
                    ? RadioDisplayNames.AnnouncementTitle(nowPlaying.AnnouncementKind)
                    : nowPlaying.FormatName ?? "WhipRadio",
                null);
        }

        return new MediaSessionState("WhipRadio", null, "Live", null);
    }

    private async Task UpdateMediaSessionMetadataAsync()
    {
        if (!_mediaSessionEnabled || _interopRef is null)
        {
            return;
        }

        var info = GetMediaSessionState();
        if (string.IsNullOrWhiteSpace(info.Title))
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync(
                "whipRadio.setMediaSessionMetadata",
                info.Title,
                info.Artist,
                info.Album,
                // No per-artist artwork exists yet, so fall back to the station
                // logo as a placeholder; real band photos can populate ArtworkUrl later.
                info.ArtworkUrl ?? PlaceholderArtwork,
                IsAudible);

            // "Previous" = back to live; only offer it while previewing a library
            // item, mirroring the on-screen "back to live" button.
            await Js.InvokeVoidAsync("whipRadio.setMediaSessionCanReturnToLive", !Player.IsLive);
        }
        catch (JSDisconnectedException)
        {
            // Circuit is gone during shutdown.
        }

        await UpdateMediaSessionPositionAsync();
    }

    private (double Duration, double Position) GetMediaSessionPosition()
    {
        if (!Player.IsLive)
        {
            return (SongDuration, _songPos);
        }

        if (Live.NowPlaying is { } np && np.DurationSeconds > 0)
        {
            return (np.DurationSeconds, Math.Clamp(Elapsed.TotalSeconds, 0, np.DurationSeconds));
        }

        return (0, 0);
    }

    private async Task UpdateMediaSessionPositionAsync()
    {
        if (!_mediaSessionEnabled)
        {
            return;
        }

        var (duration, position) = GetMediaSessionPosition();
        try
        {
            await Js.InvokeVoidAsync("whipRadio.setMediaSessionPosition", duration, position);
        }
        catch (JSDisconnectedException)
        {
            // Circuit is gone during shutdown.
        }
    }

    // Loads "did I already vote on the current track?" from client storage so the
    // toggle buttons reflect a recent vote (kept for at least an hour). Only reloads
    // when the votable item actually changes, so it survives unrelated re-renders.
    private async Task RefreshMyVoteAsync()
    {
        var id = CurrentVoteItemId;
        if (id == _voteItemId)
        {
            return;
        }

        _voteItemId = id;
        if (id is not { } itemId)
        {
            _myVote = 0;
            return;
        }

        try
        {
            _myVote = await Js.InvokeAsync<int>("whipRadio.getVote", itemId);
        }
        catch (JSException)
        {
            _myVote = 0;
        }
        catch (JSDisconnectedException)
        {
            _myVote = 0;
        }
    }

    // Toggle feedback: clicking the active button takes the vote back; clicking the
    // other button switches like a radio group. The server is told the net change
    // (e.g. -1 to retract), so taking a vote back actually decrements the tally and
    // repeated check/uncheck never piles up extra votes.
    private async Task VoteAsync(int direction)
    {
        if (!CanVote || CurrentVoteItemId is not { } itemId)
        {
            return;
        }

        var previous = _myVote;
        var next = previous == direction ? 0 : direction;
        if (next == previous)
        {
            return;
        }

        _myVote = next;
        await Js.InvokeVoidAsync("whipRadio.setVote", itemId, next);
        StateHasChanged();

        var upDelta = (next == 1 ? 1 : 0) - (previous == 1 ? 1 : 0);
        var downDelta = (next == -1 ? 1 : 0) - (previous == -1 ? 1 : 0);
        var result = await Api.VoteAsync(itemId, upDelta, downDelta);
        if (result is not null)
        {
            // Reflect the new tally immediately. Live now-playing also updates via the
            // VotesChanged broadcast; this keeps a static preview snapshot in step too.
            _voteResult = result;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        Live.Changed -= OnLiveChanged;
        Live.LiveStreamRestored -= OnLiveStreamRestored;
        Player.Changed -= OnPlayerModeChanged;
        _ticker?.Dispose();
        try
        {
            await Js.InvokeVoidAsync("whipRadio.disposeFooterShortcuts");
        }
        catch (JSDisconnectedException)
        {
            // Circuit is gone during shutdown.
        }

        _interopRef?.Dispose();
    }
}
