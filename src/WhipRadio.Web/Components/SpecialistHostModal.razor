<Modal Visible="@Visible"
       Title="@($"Create {RoleLabel} Host")"
       Class="modal-wide"
       OnClose="CloseAsync">
    <ChildContent>
        <div class="form-grid specialist-host-grid">
            <div class="field specialist-hint-field">
                <label>Hint</label>
                <textarea @bind="_hint" rows="5" placeholder="@HintPlaceholder"></textarea>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn small" @onclick="CloseAsync">Cancel</button>
        <button class="btn small specialist-create-btn @(_submitting ? "working-button" : null)"
                disabled="@_submitting"
                @onclick="CreateAsync">@(_submitting ? "Creating..." : $"Create {RoleLabel} Host")</button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool Visible { get; set; }

    [Parameter] public string Role { get; set; } = "News";

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public EventCallback<string?> HostRequested { get; set; }

    private string _hint = "";
    private bool _submitting;

    private bool IsWeather => string.Equals(Role, "Weather", StringComparison.OrdinalIgnoreCase);

    private string RoleLabel => IsWeather ? "Weather" : "News";

    private string HintPlaceholder => IsWeather
        ? "calm overnight forecast, practical travel timing, warm but concise"
        : "precise night editor, global business focus, public-service tone";

    private async Task CreateAsync()
    {
        if (_submitting)
        {
            return;
        }

        _submitting = true;
        var hint = string.IsNullOrWhiteSpace(_hint) ? null : _hint.Trim();
        try
        {
            await HostRequested.InvokeAsync(hint);
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task CloseAsync()
    {
        Reset();
        await OnClose.InvokeAsync();
    }

    private void Reset()
    {
        _hint = "";
        _submitting = false;
    }
}
