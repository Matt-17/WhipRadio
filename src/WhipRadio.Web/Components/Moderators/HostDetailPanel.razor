@using WhipRadio.Core.Api
@using WhipRadio.Web.Services
@using WhipRadio.Web.Services.Api
@inject ModeratorsApiClient Api
@inject PlayerState Player
@inject IJSRuntime Js

<div class="panel host-detail @(Host.IsActive ? null : "inactive")">
    <div class="host-detail-head">
        <div class="host-photo-col">
            <PersonAvatar PhotoUrl="@Host.PhotoUrl" Name="@Host.Name" Size="portrait" />
            <div class="host-photo-edit">
                <input @bind="_photoUrlEdit" placeholder="photo url..." />
                <button class="btn small" title="set photo" @onclick="SetPhotoAsync">set</button>
            </div>
        </div>
        <div class="host-detail-info">
            <div class="mod-name">@Host.Name</div>
            <div class="mod-meta">
                <span class="tag"><Flag Code="@Host.Language" Size="14" /> @Host.Language</span>
                <span class="tag">@(Host.Gender == "m" ? "male" : "female")</span>
                @if (!string.IsNullOrWhiteSpace(Host.Style))
                {
                    <span class="tag">@Host.Style</span>
                }
                <span class="tag">@HostFormat.TalkLabel(Host.Talkativeness)</span>
                @if (!string.IsNullOrWhiteSpace(Host.PreferredGenres))
                {
                    <span class="tag">@Host.PreferredGenres</span>
                }
                @if (Host.IsAutoGenerated)
                {
                    <span class="tag green">director's pick</span>
                }
                @if (Host.IsNewsSpecialist)
                {
                    <span class="tag amber">news</span>
                }
                @if (Host.IsWeatherSpecialist)
                {
                    <span class="tag amber">weather</span>
                }
                <StatusBadge Text="@(Host.IsActive ? "on roster" : "off roster")"
                             Tone="@(Host.IsActive ? StatusBadgeTone.Green : StatusBadgeTone.Default)" />
            </div>
            <div class="mod-persona">@Host.PersonaPrompt</div>
            @if (Host.BaselineTraits is not null && Host.CurrentTraits is not null)
            {
                <div class="trait-board">
                    <div class="trait-row stable">
                        <span class="trait-label">baseline</span>
                        <span class="trait-chip"><b>energy</b>@HostFormat.TraitLabel(Host.BaselineTraits.Energy)</span>
                        <span class="trait-chip"><b>formality</b>@HostFormat.TraitLabel(Host.BaselineTraits.Formality)</span>
                        <span class="trait-chip"><b>humor</b>@HostFormat.TraitLabel(Host.BaselineTraits.HumorLevel)</span>
                        <span class="trait-chip"><b>talk</b>@HostFormat.TraitLabel(Host.BaselineTraits.Talkativeness)</span>
                        <span class="trait-chip"><b>warmth</b>@HostFormat.TraitLabel(Host.BaselineTraits.Warmth)</span>
                    </div>
                    <div class="trait-row variable">
                        <span class="trait-label">current</span>
                        <span class="trait-chip"><b>energy</b>@HostFormat.TraitLabel(Host.CurrentTraits.Energy)</span>
                        <span class="trait-chip"><b>formality</b>@HostFormat.TraitLabel(Host.CurrentTraits.Formality)</span>
                        <span class="trait-chip"><b>humor</b>@HostFormat.TraitLabel(Host.CurrentTraits.HumorLevel)</span>
                        <span class="trait-chip"><b>talk</b>@HostFormat.TraitLabel(Host.CurrentTraits.Talkativeness)</span>
                        <span class="trait-chip"><b>warmth</b>@HostFormat.TraitLabel(Host.CurrentTraits.Warmth)</span>
                    </div>
                </div>
            }
            @if (Host.TalkProfile is not null)
            {
                <div class="trait-row stable talk-profile-row">
                    <span class="trait-label">profile</span>
                    <span class="trait-chip"><b>break</b>@HostFormat.BreakFrequencyLabel(Host.TalkProfile.BreakFrequencyTracks)</span>
                    <span class="trait-chip"><b>parts</b>@Host.TalkProfile.MinPartsPerBreak-@Host.TalkProfile.MaxPartsPerBreak</span>
                    <span class="trait-chip"><b>replay</b>@Host.TalkProfile.ExactReplayTolerance</span>
                    <span class="trait-chip"><b>evergreen</b>@Host.TalkProfile.EvergreenBitTolerance.ToString("0.##")</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Host.VoiceId) && _redesignFor == Host.Id && _redesigned is not null)
            {
                <div class="btn-row" style="margin-top:12px">
                    <button class="btn small" @onclick="() => PlayPreview(Host.Name, _redesigned)">▶ preview new voice</button>
                    <button class="btn small primary" @onclick="ApplyRedesignAsync">apply</button>
                    <button class="btn small" @onclick="() => { _redesignFor = null; _redesigned = null; }">discard</button>
                </div>
            }
        </div>
    </div>
    <footer>
        <div class="btn-row">
            <button class="btn small" @onclick="ToggleTalksAsync">
                @(_talksFor == Host.Id ? "hide talks" : "recent talks")
            </button>
            <button class="btn small" disabled="@_designing" title="mint a new voice from this host's persona"
                    @onclick="RedesignAsync">
                @(_designing && _redesignFor == Host.Id ? "designing..." : "redesign voice")
            </button>
        </div>
        <button class="btn small danger host-fire-action @(FiringThisHost ? "working-button" : null)" disabled="@FireDisabled" title="remove this host from active use"
                @onclick="() => OnFireRequested.InvokeAsync(Host)">
            @(FiringThisHost ? "firing..." : "Fire")
        </button>
    </footer>
    @if (_talksFor == Host.Id)
    {
        <div style="margin-top:14px">
            @if (_talks.Count == 0)
            {
                <div class="empty-state">no talks yet</div>
            }
            @foreach (var talk in _talks)
            {
                <div class="talk-row">
                    <button class="btn small" title="play talk" aria-label="play talk" @onclick="() => PlayTalkAsync(talk.ItemId)">▶</button>
                    <span class="tag">@talk.Title</span>
                    <span class="dim">@talk.PlayedAt.ToLocalTime().ToString("dd.MM. HH:mm") · @FormatClock(TimeSpan.FromSeconds(talk.DurationSeconds))</span>
                </div>
                <div class="transcript small">@talk.Transcript</div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public required ModeratorDto Host { get; set; }

    /// <summary>True while any fire is in progress (disables the button).</summary>
    [Parameter] public bool FireDisabled { get; set; }

    /// <summary>True while THIS host is being fired (working label/spinner).</summary>
    [Parameter] public bool FiringThisHost { get; set; }

    [Parameter] public EventCallback<ModeratorDto> OnFireRequested { get; set; }

    /// <summary>The host record changed (e.g. new photo) — parent updates its list.</summary>
    [Parameter] public EventCallback<ModeratorDto> OnHostUpdated { get; set; }

    /// <summary>The roster needs a reload (e.g. a redesigned voice was applied).</summary>
    [Parameter] public EventCallback OnRosterChanged { get; set; }

    private int _hostId = -1;
    private string _photoUrlEdit = "";
    private List<PlayLogEntryDto> _talks = [];
    private int? _talksFor;
    private int? _redesignFor;
    private DesignedVoiceDto? _redesigned;
    private bool _designing;

    protected override void OnParametersSet()
    {
        if (Host.Id == _hostId)
        {
            return;
        }

        _hostId = Host.Id;
        _photoUrlEdit = Host.PhotoUrl ?? "";
        _talksFor = null;
        _redesignFor = null;
        _redesigned = null;
    }

    private async Task SetPhotoAsync()
    {
        var updated = await Api.SetModeratorPhotoAsync(
            Host.Id, string.IsNullOrWhiteSpace(_photoUrlEdit) ? null : _photoUrlEdit);
        if (updated is not null)
        {
            await OnHostUpdated.InvokeAsync(updated);
        }
    }

    private async Task RedesignAsync()
    {
        _designing = true;
        _redesignFor = Host.Id;
        _redesigned = null;
        try
        {
            var (voice, _) = await Api.RedesignVoiceAsync(Host.Id);
            _redesigned = voice;
            if (voice is not null)
            {
                PlayPreview(Host.Name, voice);
            }
        }
        catch
        {
            // voice redesign is best-effort; the preview simply doesn't appear
        }
        finally
        {
            _designing = false;
        }
    }

    private async Task ApplyRedesignAsync()
    {
        if (_redesigned is null)
        {
            return;
        }

        await Api.ApplyVoiceAsync(Host.Id, new ApplyVoiceDto(_redesigned.Handle, _redesigned.Description));
        _redesignFor = null;
        _redesigned = null;
        await OnRosterChanged.InvokeAsync();
    }

    /// <summary>Voice previews play in the footer player like song previews.</summary>
    private void PlayPreview(string name, DesignedVoiceDto voice)
        => Player.PlayVoice($"{name} — designed voice", MediaUrls.VoicePreview(voice.Handle), voice.DurationSeconds);

    private async Task ToggleTalksAsync()
    {
        if (_talksFor == Host.Id)
        {
            _talksFor = null;
            return;
        }

        _talksFor = Host.Id;
        _talks = await Api.GetModeratorTalksAsync(Host.Id);
    }

    private async Task PlayTalkAsync(Guid id)
        => await Js.InvokeVoidAsync("whipRadio.playClip", MediaUrls.Announcement(id));
}
