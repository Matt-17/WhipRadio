@* Reusable modal shell: dimmed backdrop + framed panel with title, body and an
   optional footer. Visibility is owned by the caller — render with Visible and
   reset your state in OnClose (✕ button, backdrop click, Escape). *@

@if (Visible)
{
    <div class="modal-backdrop" @onclick="BackdropClickAsync">
        <div class="modal-panel @Class" role="dialog" aria-modal="true" tabindex="-1"
             @ref="_panel" @onclick:stopPropagation @onkeydown="KeyDownAsync">
            <div class="modal-head">
                <span class="modal-title">@Title</span>
                <button class="modal-close" title="close" aria-label="close" @onclick="CloseAsync">✕</button>
            </div>
            <div class="modal-body">@ChildContent</div>
            @if (Footer is not null)
            {
                <div class="modal-foot">@Footer</div>
            }
        </div>
    </div>
}

@code {
    private ElementReference _panel;
    private bool _wasVisible;
    private bool _focusPending;

    [Parameter] public bool Visible { get; set; }

    [Parameter] public string? Title { get; set; }

    /// <summary>Extra CSS class(es) on the panel, e.g. for width variants.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Action row, rendered right-aligned below the body.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>Raised when the user dismisses the dialog (✕, backdrop, Escape).</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public bool CloseOnBackdrop { get; set; } = true;

    protected override void OnParametersSet()
    {
        if (Visible && !_wasVisible)
        {
            _focusPending = true;
        }

        _wasVisible = Visible;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending && Visible)
        {
            _focusPending = false;
            try
            {
                // Escape only reaches the dialog while focus is inside it.
                await _panel.FocusAsync();
            }
            catch (JSException)
            {
                // Panel vanished between render and focus — nothing to do.
            }
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private Task BackdropClickAsync() => CloseOnBackdrop ? CloseAsync() : Task.CompletedTask;

    private Task KeyDownAsync(KeyboardEventArgs e)
        => e.Key == "Escape" ? CloseAsync() : Task.CompletedTask;
}
