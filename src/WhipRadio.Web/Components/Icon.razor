@* Reusable monochrome SVG icons. Stroke/fill = currentColor, so they inherit
   the surrounding text color (amber chips, dim table cells, …). *@
<svg class="ico @Class" viewBox="0 0 16 16" aria-hidden="true"
     style="@(Size is { } s ? $"width:{s}px;height:{s}px" : null)">
    @switch (Name)
    {
        case "heart": @* greeting *@
            <path d="M8 13.4 C4.8 10.9 2.3 8.9 2.3 6.4 A2.9 2.9 0 0 1 8 5.4 A2.9 2.9 0 0 1 13.7 6.4 C13.7 8.9 11.2 10.9 8 13.4 Z"/>
            break;
        case "note": @* music request / song *@
            <path d="M6.3 12.3 V4.2 L12.7 2.7 V10.8"/>
            <circle cx="4.5" cy="12.3" r="1.8" fill="currentColor" stroke="none"/>
            <circle cx="10.9" cy="10.8" r="1.8" fill="currentColor" stroke="none"/>
            break;
        case "inbox": @* received / created *@
            <path d="M8 1.8v7M5.4 6.3 8 8.9l2.6-2.6"/>
            <path d="M2 9.5v3a1.2 1.2 0 0 0 1.2 1.2h9.6A1.2 1.2 0 0 0 14 12.5v-3"/>
            break;
        case "antenna": @* aired / played *@
            <circle cx="8" cy="4.6" r="1.5" fill="currentColor" stroke="none"/>
            <path d="M8 6.6V14"/>
            <path d="M5 7.4a4.1 4.1 0 0 1 0-5.6M11 1.8a4.1 4.1 0 0 1 0 5.6"/>
            break;
        case "play":
            <path d="M4.5 2.8 13 8 4.5 13.2 Z" fill="currentColor" stroke="currentColor"/>
            break;
        case "transcript": @* speech bubble with text lines *@
            <path d="M2 3.5a1.5 1.5 0 0 1 1.5-1.5h9A1.5 1.5 0 0 1 14 3.5v6a1.5 1.5 0 0 1-1.5 1.5H8l-3 3v-3H3.5A1.5 1.5 0 0 1 2 9.5Z"/>
            <path d="M4.8 5.2h6.4M4.8 7.8h4.2"/>
            break;
        case "chat":
            <path d="M2 3.5a1.5 1.5 0 0 1 1.5-1.5h9A1.5 1.5 0 0 1 14 3.5v6a1.5 1.5 0 0 1-1.5 1.5H8l-3 3v-3H3.5A1.5 1.5 0 0 1 2 9.5Z"/>
            break;
        case "send":
            <path d="M2.2 8 13.8 2.6 11 13.4 7.6 9.4Z"/>
            <path d="M13.8 2.6 7.6 9.4"/>
            break;
        case "director":
            <path d="M5.6 2.6h4.8v2H5.6Z"/>
            <path d="M10.4 3.4h1.8a1 1 0 0 1 1 1v8.8a1 1 0 0 1-1 1H3.8a1 1 0 0 1-1-1V4.4a1 1 0 0 1 1-1h1.8"/>
            <path d="M5.4 7.4l1.5 1.5 3.4-3.4"/>
            <path d="M5.4 11h5.2"/>
            break;
        case "bolt":
            <path d="M8.8 1.8 3.6 9h3.2l-.8 5.2L11.2 7H8Z"/>
            break;
        case "dots":
            <circle cx="3.4" cy="8" r="1.3" fill="currentColor" stroke="none"/>
            <circle cx="8" cy="8" r="1.3" fill="currentColor" stroke="none"/>
            <circle cx="12.6" cy="8" r="1.3" fill="currentColor" stroke="none"/>
            break;
        case "bell":
            <path d="M8 2a3.8 3.8 0 0 1 3.8 3.8c0 3 .8 4.2 1.6 4.9H2.6c.8-.7 1.6-1.9 1.6-4.9A3.8 3.8 0 0 1 8 2Z"/>
            <path d="M6.6 12.9a1.5 1.5 0 0 0 2.8 0"/>
            break;
        case "exchange":
            <path d="M3 5.6h8.4M9.4 3.4l2.2 2.2-2.2 2.2"/>
            <path d="M13 10.4H4.6M6.6 8.2 4.4 10.4l2.2 2.2"/>
            break;
        case "soundwave": @* voice waveform — play a spoken voice reference *@
            <path d="M2.6 6.4V9.6"/>
            <path d="M5.3 3.2V12.8"/>
            <path d="M8 5V11"/>
            <path d="M10.7 2.2V13.8"/>
            <path d="M13.4 6V10"/>
            break;
        case "history": @* document list *@
            <path d="M4 1.8h5.7L13 5.1v9.1H4a1 1 0 0 1-1-1V2.8a1 1 0 0 1 1-1Z"/>
            <path d="M9.5 2v3.4h3.3"/>
            <path d="M5.2 7.6h5.6M5.2 10h5.6M5.2 12.4h3.3"/>
            break;
        case "fallback": @* emergency fallback play *@
            <path d="M4.2 2.2h7.6l-1 4h2.4l-5.4 7.6 1-4H5.9Z"/>
            <path d="M3.1 11.4a6.2 6.2 0 0 1 .4-7.3M12.5 4.1a6.2 6.2 0 0 1 .4 7.3"/>
            break;
        case "stop":
            <rect x="3.6" y="3.6" width="8.8" height="8.8" rx="1.2" fill="currentColor" stroke="none"/>
            break;
        case "volume":
            <path d="M2.1 6.1h2.5L8.1 3v10L4.6 9.9H2.1Z"/>
            <path d="M10.3 5.4a3.8 3.8 0 0 1 0 5.2"/>
            <path d="M12.2 3.6a6.5 6.5 0 0 1 0 8.8"/>
            break;
        case "mute":
            <path d="M2.1 6.1h2.5L8.1 3v10L4.6 9.9H2.1Z"/>
            <path d="M10.4 6.2 14 9.8M14 6.2l-3.6 3.6"/>
            break;
        case "thumb-up":
            <path d="M5.8 7.1 8.2 2.4a1.2 1.2 0 0 1 2.2.7v3h2.1a1.5 1.5 0 0 1 1.4 2l-1.2 4.1a2.2 2.2 0 0 1-2.1 1.6H5.8Z"/>
            <path d="M2.2 7.1h3.6v6.7H2.2Z"/>
            break;
        case "thumb-down":
            <path d="M5.8 8.9 8.2 13.6a1.2 1.2 0 0 0 2.2-.7v-3h2.1a1.5 1.5 0 0 0 1.4-2l-1.2-4.1a2.2 2.2 0 0 0-2.1-1.6H5.8Z"/>
            <path d="M2.2 2.2h3.6v6.7H2.2Z"/>
            break;
        case "trash": @* delete *@
            <path d="M2.8 4.3h10.4"/>
            <path d="M6.1 4.3V3.1a1 1 0 0 1 1-1h1.8a1 1 0 0 1 1 1v1.2"/>
            <path d="M4.2 4.3l.6 8.7a1.2 1.2 0 0 0 1.2 1.1h4a1.2 1.2 0 0 0 1.2-1.1l.6-8.7"/>
            <path d="M6.6 7v4.4M9.4 7v4.4"/>
            break;
        case "edit":
            <path d="M3.1 11.4 2.5 13.5l2.1-.6 7.7-7.7-1.5-1.5Z"/>
            <path d="M9.8 2.7 11 1.5l2.5 2.5-1.2 1.2"/>
            <path d="M6.3 13.5h7.2"/>
            break;
        case "refresh": @* redefine / refresh *@
            <path d="M13.2 5.4a5.5 5.5 0 0 0-9.4-1.8L2.4 5.1"/>
            <path d="M2.4 2.2v2.9h2.9"/>
            <path d="M2.8 10.6a5.5 5.5 0 0 0 9.4 1.8l1.4-1.5"/>
            <path d="M13.6 13.8v-2.9h-2.9"/>
            break;
        case "close": @* dismiss / close panel *@
            <path d="M3.6 3.6l8.8 8.8M12.4 3.6l-8.8 8.8"/>
            break;
        case "chevron-down": @* expand *@
            <path d="M3.4 5.8 8 10.4l4.6-4.6"/>
            break;
        case "chevron-up": @* collapse *@
            <path d="M3.4 10.2 8 5.6l4.6 4.6"/>
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    [Parameter] public string? Class { get; set; }

    [Parameter] public int? Size { get; set; }
}
