<!--
  Reference Icecast configuration for WhipRadio.

  The AppHost uses libretime/icecast, which generates its config from the
  ICECAST_* environment variables (see AppHost.cs). If you swap to an image
  that only supports a static config, mount this file to /etc/icecast2/icecast.xml
  and substitute the ${...} placeholders (envsubst) in an entrypoint.

  Contract: source push on :8000, mount /radio.mp3, max 2 sources.
-->
<icecast>
    <location>Earth</location>
    <admin>admin@localhost</admin>

    <limits>
        <clients>100</clients>
        <sources>2</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>65535</burst-size>
    </limits>

    <authentication>
        <!-- TODO: dev passwords — override via env for anything non-local. -->
        <source-password>${ICECAST_SOURCE_PASSWORD:-hackme-dev}</source-password>
        <relay-password>${ICECAST_RELAY_PASSWORD:-hackme-relay}</relay-password>
        <admin-user>admin</admin-user>
        <admin-password>${ICECAST_ADMIN_PASSWORD:-hackme-admin}</admin-password>
    </authentication>

    <hostname>localhost</hostname>

    <listen-socket>
        <port>8000</port>
    </listen-socket>

    <mount type="normal">
        <mount-name>/radio.mp3</mount-name>
        <public>1</public>
        <stream-name>WhipRadio</stream-name>
        <stream-description>Llamas whipped the radio's mix.</stream-description>
    </mount>

    <paths>
        <logdir>/var/log/icecast</logdir>
        <webroot>/usr/share/icecast/web</webroot>
        <adminroot>/usr/share/icecast/admin</adminroot>
        <alias source="/" destination="/status.xsl"/>
    </paths>

    <logging>
        <accesslog>-</accesslog>
        <errorlog>-</errorlog>
        <loglevel>3</loglevel>
    </logging>
</icecast>
