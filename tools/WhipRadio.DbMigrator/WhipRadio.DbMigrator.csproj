<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway one-shot tool: copies the legacy SQLite radio.db into Postgres.
       Intentionally NOT added to WhipRadio.sln / CI. Delete after a verified cutover. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WhipRadio.Infrastructure\WhipRadio.Infrastructure.csproj" />
    <!-- Sqlite provider lives only here; Infrastructure itself is Postgres-only now. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
  </ItemGroup>

</Project>
